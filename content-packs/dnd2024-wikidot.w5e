        },
        {
          "id": "flamekin-reach-to-the-blaze",
          "name": "Reach to the Blaze",
          "description": "They know the Produce Flame cantrip. Starting at 3rd level, they can cast the Burning Hands spell with this trait. Starting at 5th level, they can also cast the Flame Blade spell with this trait, without requiring a material component.",
          "source": "http://dnd2024.wikidot.com/species:flamekin"
        }
      ]
