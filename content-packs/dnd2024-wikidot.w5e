    {
      "id": "gnome",
      "name": "Gnome",
      "speed": 30,
      "traits": [
        {
          "id": "gnome-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:gnome"
        },
        {
          "id": "gnome-gnomish-cunning",
          "name": "Gnomish Cunning",
          "description": "They have Advantage on Intelligence, Wisdom, and Charisma saving throws.",
          "source": "http://dnd2024.wikidot.com/species:gnome"
        },
        {
          "id": "gnome-gnomish-lineage",
          "name": "Gnomish Lineage",
          "description": "They are part of a lineage that grants they supernatural abilities. Choose one of the following options; whichever one they choose, Intelligence, Wisdom, or Charisma is their spellcasting ability for the spells they cast with this trait (choose the ability when they select the lineage):",
          "source": "http://dnd2024.wikidot.com/species:gnome"
        },
        {
          "id": "gnome-forest-gnome",
          "name": "Forest Gnome",
          "description": "They know the Minor Illusion cantrip. They also always have the Speak with Animals spell prepared. They can cast it without a spell slot a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Long Rest. They can also use any spell slots they have to cast the spell.",
          "source": "http://dnd2024.wikidot.com/species:gnome"
        },
        {
          "id": "gnome-rock-gnome",
          "name": "Rock Gnome",
          "description": "They know the Mending and Prestidigitation cantrips. In addition, they can spend 10 minutes casting Prestidigitation to create a Tiny clockwork device (AC 5,1 HP), such as a toy, fire starter, or music box. When they create the device, they determine its function by choosing one effect from Prestidigitation; the device produces that effect whenever they or another creature takes a Bonus Action to activate it with a touch.",
          "source": "http://dnd2024.wikidot.com/species:gnome"
        }
      ]
    },
    {
      "id": "goliath",
      "name": "Goliath",
      "speed": 35,
      "traits": [
        {
          "id": "goliath-giant-ancestry",
          "name": "Giant Ancestry",
          "description": "They are descended from Giants. Choose one of the following benefits - a supernatural boon from their ancestry; they can use the chosen benefit a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Long Rest:",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-cloud-s-jaunt-cloud-giant",
          "name": "Cloud's Jaunt (Cloud Giant)",
          "description": "As a Bonus Action, they magically teleport up to 30 feet to an unoccupied space they can see.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-fire-s-burn-fire-giant",
          "name": "Fire's Burn (Fire Giant)",
          "description": "When they hit a target with an attack roll and deal damage to it, they can also deal 1d10 Fire damage to that target.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-frost-s-chill-frost-giant",
          "name": "Frost's Chill (Frost Giant)",
          "description": "When they hit a target with an attack roll and deal damage to it, they can also deal 1d6 Cold damage to that target and reduce its Speed by 10 feet until the start of their next turn.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-hill-s-tumble-hill-giant",
          "name": "Hill's Tumble (Hill Giant)",
          "description": "When they hit a Large or smaller creature with an attack roll and deal damage to it, they can give that target the Prone condition.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-stone-s-endurance-stone-giant",
          "name": "Stone's Endurance (Stone Giant)",
          "description": "When they take damage, they can take a Reaction to roll 1d12. Add their Constitution modifier to the number rolled and reduce the damage by that total.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-storm-s-thunder-storm-giant",
          "name": "Storm's Thunder (Storm Giant)",
          "description": "When they take damage from a creature within 60 feet of them, they can take a Reaction to deal 1d8 Thunder damage to that creature.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-large-form",
          "name": "Large Form",
          "description": "Starting at character level 5, they can change their size to Large as a Bonus Action if they are in a big enough space. This transformation lasts for 10 minutes or until they end it (no action required). For that duration, they have Advantage on Strength checks, and their Speed increases by 10 feet.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        },
        {
          "id": "goliath-powerful-build",
          "name": "Powerful Build",
          "description": "They have Advantage on any ability check they make to end the Grappled condition. They also count as one size larger when determining their carrying capacity.",
          "source": "http://dnd2024.wikidot.com/species:goliath"
        }
      ]
    },
    {
      "id": "halfling",
      "name": "Halfling",
      "speed": 30,
      "traits": [
        {
          "id": "halfling-brave",
          "name": "Brave",
          "description": "They have Advantage on saving throws they make to avoid or end the Frightened condition.",
          "source": "http://dnd2024.wikidot.com/species:halfling"
        },
        {
          "id": "halfling-halfling-nimbleness",
          "name": "Halfling Nimbleness",
          "description": "They can move through the space of any creature that is a size larger than they, but they can't stop in the same space.",
          "source": "http://dnd2024.wikidot.com/species:halfling"
        },
        {
          "id": "halfling-luck",
          "name": "Luck",
          "description": "When they roll a 1 on the d20 of a D20 Test, they can reroll the die, and they must use the new roll.",
          "source": "http://dnd2024.wikidot.com/species:halfling"
        },
        {
          "id": "halfling-naturally-stealthy",
          "name": "Naturally Stealthy",
          "description": "They can take the Hide action even when they are obscured only by a creature that is at least one size larger than they.",
          "source": "http://dnd2024.wikidot.com/species:halfling"
        }
      ]
    },
    {
      "id": "hexblood",
      "name": "Hexblood",
      "speed": 30,
      "traits": [
        {
          "id": "hexblood-darkvision",
          "name": "Darkvision",
          "description": "As a Hexblood, they have these special traits. Darkvision. They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:hexblood"
        },
        {
          "id": "hexblood-eerie-token",
          "name": "Eerie Token",
          "description": "As a Bonus Action, they can create a magical token by harmlessly removing a lock of hair, detaching a nail, or using some other method. While the token exists, they gain the following benefits:",
          "source": "http://dnd2024.wikidot.com/species:hexblood"
        },
        {
          "id": "hexblood-distant-message",
          "name": "Distant Message",
          "description": "As a Magic action, they can send a telepathic message of 25 words or fewer to a creature holding or carrying the token, as long as they are within 10 miles of it.",
          "source": "http://dnd2024.wikidot.com/species:hexblood"
        },
        {
          "id": "hexblood-remote-viewing",
          "name": "Remote Viewing",
          "description": "If they are within 10 miles of the token, they can take a Magic action to extend their senses through the token for 1 minute, until they have the Incapacitated condition, or until they end this state (no action required). During this state, they can see and hear from the token as if they were located where it is. When this state ends, the token is harmlessly destroyed.",
          "source": "http://dnd2024.wikidot.com/species:hexblood"
        },
        {
          "id": "hexblood-hex-magic",
          "name": "Hex Magic",
          "description": "They always have the Disguise Self and Hex spells prepared. They can cast each spell once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest. They can also cast the spell using any spell slots they have of the appropriate level. Intelligence, Wisdom, or Charisma is their spellcasting ability for the spells they cast with this trait (choose the ability when they select this species).",
          "source": "http://dnd2024.wikidot.com/species:hexblood"
        }
      ]
    },
    {
      "id": "human",
      "name": "Human",
      "speed": 30,
      "traits": [
        {
          "id": "human-resourceful",
          "name": "Resourceful",
          "description": "They gain Heroic Inspiration whenever they finish a Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:human"
        },
        {
          "id": "human-skillful",
          "name": "Skillful",
          "description": "They gain proficiency in one skill of their choice.",
          "source": "http://dnd2024.wikidot.com/species:human"
        },
        {
          "id": "human-versatile",
          "name": "Versatile",
          "description": "They gain an Origin feat of their choice. Skilled is recommended.",
          "source": "http://dnd2024.wikidot.com/species:human"
        }
      ]
    },
    {
      "id": "kalashtar",
      "name": "Kalashtar",
      "speed": 30,
      "traits": [
        {
          "id": "kalashtar-dual-mind",
          "name": "Dual Mind",
          "description": "They have Advantage on Wisdom and Charisma saving throws.",
          "source": "http://dnd2024.wikidot.com/species:kalashtar"
        },
        {
          "id": "kalashtar-mental-discipline",
          "name": "Mental Discipline",
          "description": "They have Resistance to Psychic damage.",
          "source": "http://dnd2024.wikidot.com/species:kalashtar"
        },
        {
          "id": "kalashtar-mind-link",
          "name": "Mind Link",
          "description": "They have telepathy with a range in feet equal to 10 times their level. When they are using this trait to speak telepathically to a creature, they can take a Magic action to give that creature the ability to speak telepathically with they for 1 hour or until they take another Magic action to end this effect.",
          "source": "http://dnd2024.wikidot.com/species:kalashtar"
        },
        {
          "id": "kalashtar-severed-from-dreams",
          "name": "Severed from Dreams",
          "description": "They can’t be the target of the Dream spell. In addition, when they finish a Long Rest, they gain proficiency in one skill of their choice. This proficiency lasts until they finish another Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:kalashtar"
        }
      ]
    },
    {
      "id": "khoravar",
      "name": "Khoravar",
      "speed": 30,
      "traits": [
        {
          "id": "khoravar-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:khoravar"
        },
        {
          "id": "khoravar-fey-ancestry",
          "name": "Fey Ancestry",
          "description": "They have Advantage on saving throws they make to avoid or end the Charmed condition.",
          "source": "http://dnd2024.wikidot.com/species:khoravar"
        },
        {
          "id": "khoravar-fey-gift",
          "name": "Fey Gift",
          "description": "They know the Friends cantrip. Whenever they finish a Long Rest, they can replace that cantrip with a different cantrip from the Cleric, Druid, or Wizard spell list. Intelligence, Wisdom, or Charisma is their spellcasting ability for the spell they cast with this trait (chosen when they select this species).",
          "source": "http://dnd2024.wikidot.com/species:khoravar"
        },
        {
          "id": "khoravar-lethargy-resilience",
          "name": "Lethargy Resilience",
          "description": "When they fail a saving throw to avoid or end the Unconscious condition, they can succeed instead. Once they use this trait, they can’t do so again until they finish 1d4 Long Rests.",
          "source": "http://dnd2024.wikidot.com/species:khoravar"
        },
        {
          "id": "khoravar-skill-versatility",
          "name": "Skill Versatility",
          "description": "They gain proficiency in one skill or with one tool of their choice. Whenever they finish a Long Rest, they can replace it with another skill or tool proficiency.",
          "source": "http://dnd2024.wikidot.com/species:khoravar"
        }
      ]
    },
    {
      "id": "lorwyn-changeling",
      "name": "Lorwyn Changeling",
      "speed": 30,
      "traits": [
        {
          "id": "lorwyn-changeling-shape-self",
          "name": "Shape Self",
          "description": "As an action, they can reshape their body to a two-legged Humanoid shape or to a four-legged Beast shape. While they have a Humanoid shape, they can wear clothing and armor made for a Humanoid of their size.",
          "source": "http://dnd2024.wikidot.com/species:lorwyn-changeling"
        },
        {
          "id": "lorwyn-changeling-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 120 feet.",
          "source": "http://dnd2024.wikidot.com/species:lorwyn-changeling"
        },
        {
          "id": "lorwyn-changeling-delightful-imitator",
          "name": "Delightful Imitator",
          "description": "They have proficiency in the Performance skill.",
          "source": "http://dnd2024.wikidot.com/species:lorwyn-changeling"
        },
        {
          "id": "lorwyn-changeling-unpredictable-movement",
          "name": "Unpredictable Movement",
          "description": "When they roll Initiative and don’t have Disadvantage on that roll, they can take the Dash action as a Reaction.",
          "source": "http://dnd2024.wikidot.com/species:lorwyn-changeling"
        }
      ]
    },
    {
      "id": "lupin",
      "name": "Lupin",
      "speed": 30,
      "traits": [
        {
          "id": "lupin-darkvision",
          "name": "Darkvision",
          "description": "As a Lupin, they have these special traits. Darkvision. They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:lupin"
        },
        {
          "id": "lupin-feral-pounce",
          "name": "Feral Pounce",
          "description": "Their Unarmed Strikes deal Slashing damage instead of Bludgeoning damage. In addition, when they hit a creature with an Unarmed Strike as part of the Attack action on their turn, they can use both the Damage and the Shove options. They can use this benefit only once per turn.",
          "source": "http://dnd2024.wikidot.com/species:lupin"
        },
        {
          "id": "lupin-howl",
          "name": "Howl",
          "description": "As a Bonus Action, they let out an unearthly howl. Each creature of their choice within 15 feet of them must succeed on a Wisdom saving throw (DC 8 plus their Constitution modifier and Proficiency Bonus) or have Disadvantage on attack rolls and saving throws until the start of their next turn.",
          "source": "http://dnd2024.wikidot.com/species:lupin"
        },
        {
          "id": "lupin-werewolf-instincts",
          "name": "Werewolf Instincts",
          "description": "They have proficiency in the Perception, Stealth, or Survival skill.",
          "source": "http://dnd2024.wikidot.com/species:lupin"
        }
      ]
    },
    {
      "id": "orc",
      "name": "Orc",
      "speed": 30,
      "traits": [
        {
          "id": "orc-adrenaline-rush",
          "name": "Adrenaline Rush",
          "description": "They can take the Dash action as a Bonus Action. When they do so, they gain a number of Temporary Hit Points equal to their Proficiency Bonus.",
          "source": "http://dnd2024.wikidot.com/species:orc"
        },
        {
          "id": "orc-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 120 feet.",
          "source": "http://dnd2024.wikidot.com/species:orc"
        },
        {
          "id": "orc-relentless-endurance",
          "name": "Relentless Endurance",
          "description": "When they are reduced to 0 Hit Points but not killed outright, they can drop to 1 Hit Point instead. Once they use this trait, they can't do so again until they finish a Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:orc"
        }
      ]
    },
    {
      "id": "reborn",
      "name": "Reborn",
      "speed": 30,
      "traits": [
        {
          "id": "reborn-escaped-death",
          "name": "Escaped Death",
          "description": "As a Reborn, they have these special traits. Escaped Death. They have Advantage on Death Saving Throws.",
          "source": "http://dnd2024.wikidot.com/species:reborn"
        },
        {
          "id": "reborn-everlasting",
          "name": "Everlasting",
          "description": "They don’t gain Exhaustion levels from dehydration, malnutrition, or suffocation. They don’t need to sleep, and magic can’t put them to sleep. They can finish a Long Rest in 4 hours if they spend those hours in an inactive, motionless state, during which they retain consciousness.",
          "source": "http://dnd2024.wikidot.com/species:reborn"
        },
        {
          "id": "reborn-knowledge-from-a-past-life",
          "name": "Knowledge from a Past Life",
          "description": "They gain proficiency in one skill of their choice.",
          "source": "http://dnd2024.wikidot.com/species:reborn"
        },
        {
          "id": "reborn-strange-endurance",
          "name": "Strange Endurance",
          "description": "They have Resistance to one of the following damage types of their choice: Cold, Necrotic, or Poison.",
          "source": "http://dnd2024.wikidot.com/species:reborn"
        }
      ]
    },
    {
      "id": "rimekin",
      "name": "Rimekin",
      "speed": 30,
      "traits": [
        {
          "id": "rimekin-cold-fire-magic",
          "name": "Cold Fire Magic",
          "description": "They know the Ray of Frost cantrip. When they reach character levels 3 and 5, they learn the Ice Knife spell and the Flame Blade spell, respectively. They always have those spells prepared. They can cast each once without a spell slot, and they regain the ability to cast these spells in this way when they finish a Long Rest. They can also cast the spells using any spell slots they have of the appropriate level. When they cast Flame Blade using this trait, the spell deals Cold damage instead of Fire damage.",
          "source": "http://dnd2024.wikidot.com/species:rimekin"
        },
        {
          "id": "rimekin-cold-resistance",
          "name": "Cold Resistance",
          "description": "They have Resistance to Cold damage.",
          "source": "http://dnd2024.wikidot.com/species:rimekin"
        },
        {
          "id": "rimekin-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:rimekin"
        }
      ]
    },
    {
      "id": "shifter",
      "name": "Shifter",
      "speed": 30,
      "traits": [
        {
          "id": "shifter-bestial-instincts",
          "name": "Bestial Instincts",
          "description": "Channeling the beast within, they gain proficiency in one of the following skills of their choice: Acrobatics, Athletics, Intimidation, or Survival.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-shifting",
          "name": "Shifting",
          "description": "As a Bonus Action, they can shape-shift to assume a more bestial appearance. This transformation lasts for 1 minute or until they revert to their normal appearance as a Bonus Action. When they shift, they gain Temporary Hit Points equal to 2 times their Proficiency Bonus. They can shift a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-beasthide",
          "name": "Beasthide",
          "description": "They gain 1d6 additional Temporary Hit Points. While shifted, they have a +1 bonus to their Armor Class.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-longtooth",
          "name": "Longtooth",
          "description": "When they shift and as a Bonus Action on their other turns while shifted, they can use their elongated fangs to make an Unarmed Strike. If they hit with this Unarmed Strike and deal damage, they can deal Piercing damage equal to 1d6 plus their Strength modifier, instead of the normal damage of an Unarmed Strike.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-swiftstride",
          "name": "Swiftstride",
          "description": "While they are shifted, their Speed increases by 10 feet. Additionally, they can move up to 10 feet as a Reaction when a creature ends its turn within 5 feet of them. This reactive movement doesn’t provoke Opportunity Attack action.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        },
        {
          "id": "shifter-wildhunt",
          "name": "Wildhunt",
          "description": "While shifted, they have Advantage on Wisdom checks. Additionally, no creature within 30 feet of them can have Advantage on an attack roll against them unless they have the Incapacitated condition.",
          "source": "http://dnd2024.wikidot.com/species:shifter"
        }
      ]
    },
    {
      "id": "tiefling",
      "name": "Tiefling",
      "speed": 30,
      "traits": [
        {
          "id": "tiefling-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:tiefling"
        },
        {
          "id": "tiefling-fiendish-legacy",
          "name": "Fiendish Legacy",
          "description": "They are the recipient of a legacy that grants they supernatural abilities. Choose a legacy from the Fiendish Legacies table. They gain the level 1 benefit of the chosen legacy.",
          "source": "http://dnd2024.wikidot.com/species:tiefling"
        },
        {
          "id": "tiefling-otherworldly-presence",
          "name": "Otherworldly Presence",
          "description": "They know the Thaumaturgy cantrip. When they cast it with this trait, the spell uses the same spellcasting ability they use for their Fiendish Legacy trait.",
          "source": "http://dnd2024.wikidot.com/species:tiefling"
        }
      ]
    },
    {
      "id": "warforged",
      "name": "Warforged",
      "speed": 30,
      "traits": [
        {
          "id": "warforged-construct-resilience",
          "name": "Construct Resilience",
          "description": "They have Resistance to Poison damage. They also have Advantage on saving throws to avoid or end the Poisoned condition.",
          "source": "http://dnd2024.wikidot.com/species:warforged"
        },
        {
          "id": "warforged-integrated-protection",
          "name": "Integrated Protection",
          "description": "They gain a +1 bonus to their Armor Class. In addition, armor they have donned can’t be removed against their will while they are alive.",
          "source": "http://dnd2024.wikidot.com/species:warforged"
        },
        {
          "id": "warforged-sentrys-rest",
          "name": "Sentry’s Rest",
          "description": "They don’t need to sleep, and magic can’t put them to sleep. They can finish a Long Rest in 6 hours if they spend those hours in an inactive, motionless state. During this time, they appear inert but remain conscious.",
          "source": "http://dnd2024.wikidot.com/species:warforged"
        },
        {
          "id": "warforged-specialized-design",
          "name": "Specialized Design",
          "description": "They gain one skill proficiency and one tool proficiency of their choice.",
          "source": "http://dnd2024.wikidot.com/species:warforged"
        },
        {
          "id": "warforged-tireless",
          "name": "Tireless",
          "description": "They don’t gain Exhaustion levels from dehydration, malnutrition, or suffocation.",
          "source": "http://dnd2024.wikidot.com/species:warforged"
        }
      ]
    }
  ],
  "classes": [
    {
      "id": "artificer",
      "name": "Artificer",
      "hitDie": 8,
      "primaryAbility": "intellect",
      "description": "Masters of invention, Artificers use ingenuity and magic to unlock extraordinary capabilities in objects. They see magic as a complex system waiting to be decoded and then harnessed in their spells and inventions.",
      "levelFeatures": {
        "1": [
          {
            "id": "artificer-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned how to channel magical energy through objects. See the Player’s Handbook for the rules on spellcasting. The information below details how they use those rules with Artificer spells, which appear in the Artificer Spell List.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          },
          {
            "id": "artificer-1-tinker-s-magic",
            "name": "Tinker's Magic",
            "description": "They know the Mending cantrip. As a Magic action while holding Tinker’s Tools, they can create one item in an unoccupied space within 5 feet of themselves, choosing the item from the following list: Ball Bearings Flask Pouch Basket Grappling Hook Rope Bedroll Hunting Trap Sack Bell Jug Shovel Blanket Lamp Spikes, Iron Block and Tackle Manacles String Bottle, Glass Net Tinderbox Bucket Oil Torch Caltrops Paper Vial Candle Parchment Crowbar Pole See the rules for the item in the Player’s Handbook. The item lasts…",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "2": [
          {
            "id": "artificer-2-replicate-magic-item",
            "name": "Replicate Magic Item",
            "description": "They have learned arcane plans that they use to make magic items. Plans Known. When they gain this feature, choose four plans to learn from the Magic Item Plans (Artificer Level 2+) table.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "3": [
          {
            "id": "artificer-3-artificer-subclass",
            "name": "Artificer Subclass",
            "description": "They gain an Artificer subclass of their choice. A subclass is a specialization that grants they features at certain Artificer levels. For the rest of their career, they gain each of their subclass’s features that are of their Artificer level or lower.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "4": [
          {
            "id": "artificer-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Artificer levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "6": [
          {
            "id": "artificer-6-magic-item-tinker",
            "name": "Magic Item Tinker",
            "description": "Their Replicate Magic Item feature gains the following options. Charge Magic Item. As a Bonus Action, they can touch a magic item within 5 feet of themselves that they created with Replicate Magic Item and that uses charges. They expend a level 1+ spell slot and recharge the item.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "7": [
          {
            "id": "artificer-7-flash-of-genius",
            "name": "Flash of Genius",
            "description": "When they or a creature they can see within 30 feet of them fails an ability check or a saving throw, they can take a Reaction to add a bonus to the roll, potentially causing it to succeed. The bonus equals their Intelligence modifier (minimum of +1). They can take this Reaction a number of times equal to their Intelligence modifier (minimum of once). They regain all expended uses when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "10": [
          {
            "id": "artificer-10-magic-item-adept",
            "name": "Magic Item Adept",
            "description": "They can now attune to up to four magic items at once.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "11": [
          {
            "id": "artificer-11-spell-storing-item",
            "name": "Spell-Storing Item",
            "description": "Whenever they finish a Long Rest, they can touch one Simple or Martial weapon or one item that they can use as a Spellcasting Focus, and they store a spell in it, choosing a level 1, 2, or 3 Artificer spell that has a casting time of an action and doesn’t require a Material component that is consumed by the spell (they needn’t have the spell prepared). While holding the object, a creature can take a Magic action to produce the spell’s effect from it, using their spellcasting ability modifier. If the spell…",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "14": [
          {
            "id": "artificer-14-advanced-artifice",
            "name": "Advanced Artifice",
            "description": "Magic Item Savant. They can now attune to up to five magic items at once. Refreshed Genius. When they finish a Short Rest, they regain one expended use of their Flash of Genius feature.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "18": [
          {
            "id": "artificer-18-magic-item-master",
            "name": "Magic Item Master",
            "description": "They can now attune to up to six magic items at once.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "19": [
          {
            "id": "artificer-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Energy Resistance is recommended.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ],
        "20": [
          {
            "id": "artificer-20-soul-of-artifice",
            "name": "Soul of Artifice",
            "description": "They have developed a mystical connection to their magic items, which they can draw on for aid. They gain the following benefits. Cheat Death. If they are reduced to 0 Hit Points but not killed outright, they can disintegrate any number of Uncommon or Rare magic items created by their Replicate Magic Item feature.",
            "source": "http://dnd2024.wikidot.com/artificer:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "artificer-alchemist",
          "name": "Alchemist",
          "description": "Craft Magic Elixirs and Potions An Alchemist is an expert at combining reagents to produce magical effects. Alchemists use their creations to give life and to leech it away.",
          "levelFeatures": {
            "3": [
              {
                "id": "alchemist-3-tools-of-the-trade",
                "name": "Tools of the Trade",
                "description": "Tool Proficiency. They gain proficiency with Alchemist’s Supplies and the Herbalism Kit. If they already have one of these proficiencies, they gain proficiency with one other type of Artisan’s Tools of their choice (or with two other types if they have both). Potion Crafting.",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              },
              {
                "id": "alchemist-3-alchemist-spells",
                "name": "Alchemist Spells.",
                "description": "When they reach an Artificer level specified in the Alchemist Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              },
              {
                "id": "alchemist-3-experimental-elixir",
                "name": "Experimental Elixir",
                "description": "Whenever they finish a Long Rest while holding Alchemist’s Supplies, they can use that tool to magically produce two elixirs. For each elixir, roll on the Experimental Elixir table for the elixir’s effect, which is triggered when someone drinks the elixir. The elixir appears in a vial, and the vial vanishes when the elixir is drunk or poured out.",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              }
            ],
            "5": [
              {
                "id": "alchemist-5-alchemical-savant",
                "name": "Alchemical Savant",
                "description": "Whenever they cast a spell using their Alchemist’s Supplies as the Spellcasting Focus, they gain a bonus to one roll of the spell. That roll must restore Hit Points or be a damage roll that deals Acid, Fire, or Poison damage. The bonus equals their Intelligence modifier (minimum bonus of +1).",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              }
            ],
            "9": [
              {
                "id": "alchemist-9-restorative-reagents",
                "name": "Restorative Reagents",
                "description": "They can cast Lesser Restoration without expending a spell slot and without preparing the spell, provided they use Alchemist’s Supplies as the Spellcasting Focus. They can do so a number of times equal to their Intelligence modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              }
            ],
            "15": [
              {
                "id": "alchemist-15-chemical-mastery",
                "name": "Chemical Mastery",
                "description": "Alchemical Eruption. When they cast an Artificer spell that deals Acid, Fire, or Poison damage to a target, they can also deal 2d8 Force damage to that target. They can use this benefit only once on each of their turns. Chemical Resistance. They gain Resistance to Acid damage and Poison damage. They also gain Immunity to the Poisoned condition.",
                "source": "http://dnd2024.wikidot.com/artificer:alchemist"
              }
            ]
          }
        },
        {
          "id": "artificer-armorer",
          "name": "Armorer",
          "description": "Craft Magic Armor to Enhance their Abilities An Armorer modifies armor to function almost like a second skin. The armor is enhanced to hone the Armorer’s magic, unleash potent attacks, and generate a formidable defense.",
          "levelFeatures": {
            "3": [
              {
                "id": "armorer-3-tools-of-the-trade",
                "name": "Tools of the Trade",
                "description": "Armor Training. They gain training with Heavy armor. Tool Proficiency. They gain proficiency with Smith’s Tools. If they already have this tool proficiency, they gain proficiency with one other type of Artisan’s Tools of their choice.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              },
              {
                "id": "armorer-3-armorer-spells",
                "name": "Armorer Spells",
                "description": "When they reach an Artificer level specified in the Armorer Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              },
              {
                "id": "armorer-3-arcane-armor",
                "name": "Arcane Armor",
                "description": "As a Magic action while they have Smith’s Tools in hand, they can turn a suit of armor they are wearing into Arcane Armor. The armor continues to be Arcane Armor until they don another suit of armor or they die. They gain the following benefits while wearing their Arcane Armor. No Strength Requirement.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              },
              {
                "id": "armorer-3-armor-model",
                "name": "Armor Model",
                "description": "They can customize their Arcane Armor. When they do so, choose one of the following armor models: Dreadnaught, Guardian, or Infiltrator. The model they choose gives they special benefits while they wear it.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              }
            ],
            "5": [
              {
                "id": "armorer-5-extra-attack",
                "name": "Extra Attack",
                "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              }
            ],
            "9": [
              {
                "id": "armorer-9-improved-armorer",
                "name": "Improved Armorer",
                "description": "Armor Replication. They learn an additional plan for their Replicate Magic Item feature, and it must be in the Armor category. If they replace that plan, they must replace it with another Armor plan. In addition, they can create an additional item with that feature, and the item must also be in the Armor category.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              }
            ],
            "15": [
              {
                "id": "armorer-15-perfected-armor",
                "name": "Perfected Armor",
                "description": "Their Arcane Armor gains additional benefits based on its model, as detailed below. Dreadnaught. The damage die of their Force Demolisher increases to 2d6 Force damage.",
                "source": "http://dnd2024.wikidot.com/artificer:armorer"
              }
            ]
          }
        },
        {
          "id": "artificer-artillerist",
          "name": "Artillerist",
          "description": "Wield Destructive Power from Afar An Artillerist specializes in using magic to hurl energy, projectiles, and explosions on a battlefield.",
          "levelFeatures": {
            "3": [
              {
                "id": "artillerist-3-tools-of-the-trade",
                "name": "Tools of the Trade",
                "description": "Ranged Weaponry. They gain proficiency with Martial Ranged weapons. Tool Proficiency. They gain proficiency with Woodcarver’s Tools. If they already have this proficiency, they gain proficiency with one other type of Artisan’s Tools of their choice.",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              },
              {
                "id": "artillerist-3-artillerist-spells",
                "name": "Artillerist Spells",
                "description": "When they reach an Artificer level specified in the Artillerist Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              },
              {
                "id": "artillerist-3-eldritch-cannon",
                "name": "Eldritch Cannon",
                "description": "Using Smith’s Tools or Woodcarver’s Tools, they can take a Magic action to create a Small or Tiny Eldritch Cannon in an unoccupied space on a horizontal surface within 5 feet of themselves. The cannon’s game statistics appear below. They determine its appearance, including whether they carry it or not (and their choice of legs or wheels, for the latter). It disappears if it is reduced to 0 Hit Points or after 1 hour. They can dismiss it early as a Magic action.",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              }
            ],
            "5": [
              {
                "id": "artillerist-5-arcane-firearm",
                "name": "Arcane Firearm",
                "description": "When they finish a Long Rest, they can use Woodcarver’s Tools to carve special sigils into a Rod, Staff, Wand, or Martial Ranged weapon and thereby turn it into their Arcane Firearm. The sigils disappear from the object if they later carve them on a different item. The sigils otherwise last indefinitely. They can use their Arcane Firearm as a Spellcasting Focus for their Artificer spells.",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              }
            ],
            "9": [
              {
                "id": "artillerist-9-explosive-cannon",
                "name": "Explosive Cannon",
                "description": "Every Eldritch Cannon they create is now more destructive. They gain the following benefits. Detonate. When their cannon takes damage, they can take a Reaction to command the cannon to detonate if they are within 60 feet of it.",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              }
            ],
            "15": [
              {
                "id": "artillerist-15-fortified-position",
                "name": "Fortified Position",
                "description": "They are a master at forming well-defended emplacements using their Eldritch Cannon. They gain the following benefits. Double Firepower. They can now have two cannons at the same time, and they can create two with the same Magic action. (If they expend a spell slot to create the first cannon, they must expend another spell slot to create the second.) they can activate both of them with the same Bonus Action, ordering them to use the same activation option or different ones. They can’t create a third cannon while…",
                "source": "http://dnd2024.wikidot.com/artificer:artillerist"
              }
            ]
          }
        },
        {
          "id": "artificer-battle-smith",
          "name": "Battle Smith",
          "description": "Command a Construct Guardian A Battle Smith is a combination of protector and medic, an expert at defending others and repairing both materiel and personnel. To aid in their work, Battle Smiths are accompanied by a Steel Defender, a protective companion of their own creation.",
          "levelFeatures": {
            "3": [
              {
                "id": "battle-smith-3-tools-of-the-trade",
                "name": "Tools of the Trade",
                "description": "Tool Proficiency. They gain proficiency with Smith’s Tools. If they already have this proficiency, they gain proficiency with one other type of Artisan’s Tools of their choice. Weapon Crafting.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              },
              {
                "id": "battle-smith-3-battle-smith-spells",
                "name": "Battle Smith spells",
                "description": "When they reach an Artificer level specified in the Battle Smith Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              },
              {
                "id": "battle-smith-3-battle-ready",
                "name": "Battle Ready",
                "description": "Their combat training and their experiments with magic have paid off in two ways. Arcane Empowerment. When they attack with a magic weapon, they can use their Intelligence modifier, instead of their Strength or Dexterity modifier, for the attack and damage rolls.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              },
              {
                "id": "battle-smith-3-steel-defender",
                "name": "Steel Defender",
                "description": "Their tinkering has borne they a companion, a Steel Defender (see the stat block). They determine the defender’s appearance and whether it has two legs or four; their choices don’t affect the defender’s game statistics. The defender is Friendly to them and their allies and obeys they. It vanishes if they die.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              }
            ],
            "5": [
              {
                "id": "battle-smith-5-extra-attack",
                "name": "Extra Attack",
                "description": "They can attack twice instead of once whenever they take the Attack action on their turn. They can forgo one of their attacks when they take the Attack action to command their Steel Defender to take the Force-Empowered Rend action.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              }
            ],
            "9": [
              {
                "id": "battle-smith-9-arcane-jolt",
                "name": "Arcane Jolt",
                "description": "When either they hit a target with an attack roll using a magic weapon or their Steel Defender hits a target, they can channel magical energy through the strike to create one of the following effects: Destructive Energy. The target takes an extra 2d6 Force damage. Restorative Energy.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              }
            ],
            "15": [
              {
                "id": "battle-smith-15-improved-defender",
                "name": "Improved Defender",
                "description": "Their Arcane Jolt and Steel Defender have become more powerful, granting these benefits. Improved Jolt. The extra damage and healing of their Arcane Jolt both increase to 4d6.",
                "source": "http://dnd2024.wikidot.com/artificer:battle-smith"
              }
            ]
          }
        },
        {
          "id": "artificer-cartographer",
          "name": "Cartographer",
          "description": "Chart Advantageous Courses through Turmoil Cartographers are the premier navigators and reconnaissance agents. Using their creations, Cartographers can highlight threats, safeguard allies, and carve portals to distant locations.",
          "levelFeatures": {
            "3": [
              {
                "id": "cartographer-3-tools-of-the-trade",
                "name": "Tools of the Trade",
                "description": "Tool Proficiency. They gain proficiency with Calligrapher’s Supplies and Cartographer’s Tools. If they already have one of these proficiencies, they gain proficiency with one other type of Artisan’s Tools of their choice (or with two other types if they have both). Scroll Crafting.",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              },
              {
                "id": "cartographer-3-cartographer-spells",
                "name": "Cartographer Spells",
                "description": "When they reach an Artificer level specified in the Cartographer Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              },
              {
                "id": "cartographer-3-adventurer-s-atlas",
                "name": "Adventurer's Atlas",
                "description": "Whenever they finish a Long Rest while holding Cartographer’s Tools, they can use that tool to create a set of magical maps by touching at least two creatures (one of whom can be themselves), up to a maximum number of creatures equal to 1 plus their Intelligence modifier (minimum of two creatures). Each target receives a magical map, which constantly updates to show the relative position of all the map holders but is illegible to all others. The maps last until they die or until they use this feature again, at…",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              },
              {
                "id": "cartographer-3-mapping-magic",
                "name": "Mapping Magic",
                "description": "Illuminated Cartography. They can cast Faerie Fire without expending a spell slot, outlining the affected creatures as if in ink. They can do so a number of times equal to their Intelligence modifier (minimum of once), and they regain all expended uses when they finish a Long Rest. Portal Jump. On their turn, they can spend an amount of movement equal to half their Speed (round down) to teleport to an unoccupied space they can see within 10 feet of themselves or within 5 feet of a creature that is within 30 feet…",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              }
            ],
            "5": [
              {
                "id": "cartographer-5-guided-precision",
                "name": "Guided Precision",
                "description": "Once per turn, whenever they cast a spell from their Cartographer Spells list or hit a creature affected by their Faerie Fire with an attack roll, they can add their Intelligence modifier to one damage roll of the spell or attack. In addition, taking damage can’t cause they to lose Concentration on Faerie Fire.",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              }
            ],
            "9": [
              {
                "id": "cartographer-9-ingenious-movement",
                "name": "Ingenious Movement",
                "description": "When they use their Flash of Genius, they or a willing creature of their choice that they can see within 30 feet of themselves can teleport up to 30 feet to an unoccupied space they can see as part of that same Reaction.",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              }
            ],
            "15": [
              {
                "id": "cartographer-15-superior-atlas",
                "name": "Superior Atlas",
                "description": "Their Adventurer’s Atlas improves, gaining the following benefits. Safe Haven. When a map holder would be reduced to 0 Hit Points but not killed outright, that creature can destroy its map.",
                "source": "http://dnd2024.wikidot.com/artificer:cartographer"
              }
            ]
          }
        },
        {
          "id": "artificer-reanimator",
          "name": "Reanimator",
          "description": "Reanimators defy the laws of nature in pursuit of gruesome experiments. These grim Artificers stitch together servants from disparate corpses, use foul magic to strengthen the living, and transform the art of necromancy into a terrifying science.",
          "levelFeatures": {
            "3": [
              {
                "id": "reanimator-3-reanimator-spells",
                "name": "Reanimator Spells",
                "description": "When they reach an Artificer level specified in the Reanimator Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              },
              {
                "id": "reanimator-3-reanimators-skill-set",
                "name": "Reanimator’s Skill Set",
                "description": "Jolt to Life. When they cast Spare the Dying, they can modify the spell so that it sends a jolt of electricity through the target, reviving it. The target regains a number of Hit Points equal to their Artificer level, and each creature of their choice in a 10-foot Emanation originating from the target makes a Dexterity saving throw against their spell save DC, taking 2d4 Lightning damage on a failed save or half as much damage on a successful one. They can modify the spell this way a number of times equal to…",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              },
              {
                "id": "reanimator-3-reanimated-companion",
                "name": "Reanimated Companion",
                "description": "Using Tinker’s Tools or another type of Artisan’s Tools with which they have proficiency, they can take a Magic action to create a Reanimated Companion (see the stat block) through the power of necromancy and science. The companion manifests in an unoccupied space within 5 feet of them. They determine the companion’s appearance; their choices don’t affect the companion’s game statistics. The companion is Friendly to them and their allies and obeys they.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              }
            ],
            "5": [
              {
                "id": "reanimator-5-strange-modifications",
                "name": "Strange Modifications",
                "description": "Whenever they create a Reanimated Companion, it gains one of the following options of their choice; choose when they create the companion. Arcane Conduit. They can cast spells as though they were in the companion’s space, but they must use their own senses. Once per turn, when they cast an Artificer spell from the Evocation or Necromancy school and deal damage while their companion is within 120 feet of them, they can add their Intelligence modifier to one damage roll of that spell.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              }
            ],
            "9": [
              {
                "id": "reanimator-9-improved-reanimation",
                "name": "Improved Reanimation",
                "description": "The damage of their Reanimated Companion’s Death Burst increases to 4d4. Necrotic damage dealt by their companion ignores Resistance.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              },
              {
                "id": "reanimator-9-macabre-modifications",
                "name": "Macabre Modifications",
                "description": "They experiment and alter their companion further. Whenever they create a Reanimated Companion, the companion now gains two options for Strange Modifications, instead of one. Additionally, when picking options for Strange Modifications, they can also choose from the following options.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              }
            ],
            "15": [
              {
                "id": "reanimator-15-refined-reanimation",
                "name": "Refined Reanimation",
                "description": "They have mastered the science of revivification, granting they the following benefits. Facilitated Revival. They can cast Raise Dead once without expending a spell slot and without Material components, provided they use Tinker’s Tools or another type of Artisan’s Tools with which they have proficiency as the Spellcasting Focus. Once they use this feature, they can’t use it again until they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/artificer:reanimator"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "stamina",
        "intellect"
      ]
    },
    {
      "id": "barbarian",
      "name": "Barbarian",
      "hitDie": 12,
      "primaryAbility": "strength",
      "description": "Barbarians are mighty warriors who are powered by primal forces of the multiverse that manifest as a Rage. More than a mere emotion—and not limited to anger—this Rage is an incarnation of a predator’s ferocity, a storm's fury, and a sea's turmoil.",
      "levelFeatures": {
        "1": [
          {
            "id": "barbarian-1-rage",
            "name": "Rage",
            "description": "They can imbue themselves with a primal power called Rage, a force that grants they extraordinary might and resilience. They can enter it as a Bonus Action if they aren't wearing Heavy armor. They can enter their Rage the number of times shown for their Barbarian level in the Rages column of the Barbarian Features table. They regain one expended use when they finish a Short Rest, and they regain all expended uses when they finish a Long Rest. While active, their Rage follows the rules below. Damage Resistance.…",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-1-unarmored-defense",
            "name": "Unarmored Defense",
            "description": "While they aren't wearing any armor, their base Armor Class equals 10 plus their Dexterity and Constitution modifiers. They can use a Shield and still gain this benefit.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-1-weapon-mastery",
            "name": "Weapon Mastery",
            "description": "Their training with weapons allows they to use the mastery properties of two kinds of Simple or Martial Melee weapons of their choice, such as Greataxes and Handaxes. Whenever they finish a Long Rest, they can practice weapon drills and change one of those weapon choices. When they reach certain Barbarian levels, they gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Barbarian Features table.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "2": [
          {
            "id": "barbarian-2-danger-sense",
            "name": "Danger Sense",
            "description": "They gain an uncanny sense of when things aren't as they should be, giving they an edge when they dodge perils. They have Advantage on Dexterity saving throws unless they have the Incapacitated condition.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-2-reckless-attack",
            "name": "Reckless Attack",
            "description": "They can throw aside all concern for defense to attack with increased ferocity. When they make their first attack roll on their turn, they can decide to attack recklessly. Doing so gives they Advantage on attack rolls using Strength until the start of their next turn, but attack rolls against them have Advantage during that time.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "3": [
          {
            "id": "barbarian-3-barbarian-subclass",
            "name": "Barbarian Subclass",
            "description": "They gain a Barbarian subclass of their choice. The Path of the Berserker, Path of the Wild Heart, Path of the World Tree, and Path of the Zealot subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Barbarian levels.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-3-primal-knowledge",
            "name": "Primal Knowledge",
            "description": "They gain proficiency in another skill of their choice from the skill list available to Barbarians at level 1. In addition, while their Rage is active, they can channel primal power when they attempt certain tasks; whenever they make an ability check using one of the following skills, they can make it as a Strength check even if it normally uses a different ability: Acrobatics, Intimidation, Perception, Stealth, or Survival. When they use this ability, their Strength represents primal power coursing through they…",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "4": [
          {
            "id": "barbarian-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Barbarian levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "5": [
          {
            "id": "barbarian-5-extra-attack",
            "name": "Extra Attack",
            "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-5-fast-movement",
            "name": "Fast Movement",
            "description": "Their speed increases by 10 feet while they aren't wearing Heavy armor.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "6": [
          {
            "id": "barbarian-6-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 6, Barbarian characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "7": [
          {
            "id": "barbarian-7-feral-instinct",
            "name": "Feral Instinct",
            "description": "Their instincts are so honed that they have Advantage on Initiative rolls.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          },
          {
            "id": "barbarian-7-instinctive-pounce",
            "name": "Instinctive Pounce",
            "description": "As part of the Bonus Action they take to enter their Rage, they can move up to half their Speed.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "8": [
          {
            "id": "barbarian-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Barbarian characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "9": [
          {
            "id": "barbarian-9-brutal-strike",
            "name": "Brutal Strike",
            "description": "If they use Reckless Attack, they can forgo any Advantage on one Strength-based attack roll of their choice on their turn. The chosen attack roll mustn't have Disadvantage. If the chosen attack roll hits, the target takes an extra 1d10 damage of the same type dealt by the weapon or Unarmed Strike, and they can cause one Brutal Strike effect of their choice. They have the following effect options.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "10": [
          {
            "id": "barbarian-10-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 10, Barbarian characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "11": [
          {
            "id": "barbarian-11-relentless-rage",
            "name": "Relentless Rage",
            "description": "Their Rage can keep they fighting despite grievous wounds. If they drop to 0 Hit Points while their Rage is active and don't die outright, they can make a DC 10 Constitution saving throw. If they succeed, their Hit Points instead change to a number equal to twice their Barbarian level.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "12": [
          {
            "id": "barbarian-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Barbarian characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "13": [
          {
            "id": "barbarian-13-improved-brutal-strike",
            "name": "Improved Brutal Strike",
            "description": "They have honed new ways to attack furiously. The following effects are now among their Brutal Strike options. Staggering Blow.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "14": [
          {
            "id": "barbarian-14-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 14, Barbarian characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "15": [
          {
            "id": "barbarian-15-persistent-rage",
            "name": "Persistent Rage",
            "description": "When they roll Initiative, they can regain all expended uses of Rage. After they regain uses of Rage in this way, they can’t do so again until they finish a Long Rest. In addition, their Rage is so fierce that it now lasts for 10 minutes without they needing to do anything to extend it from round to round. their Rage ends early if they have the Unconscious condition (not just the Incapacitated condition) or don Heavy armor.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "16": [
          {
            "id": "barbarian-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Barbarian characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "17": [
          {
            "id": "barbarian-17-improved-brutal-strike",
            "name": "Improved Brutal Strike",
            "description": "The extra damage of their Brutal Strike increases to 2d10. In addition, they can use two different Brutal Strike effects whenever they use their Brutal Strike feature.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "18": [
          {
            "id": "barbarian-18-indomitable-might",
            "name": "Indomitable Might",
            "description": "If their total for a Strength check or Strength saving throw is less than their Strength score, they can use that score in place of the total.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "19": [
          {
            "id": "barbarian-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Irresistible Offense is recommended.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ],
        "20": [
          {
            "id": "barbarian-20-primal-champion",
            "name": "Primal Champion",
            "description": "They embody primal power. their Strength and Constitution scores increase by 4, to a maximum of 25.",
            "source": "http://dnd2024.wikidot.com/barbarian:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "barbarian-path-of-the-berserker",
          "name": "Path of the Berserker",
          "description": "Channel Rage into Violent Fury Barbarians who walk the Path of the Berserker direct their Rage primarily toward violence. Their path is one of untrammeled fury, and they thrill in the chaos of battle as they allow their Rage to seize and empower them.",
          "levelFeatures": {
            "3": [
              {
                "id": "path-of-the-berserker-3-frenzy",
                "name": "Frenzy",
                "description": "If they use Reckless Attack while their Rage is active, they deal extra damage to the first target they hit on their turn with a Strength-based attack. To determine the extra damage, roll a number of d6s equal to their Rage Damage bonus, and add them together. The damage has the same type as the weapon or Unarmed Strike used for the attack.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-berserker"
              }
            ],
            "6": [
              {
                "id": "path-of-the-berserker-6-mindless-rage",
                "name": "Mindless Rage",
                "description": "They have Immunity to the Charmed and Frightened conditions while their Rage is active. If they are Charmed or Frightened when they enter their Rage, the condition ends on they.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-berserker"
              }
            ],
            "10": [
              {
                "id": "path-of-the-berserker-10-retaliation",
                "name": "Retaliation",
                "description": "When they take damage from a creature that is within 5 feet of them, they can take a Reaction to make one melee attack against that creature, using a weapon or an Unarmed Strike.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-berserker"
              }
            ],
            "14": [
              {
                "id": "path-of-the-berserker-14-intimidating-presence",
                "name": "Intimidating Presence",
                "description": "As a Bonus Action, they can strike terror into others with their menacing presence and primal power. When they do so, each creature of their choice in a 30-foot Emanation originating from them must make a Wisdom saving throw (DC 8 plus their Strength modifier and Proficiency Bonus). On a failed save, a creature has the Frightened condition for 1 minute.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-berserker"
              }
            ]
          }
        },
        {
          "id": "barbarian-path-of-the-wild-heart",
          "name": "Path of the Wild Heart",
          "description": "Walk in Community with the Animal World Barbarians who follow the Path of the Wild Heart view themselves as kin to animals. These Barbarians learn magical means to communicate with animals, and their Rage heightens their connection to animals as it fills them with supernatural might.",
          "levelFeatures": {
            "3": [
              {
                "id": "path-of-the-wild-heart-3-animal-speaker",
                "name": "Animal Speaker",
                "description": "They can cast the Beast Sense and Speak with Animals spells but only as Rituals. Wisdom is their spellcasting ability for them.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-wild-heart"
              },
              {
                "id": "path-of-the-wild-heart-3-rage-of-the-wilds",
                "name": "Rage of the Wilds",
                "description": "Their Rage taps into the primal power of animals. Whenever they activate their Rage, they gain one of the following options of their choice. Bear.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-wild-heart"
              }
            ],
            "6": [
              {
                "id": "path-of-the-wild-heart-6-aspect-of-the-wilds",
                "name": "Aspect of the Wilds",
                "description": "They gain one of the following options of their choice. Whenever they finish a Long Rest, they can change their choice. Owl. They have Darkvision with a range of 60 feet.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-wild-heart"
              }
            ],
            "10": [
              {
                "id": "path-of-the-wild-heart-10-nature-speaker",
                "name": "Nature Speaker",
                "description": "They can cast the Commune with Nature spell but only as a Ritual. Wisdom is their spellcasting ability for it.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-wild-heart"
              }
            ],
            "14": [
              {
                "id": "path-of-the-wild-heart-14-power-of-the-wilds",
                "name": "Power of the Wilds",
                "description": "Whenever they activate their Rage, they gain one of the following options of their choice. Falcon. While their Rage is active, they have a Fly Speed equal to their Speed if they aren’t wearing any armor.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-wild-heart"
              }
            ]
          }
        },
        {
          "id": "barbarian-path-of-the-world-tree",
          "name": "Path of the World Tree",
          "description": "Trace the Roots and Branches of the Multiverse Barbarians who follow the Path of the World Tree connect with the cosmic tree Yggdrasil through their Rage. This tree grows among the Outer Planes, connecting them to each other and the Material Plane. These Barbarians draw on the tree’s magic for vitality and as a means of dimensional travel.",
          "levelFeatures": {
            "3": [
              {
                "id": "path-of-the-world-tree-3-vitality-of-the-tree",
                "name": "Vitality of the Tree",
                "description": "Their Rage taps into the life force of the World Tree. They gain the following benefits. Vitality Surge. When they activate their Rage, they gain a number of Temporary Hit Points equal to their Barbarian level.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-world-tree"
              }
            ],
            "6": [
              {
                "id": "path-of-the-world-tree-6-branches-of-the-tree",
                "name": "Branches of the Tree",
                "description": "Whenever a creature they can see starts its turn within 30 feet of them while their Rage is active, they can take a Reaction to summon spectral branches of the World Tree around it. The target must succeed on a Strength saving throw (DC 8 plus their Strength modifier and Proficiency Bonus) or be teleported to an unoccupied space they can see within 5 feet of themselves or in the nearest unoccupied space they can see. After the target teleports, they can reduce its Speed to 0 until the end of the current turn.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-world-tree"
              }
            ],
            "10": [
              {
                "id": "path-of-the-world-tree-10-battering-roots",
                "name": "Battering Roots",
                "description": "During their turn, their reach is 10 feet greater with any Melee weapon that has the Heavy or Versatile property, as tendrils of the World Tree extend from them. When they hit with such a weapon on their turn, they can activate the Push or Topple mastery property in addition to a different mastery property they are using with that weapon.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-world-tree"
              }
            ],
            "14": [
              {
                "id": "path-of-the-world-tree-14-travel-along-the-tree",
                "name": "Travel along the Tree",
                "description": "When they activate their Rage and as a Bonus Action while their Rage is active, they can teleport up to 60 feet to an unoccupied space they can see. In addition, once per Rage, they can increase the range of that teleport to 150 feet. When they do so, they can also bring up to six willing creatures who are within 10 feet of them.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-world-tree"
              }
            ]
          }
        },
        {
          "id": "barbarian-path-of-the-zealot",
          "name": "Path of the Zealot",
          "description": "Rage in Ecstatic Union with a God Barbarians who walk the Path of the Zealot receive boons from a god or pantheon. These Barbarians experience their Rage as an ecstatic episode of divine union that infuses them with power. They are often allies to the priests and other followers of their god or pantheon.",
          "levelFeatures": {
            "3": [
              {
                "id": "path-of-the-zealot-3-divine-fury",
                "name": "Divine Fury",
                "description": "They can channel divine power into their strikes. On each of their turns while their Rage is active, the first creature they hit with a weapon or an Unarmed Strike takes extra damage equal to 1d6 plus half their Barbarian level (round down). The extra damage is Necrotic or Radiant; they choose the type each time they deal the damage.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-zealot"
              },
              {
                "id": "path-of-the-zealot-3-warrior-of-the-gods",
                "name": "Warrior of the Gods",
                "description": "A divine entity helps ensure they can continue the fight. They have a pool of four d12s that they can spend to heal themselves. As a Bonus Action, they can expend dice from the pool, roll them, and regain a number of Hit Points equal to the roll’s total. their pool regains all expended dice when they finish a Long Rest. The pool's maximum number of dice increases by one when they reach Barbarian levels 6 (5 dice), 12 (6 dice), and 17 (7 dice).",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-zealot"
              }
            ],
            "6": [
              {
                "id": "path-of-the-zealot-6-fanatical-focus",
                "name": "Fanatical Focus",
                "description": "Once per active Rage, if they fail a saving throw, they can reroll it with a bonus equal to their Rage Damage bonus, and they must use the new roll.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-zealot"
              }
            ],
            "10": [
              {
                "id": "path-of-the-zealot-10-zealous-presence",
                "name": "Zealous Presence",
                "description": "As a Bonus Action, they unleash a battle cry infused with divine energy. Up to ten other creatures of their choice within 60 feet of them gain Advantage on attack rolls and saving throws until the start of their next turn. Once they use this feature, they can’t use it again until they finish a Long Rest unless they expend a use of their Rage (no action required) to restore their use of it.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-zealot"
              }
            ],
            "14": [
              {
                "id": "path-of-the-zealot-14-rage-of-the-gods",
                "name": "Rage of the Gods",
                "description": "When they activate their Rage, they can assume the form of a divine warrior. This form lasts for 1 minute or until they drop to 0 Hit Points. Once they use this feature, they can't do so again until they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/barbarian:path-of-the-zealot"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "strength",
        "stamina"
      ]
    },
    {
      "id": "bard",
      "name": "Bard",
      "hitDie": 8,
      "primaryAbility": "charisma",
      "description": "Invoking magic through music, dance, and verse, Bards are expert at inspiring others, soothing hurts, disheartening foes, and creating illusions. Bards believe the multiverse was spoken into existence and that remnants of its Words of Creation still resound and glimmer on every plane of existence. Bardic magic attempts to harness those words, which transcend any language.",
      "levelFeatures": {
        "1": [
          {
            "id": "bard-1-bardic-inspiration",
            "name": "Bardic Inspiration",
            "description": "They can supernaturally inspire others through words, music, or dance. This inspiration is represented by their Bardic Inspiration die, which is a d6. Using Bardic Inspiration.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          },
          {
            "id": "bard-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned to cast spells through their bardic arts. See chapter 7 for the rules on spellcasting. The information below details how they use those rules with Bard spells, which appear in the Bard spell list later in the class's description.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "2": [
          {
            "id": "bard-2-expertise",
            "name": "Expertise",
            "description": "They gain Expertise (see the rules glossary) in two of their skill proficiencies of their choice. Performance and Persuasion are recommended if they have proficiency in them. At Bard level 9, they gain Expertise in two more of their skill proficiencies of their choice.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          },
          {
            "id": "bard-2-jack-of-all-trades",
            "name": "Jack of all Trades",
            "description": "They can add half their Proficiency Bonus (round down) to any ability check they make that uses a skill proficiency they lack and that doesn't otherwise use their Proficiency Bonus. For example, if they make a Strength (Athletics) check and lack Athletics proficiency, they can add half their Proficiency Bonus to the check.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "3": [
          {
            "id": "bard-3-bard-subclass",
            "name": "Bard Subclass",
            "description": "They gain a Bard subclass of their choice. The College of Dance, College of Glamour, College of Lore, and College of Valor subclasses are detailed after this class's description. A subclass is a specialization that grants they features at certain Bard levels.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "4": [
          {
            "id": "bard-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Bard levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "5": [
          {
            "id": "bard-5-font-of-inspiration",
            "name": "Font of Inspiration",
            "description": "They now regain all their expended uses of Bardic Inspiration when they finish a Short or Long Rest. In addition, they can expend a spell slot (no action required) to regain one expended use of Bardic Inspiration.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "6": [
          {
            "id": "bard-6-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 6, Bard characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "7": [
          {
            "id": "bard-7-countercharm",
            "name": "Countercharm",
            "description": "They can use musical notes or words of power to disrupt mind-influencing effects. If they or a creature within 30 feet of them fails a saving throw against an effect that applies the Charmed or Frightened condition, they can take a Reaction to cause the save to be rerolled, and the new roll has Advantage.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "8": [
          {
            "id": "bard-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Bard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "9": [
          {
            "id": "bard-9-expertise",
            "name": "Expertise",
            "description": "At level 9, Bard characters gain Expertise.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "10": [
          {
            "id": "bard-10-magical-secrets",
            "name": "Magical Secrets",
            "description": "They have learned secrets from various magical traditions. Whenever they reach a Bard level (including this level) and the Prepared Spells number in the Bard Features table increases, they can choose any of their new prepared spells from the Bard, Cleric, Druid, and Wizard spell lists, and the chosen spells count as Bard spells for them (see a class’s section for its spell list). In addition, whenever they replace a spell prepared for this class, they can replace it with a spell from those lists.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "12": [
          {
            "id": "bard-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Bard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "14": [
          {
            "id": "bard-14-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 14, Bard characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "16": [
          {
            "id": "bard-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Bard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "18": [
          {
            "id": "bard-18-superior-inspiration",
            "name": "Superior Inspiration",
            "description": "When they roll Initiative, they regain expended uses of Bardic Inspiration until they have two if they have fewer than that.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "19": [
          {
            "id": "bard-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Spell Recall is recommended.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ],
        "20": [
          {
            "id": "bard-20-words-of-creation",
            "name": "Words of Creation",
            "description": "They have mastered two of the Words of Creation: the words of life and death. They therefore always have the Power Word: Heal and Power Word: Kill spells prepared. When they cast either spell, they can target a second creature with it if that creature is within 10 feet of the first target.",
            "source": "http://dnd2024.wikidot.com/bard:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "bard-college-of-dance",
          "name": "College of Dance",
          "description": "Move in Harmony with the Cosmos Bards of the College of Dance know that the Words of Creation can't be contained within speech or song; the words are uttered by the movements of celestial bodies and flow through the motions of the smallest creatures. These Bards practice a way of being in harmony with the whirling cosmos that emphasizes agility, speed, and grace.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-dance-3-dazzling-footwork",
                "name": "Dazzling Footwork",
                "description": "While they aren’t wearing armor or wielding a Shield, they gain the following benefits. Dance Virtuoso. They have Advantage on any Charisma (Performance) check they make that involves they dancing. Unarmored Defense. their base Armor Class equals 10 plus their Dexterity and Charisma modifiers.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-dance"
              }
            ],
            "6": [
              {
                "id": "college-of-dance-6-inspiring-movement",
                "name": "Inspiring Movement",
                "description": "When an enemy they can see ends its turn within 5 feet of them, they can take a Reaction and expend one use of their Bardic Inspiration to move up to half their Speed. Then one ally of their choice within 30 feet of them can also move up to half their Speed using their Reaction. None of this feature’s movement provokes Opportunity Attacks.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-dance"
              },
              {
                "id": "college-of-dance-6-tandem-footwork",
                "name": "Tandem Footwork",
                "description": "When they roll Initiative, they can expend one use of their Bardic Inspiration if they don't have the Incapacitated condition. When they do so, roll their Bardic Inspiration die; they and each ally within 30 feet of them who can see or hear they gains a bonus to Initiative equal to the number rolled.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-dance"
              }
            ],
            "14": [
              {
                "id": "college-of-dance-14-leading-evasion",
                "name": "Leading Evasion",
                "description": "When they are subjected to an effect that allows they to make a Dexterity saving throw to take only half damage, they instead take no damage if they succeed on the saving throw and only half damage if they fail. If any creatures within 5 feet of them are making the same Dexterity saving throw, they can share this benefit with them for that save. They can’t use this feature if they have the Incapacitated condition.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-dance"
              }
            ]
          }
        },
        {
          "id": "bard-college-of-glamour",
          "name": "College of Glamour",
          "description": "Weave Beguiling Fey Magic The College of Glamour traces its origins to the beguiling magic of the Feywild. Bards who study this magic weave threads of beauty and terror into their songs and stories, and the mightiest among them can cloak themselves in otherworldly majesty. Their performances stir up wistful longing for forgotten innocence, evoke unconscious memories of longheld fears, and tug at the emotions of even the most hard-hearted listeners.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-glamour-3-beguiling-magic",
                "name": "Beguiling Magic",
                "description": "They always have the Charm Person and Mirror Image spells prepared. In addition, immediately after they cast an Enchantment or Illusion spell using a spell slot, they can cause a creature they can see within 60 feet of themselves to make a Wisdom saving throw against their spell save DC. On a failed save, the target has the Charmed or Frightened condition (their choice) for 1 minute.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-glamour"
              },
              {
                "id": "college-of-glamour-3-mantle-of-inspiration",
                "name": "Mantle of Inspiration",
                "description": "They can weave fey magic into a song or dance to fill others with vigor. As a Bonus Action, they can expend a use of Bardic Inspiration, rolling a Bardic Inspiration die. When they do so, choose a number of other creatures within 60 feet of themselves, up to a number equal to their Charisma modifier (minimum of one creature).",
                "source": "http://dnd2024.wikidot.com/bard:college-of-glamour"
              }
            ],
            "6": [
              {
                "id": "college-of-glamour-6-mantle-of-majesty",
                "name": "Mantle of Majesty",
                "description": "They always have the Command spell prepared. As a Bonus Action, they cast Command without expending a spell slot, and they take on an unearthly appearance for 1 minute or until their Concentration ends. During this time, they can cast Command as a Bonus Action without expending a spell slot, Any creature Charmed by they automatically fails its saving throw against the Command they cast with this feature.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-glamour"
              }
            ],
            "14": [
              {
                "id": "college-of-glamour-14-unbreakable-majesty",
                "name": "Unbreakable Majesty",
                "description": "As a Bonus Action, they can assume a magically majestic presence for 1 minute or until they have the Incapacitated condition. For the duration, whenever any creature hits they with an attack roll for the first time on a turn, the attacker must succeed on a Charisma saving throw against their spell save DC, or the attack misses instead, as the creature recoils from their majesty. Once they assume this majestic presence, they can't do so again until they finish a Short or Long Rest.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-glamour"
              }
            ]
          }
        },
        {
          "id": "bard-college-of-lore",
          "name": "College of Lore",
          "description": "Plumb the Depths of Magical Knowledge Bards of the College of Lore collect spells and secrets from diverse sources, such as scholarly tomes, mystical rites, and peasant tales. The college’s members gather in libraries and universities to share their lore with one another. They also meet at festivals or affairs of state, where they can expose corruption, unravel lies, and poke fun at self-important figures of authority.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-lore-3-bonus-proficiencies",
                "name": "Bonus Proficiencies",
                "description": "They gain proficiency with three skills of their choice.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-lore"
              },
              {
                "id": "college-of-lore-3-cutting-words",
                "name": "Cutting Words",
                "description": "They learn to use their wit to supernaturally distract, confuse, and otherwise sap the confidence and competence of others. When a creature that they can see within 60 feet of themselves makes a damage roll or succeeds on an ability check or attack roll, they can take a Reaction to expend one use of their Bardic Inspiration; roll their Bardic Inspiration die, and subtract the number rolled from the creature's roll, reducing the damage or potentially turning the success into a failure.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-lore"
              }
            ],
            "6": [
              {
                "id": "college-of-lore-6-magical-discoveries",
                "name": "Magical Discoveries",
                "description": "They learn two spells of their choice. These spells can come from the Cleric, Druid, or Wizard spell list or any combination thereof (see a class’s section for its spell list). A spell they choose must be a cantrip or a spell for which they have spell slots, as shown in the Bard Features table. They always have the chosen spells prepared, and whenever they gain a Bard level, they can replace one of the spells with another spell that meets these requirements.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-lore"
              }
            ],
            "14": [
              {
                "id": "college-of-lore-14-peerless-skill",
                "name": "Peerless Skill",
                "description": "When they make an ability check or attack roll and fail, they can expend one use of Bardic Inspiration; roll the Bardic Inspiration die, and add the number rolled to the d20, potentially turning a failure into a success. On a failure, the Bardic Inspiration isn’t expended.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-lore"
              }
            ]
          }
        },
        {
          "id": "bard-college-of-spirits",
          "name": "College of Spirits",
          "description": "Call Forth Spirits from Beyond the Grave Bards of the College of Spirits conjure legendary spirits to change the world. But such entities are capricious, and what a Bard summons isn’t always entirely under their control.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-spirits-3-channeler",
                "name": "Channeler",
                "description": "They learn how to contact spirits beyond the grave, letting their power and knowledge flow through they. They gain the following benefits. Guiding Whispers. They know the Guidance cantrip. It has a range of 60 feet when they cast it.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-spirits"
              },
              {
                "id": "college-of-spirits-3-spirits-from-beyond",
                "name": "Spirits from Beyond",
                "description": "They can call forth spirits of the dead to empower they and their allies. When they take a Bonus Action to give a creature a Bardic Inspiration die, they can call forth the powers of a random spirit. To determine the spirit they channel, roll the Bardic Inspiration die and refer to the Spirits from Beyond table.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-spirits"
              }
            ],
            "6": [
              {
                "id": "college-of-spirits-6-empowered-channeling",
                "name": "Empowered Channeling",
                "description": "Their ability to channel spirits improves. They gain the following benefits. Power from Beyond. Once per turn, when they cast a Bard spell with a spell slot that deals damage or restores Hit Points, roll 1d6. They gain a bonus equal to the number rolled to one of the spell’s damage rolls or to the total Hit Points the spell restores.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-spirits"
              }
            ],
            "14": [
              {
                "id": "college-of-spirits-14-mystical-connection",
                "name": "Mystical Connection",
                "description": "They gain mastery over the spirits they call forth. Whenever they roll on the Spirits from Beyond table, they can roll the die twice and choose which of the two effects to bestow. If they roll the same number on both dice, they can instead choose any effect on the table.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-spirits"
              }
            ]
          }
        },
        {
          "id": "bard-college-of-the-moon",
          "name": "College of the Moon",
          "description": "The College of the Moon traces its origins to the ancient druidic circles of the Moonshae Isles, who entrusted the first Bards of this tradition with chronicling the stories of the islands and their people. Bards of this college draw from the isles’ fey magic and the primal power of the moonwells to bolster their allies, protect the natural world, and inspire their bardic works.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-the-moon-3-moon-s-inspiration",
                "name": "Moon's Inspiration",
                "description": "The primal and ever-changing power of the moon flows through they, granting they the following benefits. Inspired Eclipse. When they take a Bonus Action to give a creature a Bardic Inspiration die, they can have the Invisible condition and teleport up to 30 feet to an unoccupied space they can see as part of that Bonus Action.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-the-moon"
              },
              {
                "id": "college-of-the-moon-3-primal-lore",
                "name": "Primal Lore",
                "description": "They learn Druidic and one cantrip from the Druid spell list. It counts as a Bard spell for them but doesn’t count against the number of cantrips they know. Whenever they gain a Bard level, they can replace this cantrip with another cantrip of their choice from the Druid spell list.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-the-moon"
              }
            ],
            "6": [
              {
                "id": "college-of-the-moon-6-blessing-of-moonlight",
                "name": "Blessing of Moonlight",
                "description": "They always have the Moonbeam spell prepared. When they cast Moonbeam, they can modify the spell so that they glow faintly while the spell is active. While glowing, they shed Dim Light out to 5 feet, and whenever a creature fails its saving throw against the effects of this Moonbeam, another creature of their choice that they can see within 60 feet of themselves regains 2d4 Hit Points.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-the-moon"
              }
            ],
            "14": [
              {
                "id": "college-of-the-moon-14-eventide-s-splendor",
                "name": "Eventide's Splendor",
                "description": "They become suffused with the might of the moon, improving their Moon’s Inspiration in the following ways. Shadow of the New Moon. When they use Inspired Eclipse, the creature who received the Bardic Inspiration die can also have the Invisible condition and immediately take a Reaction to teleport up to 30 feet to an unoccupied space it can see.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-the-moon"
              }
            ]
          }
        },
        {
          "id": "bard-college-of-valor",
          "name": "College of Valor",
          "description": "Sing the Deeds of Ancient Heroes Bards of the College of Valor are daring storytellers whose tales preserve the memory of the great heroes of the past. These Bards sing the deeds of the mighty in vaulted halls or to crowds gathered around great bonfires. They travel to witness great events firsthand and to ensure that the memory of these events doesn’t pass away.",
          "levelFeatures": {
            "3": [
              {
                "id": "college-of-valor-3-combat-inspiration",
                "name": "Combat Inspiration",
                "description": "They can use their wit to turn the tide of battle. A creature that has a Bardic Inspiration die from them can use it for one of the following effects. Defense.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-valor"
              },
              {
                "id": "college-of-valor-3-martial-training",
                "name": "Martial Training",
                "description": "They gain proficiency with Martial weapons and training with Medium armor and Shields. In addition, they can use a Simple or Martial weapon as a Spellcasting Focus to cast spells from their Bard spell list.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-valor"
              }
            ],
            "6": [
              {
                "id": "college-of-valor-6-extra-attack",
                "name": "Extra Attack",
                "description": "They can attack twice instead of once whenever they take the Attack action on their turn. In addition, they can cast one of their cantrips that has a casting time of an action in place of one of those attacks.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-valor"
              }
            ],
            "14": [
              {
                "id": "college-of-valor-14-battle-magic",
                "name": "Battle Magic",
                "description": "After they cast a spell that has a casting time of an action, they can make one attack with a weapon as a Bonus Action.",
                "source": "http://dnd2024.wikidot.com/bard:college-of-valor"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "agility",
        "charisma"
      ]
    },
    {
      "id": "cleric",
      "name": "Cleric",
      "hitDie": 8,
      "primaryAbility": "spirit",
      "description": "Clerics draw power from the realms of the gods and harness it to work miracles. Blessed by a deity, a pantheon, or another immortal entity, a Cleric can reach out to the divine magic of the Outer Planes—where gods dwell—and channel it to bolster people and battle foes.",
      "levelFeatures": {
        "1": [
          {
            "id": "cleric-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned to cast spells through prayer and meditation. See chapter 7 for the rules on spellcasting. The information below details how they use those rules with Cleric spells, which appear on the Cleric spell list later in the class’s description.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          },
          {
            "id": "cleric-1-divine-order",
            "name": "Divine Order",
            "description": "They have dedicated themselves to one of the following sacred roles of their choice. Protector. Trained for battle, they gain proficiency with Martial weapons and training with Heavy armor.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "2": [
          {
            "id": "cleric-2-channel-divinity",
            "name": "Channel Divinity",
            "description": "They can channel divine energy directly from the Outer Planes to fuel magical effects. They start with two such effects: Divine Spark and Turn Undead, each of which is described below. Each time they use this class’s Channel Divinity, choose which Channel Divinity effect from this class to create. They gain additional effect options at higher Cleric levels. They can use this class’s Channel Divinity twice. They regain one of its expended uses when they finish a Short Rest, and they regain all expended uses when…",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "3": [
          {
            "id": "cleric-3-cleric-subclass",
            "name": "Cleric Subclass",
            "description": "They gain a Cleric subclass of their choice. The Life Domain, Light Domain, Trickery Domain, and War Domain subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Cleric levels.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "4": [
          {
            "id": "cleric-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Cleric levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "5": [
          {
            "id": "cleric-5-sear-undead",
            "name": "Sear Undead",
            "description": "Whenever they use Turn Undead, they can roll a number of d8s equal to their Wisdom modifier (minimum of 1d8) and add the rolls together. Each Undead that fails its saving throw against that use of Turn Undead takes Radiant damage equal to the roll’s total. This damage doesn’t end the turn effect.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "6": [
          {
            "id": "cleric-6-subclass-feature",
            "name": "Subclass Feature",
            "description": "At level 6, Cleric characters gain Subclass Feature.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "7": [
          {
            "id": "cleric-7-blessed-strikes",
            "name": "Blessed Strikes",
            "description": "Divine power infuses they in battle. They gain one of the following options of their choice (if they get either option from a Cleric subclass in an older book, use only the option they choose for this feature). Divine Strike. Once on each of their turns when they hit a creature with an attack roll using a weapon, they can cause the target to take an extra 1d8 Necrotic or Radiant damage (their choice).",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "8": [
          {
            "id": "cleric-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Cleric characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "10": [
          {
            "id": "cleric-10-divine-intervention",
            "name": "Divine Intervention",
            "description": "They can call on their deity or pantheon to intervene on their behalf. As a Magic action, choose any Cleric spell of level 5 or lower that doesn’t require a Reaction to cast. As part of the same action, they cast that spell without expending a spell slot or needing Material components. They can’t use this feature again until they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "12": [
          {
            "id": "cleric-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Cleric characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "14": [
          {
            "id": "cleric-14-improved-blessed-strikes",
            "name": "Improved Blessed Strikes",
            "description": "The option they chose for Blessed Strikes grows more powerful. Divine Strike. The extra damage of their Divine Strike increases to 2d8.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "16": [
          {
            "id": "cleric-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Cleric characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "17": [
          {
            "id": "cleric-17-subclass-feature",
            "name": "Subclass Feature",
            "description": "At level 17, Cleric characters gain Subclass Feature.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "19": [
          {
            "id": "cleric-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Fate is recommended.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ],
        "20": [
          {
            "id": "cleric-20-greater-divine-intervention",
            "name": "Greater Divine Intervention",
            "description": "They can call on even more powerful divine intervention. When they use their Divine Intervention feature, they can choose Wish when they select a spell. If they do so, they can’t use Divine Intervention again until they finish 2d4 Long Rests.",
            "source": "http://dnd2024.wikidot.com/cleric:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "cleric-grave-domain",
          "name": "Grave Domain",
          "description": "Embody Deific Forces of Death The Grave Domain concerns itself with the boundary between life and death. To those who tap into this domain’s power, death is a natural and inevitable part of the multiverse. Such Clerics seek to destroy undead and shepherd spirits.",
          "levelFeatures": {
            "3": [
              {
                "id": "grave-domain-3-grave-domain-spells",
                "name": "Grave Domain Spells",
                "description": "Their connection to this divine domain ensures they always have certain spells ready. When they reach a Cleric level specified in the Grave Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:grave-domain"
              },
              {
                "id": "grave-domain-3-circle-of-mortality",
                "name": "Circle of Mortality",
                "description": "They can manipulate the balance between life and death, granting they the following benefits. Pull of Death. Once per turn, when they deal damage to a creature that’s missing any Hit Points by casting a spell or by hitting with an attack roll, that creature takes an extra 1d4 Necrotic damage.",
                "source": "http://dnd2024.wikidot.com/cleric:grave-domain"
              },
              {
                "id": "grave-domain-3-path-to-the-grave",
                "name": "Path to the Grave",
                "description": "As a Bonus Action, they present their Holy Symbol and expend a use of Channel Divinity to curse one creature they can see within 30 feet of themselves until the start of their next turn. While cursed, the creature has Disadvantage on attack rolls and saving throws. When they or an ally they can see hits the cursed target with an attack roll, they can end the curse early (no action required) to make the attack deal extra Necrotic or Radiant damage (their choice) equal to their Cleric level.",
                "source": "http://dnd2024.wikidot.com/cleric:grave-domain"
              }
            ],
            "6": [
              {
                "id": "grave-domain-6-sentinel-at-deaths-door",
                "name": "Sentinel at Death’s Door",
                "description": "When they or a Bloodied creature they can see within 60 feet of themselves is hit with an attack roll, they can take a Reaction to halve that attack’s damage (round down). If the triggering attack roll was a Critical Hit, any effects triggered by a Critical Hit are canceled. They can use this feature a number of times equal to their Wisdom modifier (minimum of once). They regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/cleric:grave-domain"
              }
            ],
            "17": [
              {
                "id": "grave-domain-17-divine-reaper",
                "name": "Divine Reaper",
                "description": "Their deep connection to this domain renders they a hallowed harbinger of death, granting they the following benefits. Enhanced Necromancy. When they cast a spell of level 5 or lower from the Necromancy school that targets one creature, or when they cast a spell from the Grave Domain Spells table, they can expend a use of Channel Divinity to target a second creature within the spell’s range.",
                "source": "http://dnd2024.wikidot.com/cleric:grave-domain"
              }
            ]
          }
        },
        {
          "id": "cleric-knowledge-domain",
          "name": "Knowledge Domain",
          "description": "The Knowledge Domain values learning and understanding above all. Clerics who tap into this domain study esoteric lore, collect old tomes, delve into secret places, and examine the processes of the mind. To them, knowledge is more valuable than material wealth, and learning is an act of worship.",
          "levelFeatures": {
            "3": [
              {
                "id": "knowledge-domain-3-blessings-of-knowledge",
                "name": "Blessings of Knowledge",
                "description": "They gain proficiency with one type of Artisan’s Tools of their choice and in two of the following skills of their choice: Arcana, History, Nature, or Religion. They have Expertise in those two skills.",
                "source": "http://dnd2024.wikidot.com/cleric:knowledge-domain"
              },
              {
                "id": "knowledge-domain-3-knowledge-domain-spells",
                "name": "Knowledge Domain Spells",
                "description": "When they reach a Cleric level specified in the Knowledge Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:knowledge-domain"
              },
              {
                "id": "knowledge-domain-3-mind-magic",
                "name": "Mind Magic",
                "description": "As a Magic action, they can expend one use of their Channel Divinity to manifest their magical knowledge. Choose one spell from the Divination school on the Knowledge Domain Spells table that they have prepared. As part of that action, they cast that spell without expending a spell slot or needing Material components.",
                "source": "http://dnd2024.wikidot.com/cleric:knowledge-domain"
              }
            ],
            "6": [
              {
                "id": "knowledge-domain-6-unfettered-mind",
                "name": "Unfettered Mind",
                "description": "They gain telepathy out to 60 feet. When they use this telepathy, they can simultaneously contact a number of creatures equal to their Wisdom modifier (minimum of one). Additionally, they gain proficiency in Intelligence saving throws.",
                "source": "http://dnd2024.wikidot.com/cleric:knowledge-domain"
              }
            ],
            "17": [
              {
                "id": "knowledge-domain-17-divine-foreknowledge",
                "name": "Divine Foreknowledge",
                "description": "As a Bonus Action, they magically expand their mind to the future. For 1 hour, they have Advantage on D20 Tests. Once they use this feature, they can’t use it again until they finish a Long Rest. They can also restore their use of this feature by expending a level 6+ spell slot (no action required).",
                "source": "http://dnd2024.wikidot.com/cleric:knowledge-domain"
              }
            ]
          }
        },
        {
          "id": "cleric-life-domain",
          "name": "Life Domain",
          "description": "The Life Domain focuses on the positive energy that helps sustain all life in the multiverse. Clerics who tap into this domain are masters of healing, using that life force to cure many hurts.",
          "levelFeatures": {
            "3": [
              {
                "id": "life-domain-3-disciple-of-life",
                "name": "Disciple of Life",
                "description": "When a spell they cast with a spell slot restores Hit Points to a creature, that creature regains additional Hit Points on the turn they cast the spell. The additional Hit Points equal 2 plus the spell slot’s level.",
                "source": "http://dnd2024.wikidot.com/cleric:life-domain"
              },
              {
                "id": "life-domain-3-life-domain-spells",
                "name": "Life Domain Spells",
                "description": "Their connection to this divine domain ensures they always have certain spells ready. When they reach a Cleric level specified in the Life Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:life-domain"
              },
              {
                "id": "life-domain-3-preserve-life",
                "name": "Preserve Life",
                "description": "As a Magic action, they present their Holy Symbol and expend a use of their Channel Divinity to evoke healing energy that can restore a number of Hit Points equal to five times their Cleric level. Choose Bloodied creatures within 30 feet of themselves (which can include they), and divide those Hit Points among them. This feature can restore a creature to no more than half its Hit Point maximum.",
                "source": "http://dnd2024.wikidot.com/cleric:life-domain"
              }
            ],
            "6": [
              {
                "id": "life-domain-6-blessed-healer",
                "name": "Blessed Healer",
                "description": "The healing spells they cast on others heal they as well. Immediately after they cast a spell with a spell slot that restores Hit Points to one or more creatures other than themselves, they regain Hit Points equal to 2 plus the spell slot’s level.",
                "source": "http://dnd2024.wikidot.com/cleric:life-domain"
              }
            ],
            "17": [
              {
                "id": "life-domain-17-supreme-healing",
                "name": "Supreme Healing",
                "description": "When they would normally roll one or more dice to restore Hit Points to a creature with a spell or Channel Divinity, don’t roll those dice for the healing; instead use the highest number possible for each die. For example, instead of restoring 2d6 Hit Points to a creature with a spell, they restore 12.",
                "source": "http://dnd2024.wikidot.com/cleric:life-domain"
              }
            ]
          }
        },
        {
          "id": "cleric-light-domain",
          "name": "Light Domain",
          "description": "The Light Domain emphasizes the divine power to bring about blazing fire and revelation. Clerics who wield this power are enlightened souls infused with radiance and the power of their deities’ discerning vision, charged with chasing away lies and burning away darkness.",
          "levelFeatures": {
            "3": [
              {
                "id": "light-domain-3-light-domain-spells",
                "name": "Light Domain Spells",
                "description": "Their connection to this divine domain ensures they always have certain spells ready. When they reach a Cleric level specified in the Light Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:light-domain"
              },
              {
                "id": "light-domain-3-radiance-of-the-dawn",
                "name": "Radiance of the Dawn",
                "description": "As a Magic action, they present their Holy Symbol and expend a use of their Channel Divinity to emit a flash of light in a 30-foot Emanation originating from themselves. Any magical Darkness—such as that created by the Darkness spell—in that area is dispelled. Additionally, each creature of their choice in that area must make a Constitution saving throw, taking Radiant damage equal to 2d10 plus their Cleric level on a failed save or half as much damage on a successful one.",
                "source": "http://dnd2024.wikidot.com/cleric:light-domain"
              },
              {
                "id": "light-domain-3-warding-flare",
                "name": "Warding Flare",
                "description": "When a creature that they can see within 30 feet of themselves makes an attack roll, they can take a Reaction to impose Disadvantage on the attack roll, causing light to flare before it hits or misses. They can use this feature a number of times equal to their Wisdom modifier (minimum of once). They regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/cleric:light-domain"
              }
            ],
            "6": [
              {
                "id": "light-domain-6-improved-warding-flare",
                "name": "Improved Warding Flare",
                "description": "They regain all expended uses of their Warding Flare when they finish a Short or Long Rest. In addition, whenever they use Warding Flare, they can give the target of the triggering attack a number of Temporary Hit Points equal to 2d6 plus their Wisdom modifier.",
                "source": "http://dnd2024.wikidot.com/cleric:light-domain"
              }
            ],
            "17": [
              {
                "id": "light-domain-17-corona-of-light",
                "name": "Corona of Light",
                "description": "As a Magic action, they cause themselves to emit an aura of sunlight that lasts for 1 minute or until they dismiss it (no action required). They emit Bright Light in a 60-foot radius and Dim Light for an additional 30 feet. their enemies in the Bright Light have Disadvantage on saving throws against their Radiance of the Dawn and any spell that deals Fire or Radiant damage. They can use this feature a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they…",
                "source": "http://dnd2024.wikidot.com/cleric:light-domain"
              }
            ]
          }
        },
        {
          "id": "cleric-trickery-domain",
          "name": "Trickery Domain",
          "description": "The Trickery Domain offers magic of deception, illusion, and stealth. Clerics who wield this magic are a disruptive force in the world, puncturing pride, mocking tyrants, freeing captives, and flouting hollow traditions. They prefer subterfuge and pranks to direct confrontation.",
          "levelFeatures": {
            "3": [
              {
                "id": "trickery-domain-3-blessing-of-the-trickster",
                "name": "Blessing of the Trickster",
                "description": "As a Magic action, they can choose themselves or a willing creature within 30 feet of themselves to have Advantage on Dexterity (Stealth) checks. This blessing lasts until they finish a Long Rest or they use this feature again.",
                "source": "http://dnd2024.wikidot.com/cleric:trickery-domain"
              },
              {
                "id": "trickery-domain-3-trickery-domain-spells",
                "name": "Trickery Domain Spells",
                "description": "Their connection to this divine domain ensures they always have certain spells ready. When they reach a Cleric level specified in the Trickery Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:trickery-domain"
              },
              {
                "id": "trickery-domain-3-invoke-duplicity",
                "name": "Invoke Duplicity",
                "description": "As a Bonus Action, they can expend one use of their Channel Divinity to create a perfect visual illusion of themselves in an unoccupied space they can see within 30 feet of themselves. The illusion is intangible and doesn’t occupy its space. It lasts for 1 minute, but it ends early if they dismiss it (no action required) or have the Incapacitated condition.",
                "source": "http://dnd2024.wikidot.com/cleric:trickery-domain"
              }
            ],
            "6": [
              {
                "id": "trickery-domain-6-tricksters-transposition",
                "name": "Trickster’s Transposition",
                "description": "Whenever they take the Bonus Action to create or move the illusion of their Invoke Duplicity, they can teleport, swapping places with the illusion.",
                "source": "http://dnd2024.wikidot.com/cleric:trickery-domain"
              }
            ],
            "17": [
              {
                "id": "trickery-domain-17-improved-duplicity",
                "name": "Improved Duplicity",
                "description": "The illusion of their Invoke Duplicity has grown more powerful in the following ways. Shared Distraction. When they and their allies make attack rolls against a creature within 5 feet of the illusion, the attack rolls have Advantage.",
                "source": "http://dnd2024.wikidot.com/cleric:trickery-domain"
              }
            ]
          }
        },
        {
          "id": "cleric-war-domain",
          "name": "War Domain",
          "description": "War has many manifestations. It can make heroes of ordinary people. It can be desperate and horrific, with acts of cruelty and cowardice eclipsing instances of excellence and courage.",
          "levelFeatures": {
            "3": [
              {
                "id": "war-domain-3-guided-strike",
                "name": "Guided Strike",
                "description": "When they or a creature within 30 feet of them misses with an attack roll, they can expend one use of their Channel Divinity and give that roll a +10 bonus, potentially causing it to hit. When they use this feature to benefit another creature’s attack roll, they must take a Reaction to do so.",
                "source": "http://dnd2024.wikidot.com/cleric:war-domain"
              },
              {
                "id": "war-domain-3-war-domain-spells",
                "name": "War Domain Spells",
                "description": "Their connection to this divine domain ensures they always have certain spells ready. When they reach a Cleric level specified in the War Domain Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/cleric:war-domain"
              },
              {
                "id": "war-domain-3-war-priest",
                "name": "War Priest",
                "description": "As a Bonus Action, they can make one attack with a weapon or an Unarmed Strike. They can use this Bonus Action a number of times equal to their Wisdom modifier (minimum of once). They regain all expended uses when they finish a Short or Long Rest.",
                "source": "http://dnd2024.wikidot.com/cleric:war-domain"
              }
            ],
            "6": [
              {
                "id": "war-domain-6-war-gods-blessing",
                "name": "War God’s Blessing",
                "description": "They can expend a use of their Channel Divinity to cast Shield of Faith or Spiritual Weapon rather than expending a spell slot. When they cast either spell in this way, the spell doesn’t require Concentration. Instead the spell lasts for 1 minute, but it ends early if they cast that spell again, have the Incapacitated condition, or die.",
                "source": "http://dnd2024.wikidot.com/cleric:war-domain"
              }
            ],
            "17": [
              {
                "id": "war-domain-17-avatar-of-battle",
                "name": "Avatar of Battle",
                "description": "They gain Resistance to Bludgeoning, Piercing, and Slashing damage.",
                "source": "http://dnd2024.wikidot.com/cleric:war-domain"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "spirit",
        "charisma"
      ]
    },
    {
      "id": "druid",
      "name": "Druid",
      "hitDie": 8,
      "primaryAbility": "spirit",
      "description": "Druids belong to ancient orders that call on the forces of nature. Harnessing the magic of animals, plants, and the four elements, Druids heal, transform into animals, and wield elemental destruction.",
      "levelFeatures": {
        "1": [
          {
            "id": "druid-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned to cast spells through studying the mystical forces of nature. See chapter 7 for the rules on spellcasting. The information below details how they use those rules with Druid spells, which appear on the Druid spell list later in the class’s description.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          },
          {
            "id": "druid-1-druidic",
            "name": "Druidic",
            "description": "They know Druidic, the secret language of Druids. While learning this ancient tongue, they also unlocked the magic of communicating with animals; they always have the Speak with Animals spell prepared. They can use Druidic to leave hidden messages. They and others who know Druidic automatically spot such a message. Others spot the message’s presence with a successful DC 15 Intelligence (Investigation) check but can’t decipher it without magic.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          },
          {
            "id": "druid-1-primal-order",
            "name": "Primal Order",
            "description": "They have dedicated themselves to one of the following sacred roles of their choice. Magician. They know one extra cantrip from the Druid spell list. In addition, their mystical connection to nature gives they a bonus to their Intelligence (Arcana or Nature) checks.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "2": [
          {
            "id": "druid-2-wild-shape",
            "name": "Wild Shape",
            "description": "The power of nature allows they to assume the form of an animal. As a Bonus Action, they shape-shift into a Beast form that they have learned for this feature (see “Known Forms” below). They stay in that form for a number of hours equal to half their Druid level or until they use Wild Shape again, have the Incapacitated condition, or die. They can also leave the form early as a Bonus Action. Number of Uses. They can use Wild Shape twice. They regain one expended use when they finish a Short Rest, and they regain…",
            "source": "http://dnd2024.wikidot.com/druid:main"
          },
          {
            "id": "druid-2-wild-companion",
            "name": "Wild Companion",
            "description": "They can summon a nature spirit that assumes an animal form to aid they. As a Magic action, they can expend a spell slot or a use of Wild Shape to cast the Find Familiar spell without Material components. When they cast the spell in this way, the familiar is Fey and disappears when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "3": [
          {
            "id": "druid-3-druid-subclass",
            "name": "Druid Subclass",
            "description": "They gain a Druid subclass of their choice. The Circle of the Land, Circle of the Moon, Circle of the Sea, and Circle of the Stars subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Druid levels.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "4": [
          {
            "id": "druid-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Druid levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "5": [
          {
            "id": "druid-5-wild-resurgence",
            "name": "Wild Resurgence",
            "description": "Once on each of their turns, if they have no uses of Wild Shape left, they can give themselves one use by expending a spell slot (no action required). In addition, they can expend one use of Wild Shape (no action required) to give themselves a level 1 spell slot, but they can’t do so again until they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "6": [
          {
            "id": "druid-6-subclass-feature",
            "name": "Subclass Feature",
            "description": "At level 6, Druid characters gain Subclass Feature.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "7": [
          {
            "id": "druid-7-elemental-fury",
            "name": "Elemental Fury",
            "description": "The might of the elements flows through they. They gain one of the following options of their choice. Potent Spellcasting. Add their Wisdom modifier to the damage they deal with any Druid cantrip.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "8": [
          {
            "id": "druid-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Druid characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "10": [
          {
            "id": "druid-10-subclass-feature",
            "name": "Subclass Feature",
            "description": "At level 10, Druid characters gain Subclass Feature.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "12": [
          {
            "id": "druid-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Druid characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "14": [
          {
            "id": "druid-14-subclass-feature",
            "name": "Subclass Feature",
            "description": "At level 14, Druid characters gain Subclass Feature.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "15": [
          {
            "id": "druid-15-improved-elemental-fury",
            "name": "Improved Elemental Fury",
            "description": "The option they chose for Elemental Fury grows more powerful, as detailed below. Potent Spellcasting. When they cast a Druid cantrip with a range of 10 feet or greater, the spell’s range increases by 300 feet.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "16": [
          {
            "id": "druid-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Druid characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "18": [
          {
            "id": "druid-18-beast-spells",
            "name": "Beast Spells",
            "description": "While using Wild Shape, they can cast spells in Beast form, except for any spell that has a Material component with a cost specified or that consumes its Material component.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "19": [
          {
            "id": "druid-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Dimensional Travel is recommended.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ],
        "20": [
          {
            "id": "druid-20-archdruid",
            "name": "Archdruid",
            "description": "The vitality of nature constantly blooms within them, granting they the following benefits. Evergreen Wild Shape. Whenever they roll Initiative and have no uses of Wild Shape left, they regain one expended use of it.",
            "source": "http://dnd2024.wikidot.com/druid:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "druid-circle-of-the-land",
          "name": "Circle of the Land",
          "description": "The Circle of the Land comprises mystics and sages who safeguard ancient knowledge and rites. These Druids meet within sacred circles of trees or standing stones to whisper primal secrets in Druidic. The circle’s wisest members preside as the chief priests of their communities.",
          "levelFeatures": {
            "3": [
              {
                "id": "circle-of-the-land-3-circle-of-the-land-spells",
                "name": "Circle of the Land Spells",
                "description": "Whenever they finish a Long Rest, choose one type of land: arid, polar, temperate, or tropical. Consult the table below that corresponds to the chosen type; they have the spells listed for their Druid level and lower prepared. Arid Land Druid Level Circle Spells 3 Blur, Burning Hands, Fire Bolt 5 Fireball 7 Blight 9 Wall of Stone Polar Land Druid Level Circle Spells 3 Fog Cloud, Hold Person, Ray of Frost 5 Sleet Storm 7 Ice Storm 9 Cone of Cold Temperate Land Druid Level Circle Spells 3 Misty Step, Shocking…",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-land"
              },
              {
                "id": "circle-of-the-land-3-lands-aid",
                "name": "Land’s Aid",
                "description": "As a Magic action, they can expend a use of their Wild Shape and choose a point within 60 feet of themselves. Vitality-giving flowers and life-draining thorns appear for a moment in a 10-foot-radius Sphere centered on that point. Each creature of their choice in the Sphere must make a Constitution saving throw against their spell save DC, taking 2d6 Necrotic damage on a failed save or half as much damage on a successful one.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-land"
              }
            ],
            "6": [
              {
                "id": "circle-of-the-land-6-natural-recovery",
                "name": "Natural Recovery",
                "description": "They can cast one of the level 1+ spells that they have prepared from their Circle Spells feature without expending a spell slot, and they must finish a Long Rest before they do so again. In addition, when they finish a Short Rest, they can choose expended spell slots to recover. The spell slots can have a combined level that is equal to or less than half their Druid level (round up), and none of them can be level 6+.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-land"
              }
            ],
            "10": [
              {
                "id": "circle-of-the-land-10-natures-ward",
                "name": "Nature’s Ward",
                "description": "They are immune to the Poisoned condition, and they have Resistance to a damage type associated with their current land choice in the Circle Spells feature, as shown in the Nature’s Ward table. Nature's Ward Land Type Resistance Arid Fire Polar Cold Temperate Lightning Tropical Poison",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-land"
              }
            ],
            "14": [
              {
                "id": "circle-of-the-land-14-natures-sanctuary",
                "name": "Nature’s Sanctuary",
                "description": "As a Magic action, they can expend a use of their Wild Shape and cause spectral trees and vines to appear in a 15-foot Cube on the ground within 120 feet of themselves. They last there for 1 minute or until they have the Incapacitated condition or die. They and their allies have Half Cover while in that area, and their allies gain the current Resistance of their Nature’s Ward while there. As a Bonus Action, they can move the Cube up to 60 feet to ground within 120 feet of themselves.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-land"
              }
            ]
          }
        },
        {
          "id": "druid-circle-of-the-moon",
          "name": "Circle of the Moon",
          "description": "Druids of the Circle of the Moon draw on lunar magic to transform themselves. Their order gathers under the moon to share news and perform rituals.",
          "levelFeatures": {
            "3": [
              {
                "id": "circle-of-the-moon-3-circle-forms",
                "name": "Circle Forms",
                "description": "They can channel lunar magic when they assume a Wild Shape form, granting they the benefits below. Challenge Rating. The maximum Challenge Rating for the form equals their Druid level divided by 3 (round down).",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-moon"
              },
              {
                "id": "circle-of-the-moon-3-circle-of-the-moon-spells",
                "name": "Circle of the Moon Spells",
                "description": "When they reach a Druid level specified in the Circle of the Moon Spells table, they thereafter always have the listed spells prepared. In addition, they can cast the spells from this feature while they are in a Wild Shape form. Circle of the Moon Spells Druid Level Prepared Spells 3 Cure Wounds, Moonbeam, Starry Wisp 5 Conjure Animals 7 Fount of Moonlight 9 Mass Cure Wounds",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-moon"
              }
            ],
            "6": [
              {
                "id": "circle-of-the-moon-6-improved-circle-forms",
                "name": "Improved Circle Forms",
                "description": "While in a Wild Shape form, they gain the following benefits. Lunar Radiance. Each of their attacks in a Wild Shape form can deal its normal damage type or Radiant damage. They make this choice each time they hit with those attacks.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-moon"
              }
            ],
            "10": [
              {
                "id": "circle-of-the-moon-10-moonlight-step",
                "name": "Moonlight Step",
                "description": "They magically transport themselves, reappearing amid a burst of moonlight. As a Bonus Action, they teleport up to 30 feet to an unoccupied space they can see, and they have Advantage on the next attack roll they make before the end of this turn. They can use this feature a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest. They can also regain uses by expending a level 2+ spell slot for each use they want to restore (no action…",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-moon"
              }
            ],
            "14": [
              {
                "id": "circle-of-the-moon-14-lunar-form",
                "name": "Lunar Form",
                "description": "The power of the moon suffuses they, granting they the following benefits. Improved Lunar Radiance. Once per turn, they can deal an extra 2d10 Radiant damage to a target they hit with a Wild Shape form’s attack.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-moon"
              }
            ]
          }
        },
        {
          "id": "druid-circle-of-the-sea",
          "name": "Circle of the Sea",
          "description": "Druids of the Circle of the Sea draw on the tempestuous forces of oceans and storms. Some view themselves as embodiments of nature’s wrath, seeking vengeance against those who despoil nature. Others seek mystical unity with nature by attuning themselves to the ebb and flow of the tides, following the rush of currents and waves and listening to the inscrutable whispers and roars of the winds.",
          "levelFeatures": {
            "3": [
              {
                "id": "circle-of-the-sea-3-circle-of-the-sea-spells",
                "name": "Circle of the Sea Spells",
                "description": "When they reach a Druid level specified in the Circle of the Sea Spells table, they thereafter always have the listed spells prepared. Circle of the Sea Spells Druid Level Prepared Spells 3 Fog Cloud, Gust of Wind, Ray of Frost, Thunderwave 5 Lightning Bolt, Water Breathing 7 Control Water, Ice Storm 9 Conjure Elemental, Hold Monster",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-sea"
              },
              {
                "id": "circle-of-the-sea-3-wrath-of-the-sea",
                "name": "Wrath of the Sea",
                "description": "As a Bonus Action, they can expend a use of their Wild Shape to manifest a 5-foot Emanation that takes the form of ocean spray that surrounds they for 10 minutes. It ends early if they dismiss it (no action required), manifest it again, or have the Incapacitated condition. When they manifest the Emanation and as a Bonus Action on their subsequent turns, they can choose another creature they can see in the Emanation.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-sea"
              }
            ],
            "6": [
              {
                "id": "circle-of-the-sea-6-aquatic-affinity",
                "name": "Aquatic Affinity",
                "description": "The size of the Emanation created by their Wrath of the Sea increases to 10 feet. In addition, they gain a Swim Speed equal to their Speed.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-sea"
              }
            ],
            "10": [
              {
                "id": "circle-of-the-sea-10-stormborn",
                "name": "Stormborn",
                "description": "Their Wrath of the Sea confers two more benefits while active, as detailed below. Flight. They gain a Fly Speed equal to their Speed. Resistance. They have Resistance to Cold, Lightning, and Thunder damage.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-sea"
              }
            ],
            "14": [
              {
                "id": "circle-of-the-sea-14-oceanic-gift",
                "name": "Oceanic Gift",
                "description": "Instead of manifesting the Emanation of Wrath of the Sea around themselves, they can manifest it around one willing creature within 60 feet of themselves. That creature gains all the benefits of the Emanation and uses their spell save DC and Wisdom modifier for it. In addition, they can manifest the Emanation around both the other creature and themselves if they expend two uses of their Wild Shape instead of one when manifesting it.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-sea"
              }
            ]
          }
        },
        {
          "id": "druid-circle-of-the-stars",
          "name": "Circle of the Stars",
          "description": "The Circle of the Stars has tracked heavenly patterns since time immemorial, discovering secrets hidden amid the constellations. By understanding these secrets, the Druids of this circle seek to harness the powers of the cosmos.",
          "levelFeatures": {
            "3": [
              {
                "id": "circle-of-the-stars-3-star-map",
                "name": "Star Map",
                "description": "They have created a star chart as part of their heavenly studies. It is a Tiny object, and they can use it as a Spellcasting Focus for their Druid spells. They determine its form by rolling on the Star Map table or by choosing one. While holding the map, they have the Guidance and Guiding Bolt spells prepared, and they can cast Guiding Bolt without expending a spell slot. They can cast it in that way a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they…",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-stars"
              },
              {
                "id": "circle-of-the-stars-3-starry-form",
                "name": "Starry Form",
                "description": "As a Bonus Action, they can expend a use of their Wild Shape feature to take on a starry form rather than shape-shifting. While in their starry form, they retain their game statistics, but their body becomes luminous, their joints glimmer like stars, and glowing lines connect them as on a star chart. This form sheds Bright Light in a 10-foot radius and Dim Light for an additional 10 feet.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-stars"
              }
            ],
            "6": [
              {
                "id": "circle-of-the-stars-6-cosmic-omen",
                "name": "Cosmic Omen",
                "description": "Whenever they finish a Long Rest, they can consult their Star Map for omens and roll a die. Until they finish their next Long Rest, they gain access to a special Reaction based on whether they rolled an even or an odd number on the die: Weal (Even). Whenever a creature they can see within 30 feet of them is about to make a D20 Test, they can take a Reaction to roll 1d6 and add the number rolled to the total.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-stars"
              }
            ],
            "10": [
              {
                "id": "circle-of-the-stars-10-twinkling-constellations",
                "name": "Twinkling Constellations",
                "description": "The constellations of their Starry Form improve. The 1d8 of the Archer and the Chalice becomes 2d8, and while the Dragon is active, they have a Fly Speed of 20 feet and can hover. Moreover, at the start of each of their turns while in their Starry Form, they can change which constellation glimmers on their body.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-stars"
              }
            ],
            "14": [
              {
                "id": "circle-of-the-stars-14-full-of-stars",
                "name": "Full of Stars",
                "description": "While in their Starry Form, they become partially incorporeal, giving they Resistance to Bludgeoning, Piercing, and Slashing damage.",
                "source": "http://dnd2024.wikidot.com/druid:circle-of-the-stars"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "intellect",
        "spirit"
      ]
    },
    {
      "id": "fighter",
      "name": "Fighter",
      "hitDie": 10,
      "primaryAbility": "strength",
      "description": "Fighters rule many battlefields. Questing knights, royal champions, elite soldiers, and hardened mercenaries - as Fighters, they all share an unparalleled prowess with weapons and armor. And they are well acquainted with death, both meting it out and defying it.",
      "levelFeatures": {
        "1": [
          {
            "id": "fighter-1-fighting-style",
            "name": "Fighting Style",
            "description": "They gain a Fighting Style feat of their choice (see chapter 5). Defense is recommended. Whenever they gain a Fighter level, they can replace the feat they chose with a different Fighting Style feat.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          },
          {
            "id": "fighter-1-second-wind",
            "name": "Second Wind",
            "description": "They have a limited well of physical and mental stamina that they can draw on. As a Bonus Action, they can use it to regain Hit Points equal to 1d10 plus their Fighter level. They can use this feature twice. They regain one expended use when they finish a Short Rest, and they regain all expended uses when they finish a Long Rest. When they reach certain Fighter levels, they gain more uses of this feature, as shown in the Second Wind column of the Fighter Features table.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          },
          {
            "id": "fighter-1-weapon-mastery",
            "name": "Weapon Mastery",
            "description": "Their training with weapons allows they to use the mastery properties of three kinds of Simple or Martial weapons of their choice. Whenever they finish a Long Rest, they can practice weapon drills and change one of those weapon choices. When they reach certain Fighter levels, they gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Fighter Features table.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "2": [
          {
            "id": "fighter-2-action-surge",
            "name": "Action Surge",
            "description": "They can push themselves beyond their normal limits for a moment. On their turn, they can take one additional action, except the Magic action. Once they use this feature, they can’t do so again until they finish a Short or Long Rest.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          },
          {
            "id": "fighter-2-tactical-mind",
            "name": "Tactical Mind",
            "description": "They have a mind for tactics on and off the battlefield. When they fail an ability check, they can expend a use of their Second Wind to push themselves toward success. Rather than regaining Hit Points, they roll 1d10 and add the number rolled to the ability check, potentially turning it into a success.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "3": [
          {
            "id": "fighter-3-fighter-subclass",
            "name": "Fighter Subclass",
            "description": "They gain a Fighter subclass of their choice. The Battle Master, Champion, Eldritch Knight, and Psi Warrior subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Fighter levels.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "4": [
          {
            "id": "fighter-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Fighter levels 6, 8, 12, 14, and 16.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "5": [
          {
            "id": "fighter-5-extra-attack",
            "name": "Extra Attack",
            "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          },
          {
            "id": "fighter-5-tactical-shift",
            "name": "Tactical Shift",
            "description": "Whenever they activate their Second Wind with a Bonus Action, they can move up to half their Speed without provoking Opportunity Attacks.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "9": [
          {
            "id": "fighter-9-indomitable",
            "name": "Indomitable",
            "description": "If they fail a saving throw, they can reroll it with a bonus equal to their Fighter level. They must use the new roll, and they can’t use this feature again until they finish a Long Rest. They can use this feature twice before a Long Rest starting at level 13 and three times before a Long Rest starting at level 17.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          },
          {
            "id": "fighter-9-tactical-master",
            "name": "Tactical Master",
            "description": "When they attack with a weapon whose mastery property they can use, they can replace that property with the Push, Sap, or Slow property for that attack.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "11": [
          {
            "id": "fighter-11-two-extra-attacks",
            "name": "Two Extra Attacks",
            "description": "They can attack three times instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "13": [
          {
            "id": "fighter-13-studied-attacks",
            "name": "Studied Attacks",
            "description": "They study their opponents and learn from each attack they make. If they make an attack roll against a creature and miss, they have Advantage on their next attack roll against that creature before the end of their next turn.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "19": [
          {
            "id": "fighter-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Combat Prowess is recommended.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ],
        "20": [
          {
            "id": "fighter-20-three-extra-attacks",
            "name": "Three Extra Attacks",
            "description": "They can attack four times instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/fighter:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "fighter-banneret",
          "name": "Banneret",
          "description": "Rally Fellow Heroes with Inspiring Leadership",
          "levelFeatures": {
            "3": [
              {
                "id": "banneret-3-knightly-envoy",
                "name": "Knightly Envoy",
                "description": "They know how to conduct themselves with grace as a noble ambassador. They gain the following benefits. Comprehension. They can cast the Comprehend Languages spell but only as a Ritual. Charisma is their spellcasting ability for it.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              },
              {
                "id": "banneret-3-group-recovery",
                "name": "Group Recovery",
                "description": "When they use their Second Wind to regain Hit Points, they can choose a number of allies within a 30-foot Emanation originating from themselves, up to a number of allies equal to their Charisma modifier (minimum of one). Each of those allies regains Hit Points equal to 1d4 plus their Fighter level. Once they use this ability, they can’t use it again until they finish a Short or Long Rest.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              }
            ],
            "7": [
              {
                "id": "banneret-7-team-tactics",
                "name": "Team Tactics",
                "description": "When they use Group Recovery, each chosen ally has Advantage on D20 Tests until the start of their next turn.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              }
            ],
            "10": [
              {
                "id": "banneret-10-rallying-surge",
                "name": "Rallying Surge",
                "description": "When they use their Action Surge, they can choose allies within a 30-foot Emanation originating from themselves, up to a number of allies equal to their Charisma modifier (minimum of one). Each of those allies can immediately take a Reaction to use one of the following options. Attack.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              }
            ],
            "15": [
              {
                "id": "banneret-15-shared-resilience",
                "name": "Shared Resilience",
                "description": "When an ally they can see within 60 feet of themselves fails a saving throw, they can take a Reaction to expend a use of their Indomitable feature. The ally can immediately reroll the saving throw with a bonus equal to their Fighter level; the ally must use the new roll.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              }
            ],
            "18": [
              {
                "id": "banneret-18-inspiring-commander",
                "name": "Inspiring Commander",
                "description": "Bolstered Rally. The area of effect for both Group Recovery and Rallying Surge is now a 60-foot Emanation. Unshakable Bravery. They have Immunity to the Charmed and Frightened conditions.",
                "source": "http://dnd2024.wikidot.com/fighter:banneret"
              }
            ]
          }
        },
        {
          "id": "fighter-battle-master",
          "name": "Battle Master",
          "description": "Battle Masters are students of the art of battle, learning martial techniques passed down through generations. The most accomplished Battle Masters are well-rounded figures who combine their carefully honed combat skills with academic study in the fields of history, theory, and the arts.",
          "levelFeatures": {
            "3": [
              {
                "id": "battle-master-3-combat-superiority",
                "name": "Combat Superiority",
                "description": "Their experience on the battlefield has refined their fighting techniques. They learn maneuvers that are fueled by special dice called Superiority Dice. Maneuvers. They learn three maneuvers of their choice from the “Maneuver Options” section later in this subclass’s description. Many maneuvers enhance an attack in some way. They can use only one maneuver per attack. They learn two additional maneuvers of their choice when they reach Fighter levels 7, 10, and 15.",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              },
              {
                "id": "battle-master-3-student-of-war",
                "name": "Student of War",
                "description": "They gain proficiency with one type of Artisan’s Tools of their choice, and they gain proficiency in one skill of their choice from the skills available to Fighters at level 1.",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              }
            ],
            "7": [
              {
                "id": "battle-master-7-know-your-enemy",
                "name": "Know Your Enemy",
                "description": "As a Bonus Action, they can discern certain strengths and weaknesses of a creature they can see within 30 feet of themselves; they know whether that creature has any Immunities, Resistances, or Vulnerabilities, and if the creature has any, they know what they are. Once they use this feature, they can’t do so again until they finish a Long Rest. They can also restore a use of the feature by expending one Superiority Die (no action required).",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              }
            ],
            "10": [
              {
                "id": "battle-master-10-improved-combat-superiority",
                "name": "Improved Combat Superiority",
                "description": "Their Superiority Die becomes a d10.",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              }
            ],
            "15": [
              {
                "id": "battle-master-15-relentless",
                "name": "Relentless",
                "description": "Once per turn, when they use a maneuver, they can roll 1d8 and use the number rolled instead of expending a Superiority Die.",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              }
            ],
            "18": [
              {
                "id": "battle-master-18-ultimate-combat-superiority",
                "name": "Ultimate Combat Superiority",
                "description": "Their Superiority Die becomes a d12.",
                "source": "http://dnd2024.wikidot.com/fighter:battle-master"
              }
            ]
          }
        },
        {
          "id": "fighter-champion",
          "name": "Champion",
          "description": "A Champion focuses on the development of martial prowess in a relentless pursuit of victory. Champions combine rigorous training with physical excellence to deal devastating blows, withstand peril, and garner glory. Whether in athletic contests or bloody battle, Champions strive for the crown of the victor.",
          "levelFeatures": {
            "3": [
              {
                "id": "champion-3-improved-critical",
                "name": "Improved Critical",
                "description": "Their attack rolls with weapons and Unarmed Strikes can score a Critical Hit on a roll of 19 or 20 on the d20.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              },
              {
                "id": "champion-3-remarkable-athlete",
                "name": "Remarkable Athlete",
                "description": "Thanks to their athleticism, they have Advantage on Initiative rolls and Strength (Athletics) checks. In addition, immediately after they score a Critical Hit, they can move up to half their Speed without provoking Opportunity Attacks.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              }
            ],
            "7": [
              {
                "id": "champion-7-additional-fighting-style",
                "name": "Additional Fighting Style",
                "description": "They gain another Fighting Style feat of their choice.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              }
            ],
            "10": [
              {
                "id": "champion-10-heroic-warrior",
                "name": "Heroic Warrior",
                "description": "The thrill of battle drives they toward victory. During combat, they can give themselves Heroic Inspiration whenever they start their turn without it.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              }
            ],
            "15": [
              {
                "id": "champion-15-superior-critical",
                "name": "Superior Critical",
                "description": "Their attack rolls with weapons and Unarmed Strikes can now score a Critical Hit on a roll of 18-20 on the d20.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              }
            ],
            "18": [
              {
                "id": "champion-18-survivor",
                "name": "Survivor",
                "description": "They attain the pinnacle of resilience in battle, giving they these benefits. Defy Death. They have Advantage on Death Saving Throws. Moreover, when they roll 18-20 on a Death Saving Throw, they gain the benefit of rolling a 20 on it.",
                "source": "http://dnd2024.wikidot.com/fighter:champion"
              }
            ]
          }
        },
        {
          "id": "fighter-eldritch-knight",
          "name": "Eldritch Knight",
          "description": "Eldritch Knights combine the martial mastery common to all Fighters with a careful study of magic. Their spells both complement and extend their combat skills, providing additional protection to shore up their armor and also allowing them to engage many foes at once with explosive magic.",
          "levelFeatures": {
            "3": [
              {
                "id": "eldritch-knight-3-spellcasting",
                "name": "Spellcasting",
                "description": "They have learned to cast spells. See chapter 7 for the rules on spellcasting. The information below details how they use those rules as an Eldritch Knight.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              },
              {
                "id": "eldritch-knight-3-war-bond",
                "name": "War Bond",
                "description": "They learn a ritual that creates a magical bond between themselves and one weapon. They perform the ritual over the course of 1 hour, which can be done during a Short Rest. The weapon must be within their reach throughout the ritual, at the conclusion of which they touch the weapon and forge the bond. The bond fails if another Fighter is bonded to the weapon or if the weapon is a magic item to which someone else is attuned.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              }
            ],
            "7": [
              {
                "id": "eldritch-knight-7-war-magic",
                "name": "War Magic",
                "description": "When they take the Attack action on their turn, they can replace one of the attacks with a casting of one of their Wizard cantrips that has a casting time of an action.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              }
            ],
            "10": [
              {
                "id": "eldritch-knight-10-eldritch-strike",
                "name": "Eldritch Strike",
                "description": "They learn how to make their weapon strikes undercut a creature’s ability to withstand their spells. When they hit a creature with an attack using a weapon, that creature has Disadvantage on the next saving throw it makes against a spell they cast before the end of their next turn.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              }
            ],
            "15": [
              {
                "id": "eldritch-knight-15-arcane-charge",
                "name": "Arcane Charge",
                "description": "When they use their Action Surge, they can teleport up to 30 feet to an unoccupied space they can see. They can teleport before or after the additional action.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              }
            ],
            "18": [
              {
                "id": "eldritch-knight-18-improved-war-magic",
                "name": "Improved War Magic",
                "description": "When they take the Attack action on their turn, they can replace two of the attacks with a casting of one of their level 1 or level 2 Wizard spells that has a casting time of an action.",
                "source": "http://dnd2024.wikidot.com/fighter:eldritch-knight"
              }
            ]
          }
        },
        {
          "id": "fighter-psi-warrior",
          "name": "Psi Warrior",
          "description": "Psi Warriors awaken the power of their minds to augment their physical might. They harness this psionic power to infuse their weapon strikes, lash out with telekinetic energy, and create barriers of mental force.",
          "levelFeatures": {
            "3": [
              {
                "id": "psi-warrior-3-psionic-power",
                "name": "Psionic Power",
                "description": "They harbor a wellspring of psionic energy within themselves. It is represented by their Psionic Energy Dice, which fuel powers they have from this subclass. The Psi Warrior Energy Dice table shows the die size and number of these dice they have when they reach certain Fighter levels.",
                "source": "http://dnd2024.wikidot.com/fighter:psi-warrior"
              }
            ],
            "7": [
              {
                "id": "psi-warrior-7-telekinetic-adept",
                "name": "Telekinetic Adept",
                "description": "They have mastered new ways to use their telekinetic abilities, detailed below. Psi-Powered Leap. As a Bonus Action, they gain a Fly Speed equal to twice their Speed until the end of the current turn.",
                "source": "http://dnd2024.wikidot.com/fighter:psi-warrior"
              }
            ],
            "10": [
              {
                "id": "psi-warrior-10-guarded-mind",
                "name": "Guarded Mind",
                "description": "They have Resistance to Psychic damage. Moreover, if they start their turn with the Charmed or Frightened condition, they can expend a Psionic Energy Die (no action required) and end every effect on themselves giving they those conditions.",
                "source": "http://dnd2024.wikidot.com/fighter:psi-warrior"
              }
            ],
            "15": [
              {
                "id": "psi-warrior-15-bulwark-of-force",
                "name": "Bulwark of Force",
                "description": "They can shield themselves and others with telekinetic force. As a Bonus Action, they can choose creatures, including themselves, within 30 feet of themselves, up to a number of creatures equal to their Intelligence modifier (minimum of one creature). Each of the chosen creatures has Half Cover for 1 minute or until they have the Incapacitated condition.",
                "source": "http://dnd2024.wikidot.com/fighter:psi-warrior"
              }
            ],
            "18": [
              {
                "id": "psi-warrior-18-telekinetic-master",
                "name": "Telekinetic Master",
                "description": "They always have the telekinesis spell prepared. With this feature, they can cast it without a spell slot or components, and their spellcasting ability for it is Intelligence. On each of their turns while they maintain Concentration on it, including the turn when they cast it, they can make one attack with a weapon as a Bonus Action.",
                "source": "http://dnd2024.wikidot.com/fighter:psi-warrior"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "strength",
        "stamina"
      ]
    },
    {
      "id": "monk",
      "name": "Monk",
      "hitDie": 8,
      "primaryAbility": "agility",
      "description": "Monks use rigorous combat training and mental discipline to align themselves with the multiverse and focus their internal reservoirs of power. Different Monks conceptualize this power in various ways: as breath, energy, life force, essence, or self, for example. Whether channeled as a striking display of martial prowess or as a subtler manifestation of defense and speed, this power infuses all that a Monk does.",
      "levelFeatures": {
        "1": [
          {
            "id": "monk-1-martial-arts",
            "name": "Martial Arts",
            "description": "Their practice of martial arts gives they mastery of combat styles that use their Unarmed Strike and Monk weapons, which are the following: Simple Melee weapons Martial Melee weapons that have the Light property they gain the following benefits while they are unarmed or wielding only Monk weapons and they aren’t wearing armor or wielding a Shield. Bonus Unarmed Strike. They can make an Unarmed Strike as a Bonus Action. Martial Arts Die. They can roll 1d6 in place of the normal damage of their Unarmed Strike or…",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-1-unarmored-defense",
            "name": "Unarmored Defense",
            "description": "While they aren’t wearing armor or wielding a Shield, their base Armor Class equals 10 plus their Dexterity and Wisdom modifiers.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "2": [
          {
            "id": "monk-2-monks-focus",
            "name": "Monk’s Focus",
            "description": "Their focus and martial training allow they to harness a well of extraordinary energy within themselves. This energy is represented by Focus Points. their Monk level determines the number of points they have, as shown in the Focus Points column of the Monk Features table. They can expend these points to enhance or fuel certain Monk features. They start knowing three such features: Flurry of Blows, Patient Defense, and Step of the Wind, each of which is detailed below. When they expend a Focus Point, it is…",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-2-unarmored-movement",
            "name": "Unarmored Movement",
            "description": "Their speed increases by 10 feet while they aren’t wearing armor or wielding a Shield. This bonus increases when they reach certain Monk levels, as shown on the Monk Features table.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-2-uncanny-metabolism",
            "name": "Uncanny Metabolism",
            "description": "When they roll Initiative, they can regain all expended Focus Points. When they do so, roll their Martial Arts die, and regain a number of Hit Points equal to their Monk level plus the number rolled. Once they use this feature, they can’t use it again until they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "3": [
          {
            "id": "monk-3-deflect-attacks",
            "name": "Deflect Attacks",
            "description": "When an attack roll hits they and its damage includes Bludgeoning, Piercing, or Slashing damage, they can take a Reaction to reduce the attack’s total damage against them. The reduction equals 1d10 plus their Dexterity modifier and Monk level. If they reduce the damage to 0, they can expend 1 Focus Point to redirect some of the attack’s force.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-3-monk-subclass",
            "name": "Monk Subclass",
            "description": "They gain a Monk subclass of their choice. The Warrior of Mercy, Warrior of Shadow, Warrior of the Elements, and Warrior of the Open Hand subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Monk levels.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "4": [
          {
            "id": "monk-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Monk levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-4-slow-fall",
            "name": "Slow Fall",
            "description": "They can take a Reaction when they fall to reduce any damage they take from the fall by an amount equal to five times their Monk level.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "5": [
          {
            "id": "monk-5-extra-attack",
            "name": "Extra Attack",
            "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-5-stunning-strike",
            "name": "Stunning Strike",
            "description": "Once per turn when they hit a creature with a Monk weapon or an Unarmed Strike, they can expend 1 Focus Point to attempt a stunning strike. The target must make a Constitution saving throw. On a failed save, the target has the Stunned condition until the start of their next turn.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "6": [
          {
            "id": "monk-6-empowered-strikes",
            "name": "Empowered Strikes",
            "description": "Whenever they deal damage with their Unarmed Strike, it can deal their choice of Force damage or its normal damage type.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "7": [
          {
            "id": "monk-7-evasion",
            "name": "Evasion",
            "description": "When they are subjected to an effect that allows they to make a Dexterity saving throw to take only half damage, they instead take no damage if they succeed on the saving throw and only half damage if they fail. They don’t benefit from this feature if they have the Incapacitated condition.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "9": [
          {
            "id": "monk-9-acrobatic-movement",
            "name": "Acrobatic Movement",
            "description": "While they aren’t wearing armor or wielding a Shield, they gain the ability to move along vertical surfaces and across liquids on their turn without falling during the movement.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "10": [
          {
            "id": "monk-10-heightened-focus",
            "name": "Heightened Focus",
            "description": "Their Flurry of Blows, Patient Defense, and Step of the Wind gain the following benefits. Flurry of Blows. They can expend 1 Focus Point to use Flurry of Blows and make three Unarmed Strikes with it instead of two. Patient Defense.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          },
          {
            "id": "monk-10-self-restoration",
            "name": "Self-Restoration",
            "description": "Through sheer force of will, they can remove one of the following conditions from themselves at the end of each of their turns: Charmed, Frightened, or Poisoned. In addition, forgoing food and drink doesn’t give they levels of Exhaustion.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "13": [
          {
            "id": "monk-13-deflect-energy",
            "name": "Deflect Energy",
            "description": "They can now use their Deflect Attacks feature against attacks that deal any damage type, not just Bludgeoning, Piercing, or Slashing.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "14": [
          {
            "id": "monk-14-disciplined-survivor",
            "name": "Disciplined Survivor",
            "description": "Their physical and mental discipline grant they proficiency in all saving throws. Additionally, whenever they make a saving throw and fail, they can expend 1 Focus Point to reroll it, and they must use the new roll.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "15": [
          {
            "id": "monk-15-perfect-focus",
            "name": "Perfect Focus",
            "description": "When they roll Initiative and don’t use Uncanny Metabolism, they regain expended Focus Points until they have 4 if they have 3 or fewer.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "18": [
          {
            "id": "monk-18-superior-defense",
            "name": "Superior Defense",
            "description": "At the start of their turn, they can expend 3 Focus Points to bolster themselves against harm for 1 minute or until they have the Incapacitated condition. During that time, they have Resistance to all damage except Force damage.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "19": [
          {
            "id": "monk-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Irresistible Offense is recommended.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ],
        "20": [
          {
            "id": "monk-20-body-and-mind",
            "name": "Body and Mind",
            "description": "They have developed their body and mind to new heights. their Dexterity and Wisdom scores increase by 4, to a maximum of 25.",
            "source": "http://dnd2024.wikidot.com/monk:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "monk-warrior-of-mercy",
          "name": "Warrior of Mercy",
          "description": "Warriors of Mercy manipulate the life force of others. These Monks are wandering physicians, but they bring a swift end to their enemies. They often wear masks, presenting themselves as faceless bringers of life and death.",
          "levelFeatures": {
            "3": [
              {
                "id": "warrior-of-mercy-3-hand-of-harm",
                "name": "Hand of Harm",
                "description": "Once per turn when they hit a creature with an Unarmed Strike and deal damage, they can expend 1 Focus Point to deal extra Necrotic damage equal to one roll of their Martial Arts die plus their Wisdom modifier.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              },
              {
                "id": "warrior-of-mercy-3-hand-of-healing",
                "name": "Hand of Healing",
                "description": "As a Magic action, they can expend 1 Focus Point to touch a creature and restore a number of Hit Points equal to a roll of their Martial Arts die plus their Wisdom modifier. When they use their Flurry of Blows, they can replace one of the Unarmed Strikes with a use of this feature without expending a Focus Point for the healing.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              },
              {
                "id": "warrior-of-mercy-3-implements-of-mercy",
                "name": "Implements of Mercy",
                "description": "They gain proficiency in the Insight and Medicine skills and proficiency with the Herbalism Kit.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              }
            ],
            "6": [
              {
                "id": "warrior-of-mercy-6-physicians-touch",
                "name": "Physician’s Touch",
                "description": "Their Hand of Harm and Hand of Healing improve, as detailed below. Hand of Harm. When they use Hand of Harm on a creature, they can also give that creature the Poisoned condition until the end of their next turn.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              }
            ],
            "11": [
              {
                "id": "warrior-of-mercy-11-flurry-of-healing-and-harm",
                "name": "Flurry of Healing and Harm",
                "description": "When they use Flurry of Blows, they can replace each of the Unarmed Strikes with a use of Hand of Healing without expending Focus Points for the healing. In addition, when they make an Unarmed Strike with Flurry of Blows and deal damage, they can use Hand of Harm with that strike without expending a Focus Point for Hand of Harm. They can still use Hand of Harm only once per turn. They can use these benefits a total number of times equal to their Wisdom modifier (minimum of once). They regain all expended uses…",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              }
            ],
            "17": [
              {
                "id": "warrior-of-mercy-17-hand-of-ultimate-mercy",
                "name": "Hand of Ultimate Mercy",
                "description": "Their mastery of life energy opens the door to the ultimate mercy. As a Magic action, they can touch the corpse of a creature that died within the past 24 hours and expend 5 Focus Points. The creature then returns to life with a number of Hit Points equal to 4d10 plus their Wisdom modifier.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-mercy"
              }
            ]
          }
        },
        {
          "id": "monk-warrior-of-shadow",
          "name": "Warrior of Shadow",
          "description": "Harness Shadow Power for Stealth and Subterfuge",
          "levelFeatures": {
            "3": [
              {
                "id": "warrior-of-shadow-3-shadow-arts",
                "name": "Shadow Arts",
                "description": "They have learned to draw on the power of the Shadowfell, gaining the following benefits. Darkness. They can expend 1 Focus Point to cast the Darkness spell without spell components. They can see within the spell’s area when they cast it with this feature. While the spell persists, they can move its area of Darkness to a space within 60 feet of themselves at the start of each of their turns.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-shadow"
              }
            ],
            "6": [
              {
                "id": "warrior-of-shadow-6-shadow-step",
                "name": "Shadow Step",
                "description": "While entirely within Dim Light or Darkness, they can use a Bonus Action to teleport up to 60 feet to an unoccupied space they can see that is also in Dim Light or Darkness. They then have Advantage on the next melee attack they make before the end of the current turn.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-shadow"
              }
            ],
            "11": [
              {
                "id": "warrior-of-shadow-11-improved-shadow-step",
                "name": "Improved Shadow Step",
                "description": "They can draw on their Shadowfell connection to empower their teleportation. When they use their Shadow Step, they can expend 1 Focus Point to remove the requirement that they must start and end in Dim Light or Darkness for that use of the feature. As part of this Bonus Action, they can make an Unarmed Strike immediately after they teleport.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-shadow"
              }
            ],
            "17": [
              {
                "id": "warrior-of-shadow-17-cloak-of-shadows",
                "name": "Cloak of Shadows",
                "description": "As a Magic action while entirely within Dim Light or Darkness, they can expend 3 Focus Points to shroud themselves with shadows for 1 minute, until they have the Incapacitated condition, or until they end their turn in Bright Light. While shrouded by these shadows, they gain the following benefits. Invisibility. They have the Invisible condition.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-shadow"
              }
            ]
          }
        },
        {
          "id": "monk-warrior-of-the-elements",
          "name": "Warrior of the Elements",
          "description": "Warriors of the Elements tap into the power of the Elemental Planes. Harnessing their supernatural focus, these Monks momentarily tame the energy of the Elemental Chaos to empower themselves in and out of battle.",
          "levelFeatures": {
            "3": [
              {
                "id": "warrior-of-the-elements-3-elemental-attunement",
                "name": "Elemental Attunement",
                "description": "At the start of their turn, they can expend 1 Focus Point to imbue themselves with elemental energy. The energy lasts for 10 minutes or until they have the Incapacitated condition. They gain the following benefits while this feature is active. Reach.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-elements"
              },
              {
                "id": "warrior-of-the-elements-3-manipulate-elements",
                "name": "Manipulate Elements",
                "description": "They know the Elementalism spell. Wisdom is their spellcasting ability for it.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-elements"
              }
            ],
            "6": [
              {
                "id": "warrior-of-the-elements-6-elemental-burst",
                "name": "Elemental Burst",
                "description": "As a Magic action, they can expend 2 Focus Points to cause elemental energy to burst in a 20-foot-radius Sphere centered on a point within 120 feet of themselves. Choose a damage type: Acid, Cold, Fire, Lightning, or Thunder. Each creature in the Sphere must make a Dexterity saving throw.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-elements"
              }
            ],
            "11": [
              {
                "id": "warrior-of-the-elements-11-stride-of-the-elements",
                "name": "Stride of the Elements",
                "description": "While their Elemental Attunement is active, they also have a Fly Speed and a Swim Speed equal to their Speed.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-elements"
              }
            ],
            "17": [
              {
                "id": "warrior-of-the-elements-17-elemental-epitome",
                "name": "Elemental Epitome",
                "description": "While their Elemental Attunement is active, they also gain the following benefits. Damage Resistance. They gain Resistance to one of the following damage types of their choice: Acid, Cold, Fire, Lightning, or Thunder. At the start of each of their turns, they can change this choice.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-elements"
              }
            ]
          }
        },
        {
          "id": "monk-warrior-of-the-open-hand",
          "name": "Warrior of the Open Hand",
          "description": "Warriors of the Open Hand are masters of unarmed combat. They learn techniques to push and trip their opponents and manipulate their own energy to protect themselves from harm.",
          "levelFeatures": {
            "3": [
              {
                "id": "warrior-of-the-open-hand-3-open-hand-technique",
                "name": "Open Hand Technique",
                "description": "Whenever they hit a creature with an attack granted by their Flurry of Blows, they can impose one of the following effects on that target. Addle. The target can’t make Opportunity Attacks until the start of its next turn.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-open-hand"
              }
            ],
            "6": [
              {
                "id": "warrior-of-the-open-hand-6-wholeness-of-body",
                "name": "Wholeness of Body",
                "description": "They gain the ability to heal themselves. As a Bonus Action, they can roll their Martial Arts die. They regain a number of Hit Points equal to the number rolled plus their Wisdom modifier (minimum of 1 Hit Point regained). They can use this feature a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-open-hand"
              }
            ],
            "11": [
              {
                "id": "warrior-of-the-open-hand-11-fleet-step",
                "name": "Fleet Step",
                "description": "When they take a Bonus Action other than Step of the Wind, they can also use Step of the Wind immediately after that Bonus Action.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-open-hand"
              }
            ],
            "17": [
              {
                "id": "warrior-of-the-open-hand-17-quivering-palm",
                "name": "Quivering Palm",
                "description": "They gain the ability to set up lethal vibrations in someone’s body. When they hit a creature with an Unarmed Strike, they can expend 4 Focus Points to start these imperceptible vibrations, which last for a number of days equal to their Monk level. The vibrations are harmless unless they take an action to end them.",
                "source": "http://dnd2024.wikidot.com/monk:warrior-of-the-open-hand"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "strength",
        "agility"
      ]
    },
    {
      "id": "paladin",
      "name": "Paladin",
      "hitDie": 10,
      "primaryAbility": "strength",
      "description": "Paladins are united by their oaths to stand against the forces of annihilation and corruption. Whether sworn before a god's altar, in a sacred glade before nature spirits or in a moment of desperation and grief with the dead as the only witness, a Paladin's oath is a powerful bond. It is a source of power that turns a devout warrior into a blessed champion.",
      "levelFeatures": {
        "1": [
          {
            "id": "paladin-1-lay-on-hands",
            "name": "Lay On Hands",
            "description": "Their blessed touch can heal wounds. They have a pool of healing power that replenishes when they finish a Long Rest. With that pool, they can restore a total number of Hit Points equal to five times their Paladin level. As a Bonus Action, they can touch a creature (which could be themselves) and draw power from the pool of healing to restore a number of Hit Points to that creature, up to the maximum amount remaining in the pool. They can also expend 5 Hit Points from the pool of healing power to remove the…",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          },
          {
            "id": "paladin-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned to cast spells through prayer and meditation. See Chapter 7 for the rules on Spellcasting. The Information below details how they use those rules with Paladin spells, which appear in the Paladin spell list later in the class's description.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          },
          {
            "id": "paladin-1-weapon-mastery",
            "name": "Weapon Mastery",
            "description": "Their training with weapons allows they to use the mastery properties of two kinds of weapons of their choice with which they have proficiency, such as Longswords and Javelins. Whenever they finish a Long Rest, they can change the kinds of weapons they chose. For Example, they could switch to using the mastery properties of Halberds and Flails.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "2": [
          {
            "id": "paladin-2-fighting-style",
            "name": "Fighting Style",
            "description": "They gain a Fighting Style feat of their choice (see chapter 5). Instead of choosing one of those feats, they can choose the option below. Blessed Warrior. They learn two Cleric cantrips of their choice (See the Cleric class's section for a list of Cleric spells).",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          },
          {
            "id": "paladin-2-paladin-s-smite",
            "name": "Paladin's Smite",
            "description": "They always have the Divine Smite spell prepared. They can cast it without expending a spell slot, but they must finish a Long Rest before they can cast it this way again.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "3": [
          {
            "id": "paladin-3-channel-divinity",
            "name": "Channel Divinity",
            "description": "They can channel divine energy directly from the Outer Planes, using it to fuel magical effects. They start with one such effect: Divine Sense, which is described below. Other Paladin features give additional Channel Divinity effect options. Each time they use this class's Channel Divinity, they choose which effect from this class to create. They can use this class's Channel Divinity twice. They regain one of its expended uses when they finish a Short Rest, and they regain all expended uses when they finish a…",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          },
          {
            "id": "paladin-3-paladin-subclass",
            "name": "Paladin Subclass",
            "description": "They gain a Paladin Subclass of their choice. The Oath of Devotion, Oath of Glory, Oath of the Ancients and Oath of Vengeance subclasses are detailed after this class's description. A Subclass is a specialization that grants they features at certain Paladin levels.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "4": [
          {
            "id": "paladin-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Paladin levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "5": [
          {
            "id": "paladin-5-extra-attack",
            "name": "Extra Attack",
            "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          },
          {
            "id": "paladin-5-faithful-steed",
            "name": "Faithful Steed",
            "description": "They can call on the aid of an otherworldly steed. They always have the Find Steed spell prepared. They can also cast the spell once without expending a spell slot, and they regain their ability to do so when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "6": [
          {
            "id": "paladin-6-aura-of-protection",
            "name": "Aura of Protection",
            "description": "They radiate a protective, unseeable aura in a 10-foot Emanation that originates from them. The aura is inactive while they have the Incapacitated condition. They and their allies in the aura gain a bonus to saving throws equal to their Charisma modifier (minimum bonus of +1). If another Paladin is present, a creature can benefit from only one Aura of Protection at a time; the creature chooses which aura while in them.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "9": [
          {
            "id": "paladin-9-abjure-foes",
            "name": "Abjure Foes",
            "description": "As a Magic action, they can expend one use of this class's Channel Divinity to overwhelm foes with awe. As they present their Holy Symbol or weapon, they can target a number of creatures equal to their Charisma modifier (minimum of one creature) that they can see within 60 feet of themselves. Each target must succeed on a Wisdom saving throw or have the Frightened condition for 1 minute or until it takes any damage.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "10": [
          {
            "id": "paladin-10-aura-of-courage",
            "name": "Aura of Courage",
            "description": "They and their allies have Immunity to the Frightened condition while in their Aura of Protection. If a Frightened ally enters the aura, that condition has no effect on that ally while there.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "11": [
          {
            "id": "paladin-11-radiant-strikes",
            "name": "Radiant Strikes",
            "description": "Their strikes now carry supernatural power. When they hit a target with an attack roll using a Melee weapon or an Unarmed Strike, the target takes an extra 1d8 Radiant damage.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "14": [
          {
            "id": "paladin-14-restoring-touch",
            "name": "Restoring Touch",
            "description": "When they use Lay On Hands on a creature, they can also remove one or more of the following conditions from the creature: Blinded, Charmed, Deafened, Frightened, Paralyzed, or Stunned. They must expend 5 Hit Points from the healing pool of Lay On Hands for each of these conditions they remove; those points don't also restore Hit Points to the creature.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "18": [
          {
            "id": "paladin-18-aura-expansion",
            "name": "Aura Expansion",
            "description": "Their Aura of Protection is now a 30-foot Emanation.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ],
        "19": [
          {
            "id": "paladin-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Truesight is recommended.",
            "source": "http://dnd2024.wikidot.com/paladin:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "paladin-oath-of-devotion",
          "name": "Oath of Devotion",
          "description": "The Oath of Devotion binds Paladins to the ideals of Justice and Order. These Paladins meet the archetype of the knight in shining armor. They hold themselves to the highest standards of conduct, and some - for better or worse - hold the rest of the world to the same standards.",
          "levelFeatures": {
            "3": [
              {
                "id": "oath-of-devotion-3-oath-of-devotion-spells",
                "name": "Oath of Devotion Spells",
                "description": "The magic of their oath ensures they always have certain spells ready; when they reach a Paladin level specified in the Oath of Devotion Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-devotion"
              },
              {
                "id": "oath-of-devotion-3-sacred-weapon",
                "name": "Sacred Weapon",
                "description": "When they take the Attack action, they can expend one use of their Channel Divinity to imbue one Melee weapon that they are holding with positive energy. For 10 minutes or until they use this feature again, they add their Charisma modifier to attack rolls they make with that weapon (minimum bonus of +1), and each time they hit with it, they cause it to deal its normal damage type or Radiant Damage. The weapon also emits Bright Light in a 20-foot radius and Dim Light 20 feet beyond that. They can end this effect…",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-devotion"
              }
            ],
            "7": [
              {
                "id": "oath-of-devotion-7-aura-of-devotion",
                "name": "Aura of Devotion",
                "description": "They and their allies have Immunity to the Charmed condition while in their Aura of Protection. If a Charmed ally enters the aura, that condition has no effect on that ally while there.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-devotion"
              }
            ],
            "15": [
              {
                "id": "oath-of-devotion-15-smite-of-protection",
                "name": "Smite of Protection",
                "description": "Their magical smite now radiates protective energy. Whenever they cast Divine Smite, they and their allies have Half Cover while in their Aura of Protection. The aura has this benefit until the start of their next turn.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-devotion"
              }
            ],
            "20": [
              {
                "id": "oath-of-devotion-20-holy-nimbus",
                "name": "Holy Nimbus",
                "description": "As a Bonus Action, they can imbue their Aura of Protection with holy power, granting the benefits below for 10 minutes or until they end them (no action required). Once they use this feature, they can't use it again until they finish a Long Rest. They can also restore their use of it by expending a level 5 spell slot (no action required). Holy Ward. They have Advantage on any saving throw they are forced to make by a Fiend or an Undead.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-devotion"
              }
            ]
          }
        },
        {
          "id": "paladin-oath-of-glory",
          "name": "Oath of Glory",
          "description": "Paladins who take the Oath of Glory believe they and their companions are destined to achieve glory through deeds of heroism. They train diligently and encourage their companions, so that they're all ready when destiny calls.",
          "levelFeatures": {
            "3": [
              {
                "id": "oath-of-glory-3-inspiring-smite",
                "name": "Inspiring Smite",
                "description": "Immediately after they cast Divine Smite, they can expend one use of their Channel Divinity and distribute Temporary Hit Points to creatures of their choice within 30 feet of themselves, which can include they. The total number of Temporary Hit Points equals 2d8 plus their Paladin level, divided among the chosen creatures however they like.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              },
              {
                "id": "oath-of-glory-3-oath-of-glory-spells",
                "name": "Oath of Glory Spells.",
                "description": "The magic of their oath ensures they always have certain spells ready; when they reach a Paladin level specified in the Oath of Glory Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              },
              {
                "id": "oath-of-glory-3-peerless-athlete",
                "name": "Peerless Athlete",
                "description": "As a Bonus Action, they can expend one use of their Channel Divinity to augment their athleticism. For 1 hour, they have Advantage on Strength (Athletics) and Dexterity (Acrobatics) checks, and the distance of their Long and High Jumps increases by 10 feet (this extra distance costs movement as normal).",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              }
            ],
            "7": [
              {
                "id": "oath-of-glory-7-aura-of-alacrity",
                "name": "Aura of Alacrity",
                "description": "Their Speed increases by 10 feet. In addition, whenever an ally enters their Aura of Protection for the first time on a turn or starts their turn there, the ally's Speed increases by 10 feet until the end of their next turn.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              }
            ],
            "15": [
              {
                "id": "oath-of-glory-15-glorious-defense",
                "name": "Glorious Defense",
                "description": "They can turn defense into a sudden strike. When they or another creature they can see within 10 feet of them is hit by an attack roll, they can take a Reaction to grant a bonus to the target's AC against that attack, potentially causing it to miss. The bonus equals their Charisma modifier (minimum of +1).",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              }
            ],
            "20": [
              {
                "id": "oath-of-glory-20-living-legend",
                "name": "Living Legend",
                "description": "They can empower themselves with the legends - whether true or exaggerated - of their great deeds. As a Bonus Action, they gain the benefits below for 10 minutes. Once they use this feature, they can't use it again until they finish a Long Rest. They can also restore their use of it by expending a level 5 spell slot (no action required).",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-glory"
              }
            ]
          }
        },
        {
          "id": "paladin-oath-of-the-ancients",
          "name": "Oath of the Ancients",
          "description": "The Oath of the Ancients is as old as the first elves. Paladins who swear this oath cherish the light; they love the beautiful and life-giving things of the world more than any principles of honor, courage and justice. They often adorn their armor and clothing with images of growing things - leaves, antlers, or flowers - to reflect their commitment to preserving life and light.",
          "levelFeatures": {
            "3": [
              {
                "id": "oath-of-the-ancients-3-nature-s-wrath",
                "name": "Nature's Wrath",
                "description": "As a Magic action, they can expend one of their uses of Channel Divinity to conjure spectral vines around nearby creatures. Each creature of their choice that they can see within 15 feet of themselves must succeed on a Strength saving throw or have the Restrained condition for 1 minute. A Restrained creature repeats the save at the end of each of its turns, ending the effect on a success.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-ancients"
              },
              {
                "id": "oath-of-the-ancients-3-oath-of-the-ancients-spells",
                "name": "Oath of the Ancients Spells",
                "description": "The magic of their oath ensures they always have certain spells ready; when they reach a Paladin level specified in the Oath of the Ancients Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-ancients"
              }
            ],
            "7": [
              {
                "id": "oath-of-the-ancients-7-aura-of-warding",
                "name": "Aura of Warding",
                "description": "Ancient magic lies so heavily upon they that it forms an eldritch ward, blunting energy from beyond the Material Plane; they and their allies have Resistance to Necrotic, Psychic and Radiant damage while in their Aura of Protection.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-ancients"
              }
            ],
            "15": [
              {
                "id": "oath-of-the-ancients-15-undying-sentinel",
                "name": "Undying Sentinel",
                "description": "When they are reduced to 0 Hit Points and not killed outright, they can drop to 1 Hit Point instead, and regain a number of Hit Points equal to three times their Paladin level. Once they use this feature, they can't do so again until they finish a Long Rest. Additionally, they can't be aged magically, and they cease visibly aging.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-ancients"
              }
            ],
            "20": [
              {
                "id": "oath-of-the-ancients-20-elder-champion",
                "name": "Elder Champion",
                "description": "As a Bonus Action, they can imbue their Aura of Protection with primal power, granting the benefits below for 1 minute or until they end them (no action required). Once they use this feature, they can't use it again until they finish a Long Rest. They can also restore their use of it by expending a level 5 spell slot (no action required). Diminish Defiance.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-ancients"
              }
            ]
          }
        },
        {
          "id": "paladin-oath-of-the-noble-genies",
          "name": "Oath of the Noble Genies",
          "description": "Paladins sworn to the Oath of the Noble Genies revere the forces of the Elemental Planes. Through taking this oath, Paladins draw power from the four different types of genies—dao, masters of earth; djinn, masters of air; efreet, masters of fire; and marids, masters of water. In Faerûn, many Paladins who swear this oath hail from Calimshan, a land teeming with genies.",
          "levelFeatures": {
            "3": [
              {
                "id": "oath-of-the-noble-genies-3-elemental-smite",
                "name": "Elemental Smite",
                "description": "Immediately after they cast Divine Smite, they can expend one use of their Channel Divinity and invoke one of the following effects. Dao’s Crush. Earth rises up around the target of their Divine Smite.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              },
              {
                "id": "oath-of-the-noble-genies-3-genie-spells",
                "name": "Genie Spells",
                "description": "When they reach a Paladin level specified in the Genie Spells table, they thereafter always have the listed spells prepared",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              },
              {
                "id": "oath-of-the-noble-genies-3-genie-s-splendor",
                "name": "Genie's Splendor",
                "description": "When they aren’t wearing any armor, their base Armor Class equals 10 plus their Dexterity and Charisma modifiers. They can use a Shield and still gain this benefit. They also gain proficiency in one of the following skills of their choice: Acrobatics, Intimidation, Performance, or Persuasion.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              }
            ],
            "7": [
              {
                "id": "oath-of-the-noble-genies-7-aura-of-elemental-shielding",
                "name": "Aura of Elemental Shielding",
                "description": "Choose one of the following damage types: Acid, Cold, Fire, Lightning, or Thunder. They and their allies have Resistance to that damage type while in their Aura of Protection. At the start of each of their turns, they can change the damage type affected by this feature to one of the other listed options (no action required).",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              }
            ],
            "15": [
              {
                "id": "oath-of-the-noble-genies-15-elemental-rebuke",
                "name": "Elemental Rebuke",
                "description": "When they are hit by an attack roll, they can take a Reaction to halve the attack’s damage against themselves (round down) and force the attacker to make a Dexterity saving throw against their spell save DC. On a failed save, the attacker takes damage equal to 2d10 plus their Charisma modifier of one of the following types (their choice): Acid, Cold, Fire, Lightning, or Thunder. On a successful save, the attacker takes half as much damage. They can use this feature a number of times equal to their Charisma…",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              }
            ],
            "20": [
              {
                "id": "oath-of-the-noble-genies-20-noble-scion",
                "name": "Noble Scion",
                "description": "As a Bonus Action, they gain the benefits below for 10 minutes or until they end them (no action required). Once they use this feature, they can’t use it again until they finish a Long Rest. They can also restore their use of it by expending a level 5 spell slot (no action required). Flight. They have a Fly Speed of 60 feet and can hover.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-the-noble-genies"
              }
            ]
          }
        },
        {
          "id": "paladin-oath-of-vengeance",
          "name": "Oath of Vengeance",
          "description": "The Oath of Vengeance is a solemn commitment to punish those who have committed grievously evil acts. When evil armies slaughter helpless villagers, when a tyrant defies the will of the gods, when a thieves' guild grows too violent, when a dragon rampages though the countryside - at times like these, Paladins arise and swear the Oath of Vengeance to set right what has gone wrong.",
          "levelFeatures": {
            "3": [
              {
                "id": "oath-of-vengeance-3-oath-of-vengeance-spells",
                "name": "Oath of Vengeance Spells",
                "description": "The magic of their oath ensures they always have certain spells ready; when they reach a Paladin level specified in the Oath of Vengeance Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-vengeance"
              },
              {
                "id": "oath-of-vengeance-3-vow-of-enmity",
                "name": "Vow of Enmity",
                "description": "When they take the Attack action, they can expend one use of their Channel Divinity to utter a vow of enmity against a creature they can see within 30 feet of themselves. They have Advantage on attack rolls against the creature for 1 minute or until they use this feature again. If the creature drops to 0 Hit Points before the vow ends, they can transfer the vow to a different creature within 30 feet of themselves (no action required).",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-vengeance"
              }
            ],
            "7": [
              {
                "id": "oath-of-vengeance-7-relentless-avenger",
                "name": "Relentless Avenger",
                "description": "Their supernatural focus helps they close off a foe's retreat. When they hit a creature with an Opportunity Attack, they can reduce the creature's Speed to 0 until the end of the current turn. They can then move up to half their Speed as part of the same Reaction. This movement doesn't provoke Opportunity Attacks.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-vengeance"
              }
            ],
            "15": [
              {
                "id": "oath-of-vengeance-15-soul-of-vengeance",
                "name": "Soul of Vengeance",
                "description": "Immediately after a creature under the effect of their Vow of Enmity hits or misses with an attack roll, they can take a Reaction to make a melee attack against that creature if it's within range.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-vengeance"
              }
            ],
            "20": [
              {
                "id": "oath-of-vengeance-20-avenging-angel",
                "name": "Avenging Angel",
                "description": "As a Bonus Action, they gain the benefits below for 10 minutes or until they end them (no action required). Once they use this feature, they can't use it again until they finish a Long Rest. They can also restore their use of it by expending a level 5 spell slot (no action required). Flight. They sprout spectral wings on their back and have a Fly Speed of 60 feet, and can hover.",
                "source": "http://dnd2024.wikidot.com/paladin:oath-of-vengeance"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "spirit",
        "charisma"
      ]
    },
    {
      "id": "ranger",
      "name": "Ranger",
      "hitDie": 10,
      "primaryAbility": "agility",
      "description": "Far from bustling cities, amid the trees of trackless forests and across wide plains, Rangers keep their unending watch in the wilderness. Rangers learn to track their quarry as a predator does, moving stealthily through the wilds and hiding themselves in brush and rubble.",
      "levelFeatures": {
        "1": [
          {
            "id": "ranger-1-spellcasting",
            "name": "Spellcasting",
            "description": "They have learned to channel the magical essence of nature to cast spells. See Chapter 7 for the rules on Spellcasting. The Information below details how they use those rules with Ranger spells, which appear in the Ranger spell list later in the class's description.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          },
          {
            "id": "ranger-1-favored-enemy",
            "name": "Favored Enemy",
            "description": "They always have the Hunter's Mark spell prepared. They can cast it twice without expending a spell slot, and they regain all expended uses of this ability when they finish a Long Rest. The number of times they can cast the spell without a spell slot increases when they reach certain Ranger Levels, as shown in the Favored Enemy column of the Ranger Features table.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          },
          {
            "id": "ranger-1-weapon-mastery",
            "name": "Weapon Mastery",
            "description": "Their training with weapons allows they to use the mastery properties of two kinds of weapons of their choice with which they have proficiency, such as Longbows and Shortswords. Whenever they finish a Long Rest, they can change the kinds of weapons they chose. For Example, they could switch to using the mastery properties of Scimitars and Longswords.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "2": [
          {
            "id": "ranger-2-deft-explorer",
            "name": "Deft Explorer",
            "description": "Thanks to their travels, they gain the following benefits. Expertise.: Choose one of their skill proficiencies with which they lack Expertise. They gain Expertise in that skill. Languages.: they know two languages of their choice from the language tables in chapter 2.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          },
          {
            "id": "ranger-2-fighting-style",
            "name": "Fighting Style",
            "description": "They gain a Fighting Style feat of their choice (see chapter 5). Instead of choosing one of those feats, they can choose the option below. Druidic Warrior. They learn two Druid cantrips of their choice (See the Druid class's section for a list of Druid spells).",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "3": [
          {
            "id": "ranger-3-ranger-subclass",
            "name": "Ranger Subclass",
            "description": "They gain a Ranger Subclass of their choice. The Beast Master, Fey Wanderer, Gloom Stalker and Hunter subclasses are detailed after this class's description. A Subclass is a specialization that grants they features at certain Ranger levels.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "4": [
          {
            "id": "ranger-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Ranger levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "5": [
          {
            "id": "ranger-5-extra-attack",
            "name": "Extra Attack",
            "description": "They can attack twice instead of once whenever they take the Attack action on their turn.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "6": [
          {
            "id": "ranger-6-roving",
            "name": "Roving",
            "description": "Their speed increases by 10 feet while they aren't wearing Heavy Armor. They also have a Climb speed and a Swim Speed equal to their Speed.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "9": [
          {
            "id": "ranger-9-expertise",
            "name": "Expertise",
            "description": "Choose two of their skill proficiencies with which they lack Expertise. They gain Expertise in those skills.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "10": [
          {
            "id": "ranger-10-tireless",
            "name": "Tireless",
            "description": "Primal forces now help fuel they on their journeys, granting they the following benefits. Temporary Hit Points. As a Magic Action, they can give themselves a number of Temporary Hit Points equal to 1d8 plus their Wisdom modifier (minimum of 1). They can use this action a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "13": [
          {
            "id": "ranger-13-relentless-hunter",
            "name": "Relentless Hunter",
            "description": "Taking damage can't break their Concentration on Hunter's Mark.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "14": [
          {
            "id": "ranger-14-nature-s-veil",
            "name": "Nature's Veil",
            "description": "They invoke spirits of nature to magically hide themselves. As a Bonus Action they can give themselves the Invisible condition until the end of their next turn. They can use this feature a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "17": [
          {
            "id": "ranger-17-precise-hunter",
            "name": "Precise Hunter",
            "description": "They have Advantage on attack rolls against the creature currently marked by their Hunter's Mark.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "18": [
          {
            "id": "ranger-18-feral-senses",
            "name": "Feral Senses",
            "description": "Their connection to the forces of nature grants they Blindsight with a range of 30 feet.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "19": [
          {
            "id": "ranger-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Dimensional Travel is recommended.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ],
        "20": [
          {
            "id": "ranger-20-foe-slayer",
            "name": "Foe Slayer",
            "description": "The damage die of their Hunter's Mark is a d10 rather than a d6.",
            "source": "http://dnd2024.wikidot.com/ranger:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "ranger-beast-master",
          "name": "Beast Master",
          "description": "Bond with a Primal Beast A Beast Master forms a mystical bond with a special animal, drawing on primal magic and a deep connection to the natural world.",
          "levelFeatures": {
            "3": [
              {
                "id": "beast-master-3-primal-companion",
                "name": "Primal Companion",
                "description": "They magically summon a primal beast, which draws strength from their bond with nature. Choose its stat block: Beast of the Land, Beast of the Sea or Beast of the Sky. They also determine the kind of animal it is, choosing a kind appropriate for the stat block. Whatever beast they choose, it bears primal markings indicating its supernatural origin.",
                "source": "http://dnd2024.wikidot.com/ranger:beast-master"
              }
            ],
            "7": [
              {
                "id": "beast-master-7-exceptional-training",
                "name": "Exceptional Training",
                "description": "When they take a Bonus Action to command their Primal Companion beast to take an action, they can also command it to take the Dash, Disengage, Dodge, or Help action using its Bonus Action. In addition, whenever it hits with an attack roll and deals damage, it can deal their choice of Force damage or its normal damage type.",
                "source": "http://dnd2024.wikidot.com/ranger:beast-master"
              }
            ],
            "11": [
              {
                "id": "beast-master-11-bestial-fury",
                "name": "Bestial Fury",
                "description": "When they command their Primal Companion beast to take the Beast's Strike action, the beast can use it twice. In addition, the first time each turn it hits a creature under the effect of their Hunter's Mark spell, the beast deals extra Force damage equal to the bonus damage of that spell.",
                "source": "http://dnd2024.wikidot.com/ranger:beast-master"
              }
            ],
            "15": [
              {
                "id": "beast-master-15-share-spells",
                "name": "Share Spells",
                "description": "When they cast a spell targeting themselves, they can also affect their Primal Companion beast with the spell if the beast is within 30 feet of them.",
                "source": "http://dnd2024.wikidot.com/ranger:beast-master"
              }
            ]
          }
        },
        {
          "id": "ranger-fey-wanderer",
          "name": "Fey Wanderer",
          "description": "Wield Fey Mirth and Fury A fey mystique surrounds they, thanks to the boon of an archfey or a location in the Feywild that transformed they. However they gained fey magic, they are now a Fey Wanderer. their joyful laughter brightens the hearts of the downtrodden, and their martial prowess strikes terror in their foes, for great is the mirth of the fey and dreadful is their fury.",
          "levelFeatures": {
            "3": [
              {
                "id": "fey-wanderer-3-dreadful-strikes",
                "name": "Dreadful Strikes",
                "description": "They can augment their weapon strikes with mind-scarring magic drawn from the murky hollows of the Feywild. When they hit a creature with a weapon, they can deal an extra 1d4 Psychic damage to the target, which can take this extra damage only once per turn. The extra damage increases to 1d6 when they reach Ranger level 11.",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              },
              {
                "id": "fey-wanderer-3-fey-wanderer-spells",
                "name": "Fey Wanderer Spells",
                "description": "When they reach a Ranger level specified in the Fey Wanderer spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              },
              {
                "id": "fey-wanderer-3-otherworldly-glamour",
                "name": "Otherworldly Glamour.",
                "description": "Whenever they make a Charisma check, they gain a bonus to the check equal to their Wisdom modifier (Minimum of +1). They also gain proficiency in one of these skills of their choice: Deception, Performance, or Persuasion.",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              }
            ],
            "7": [
              {
                "id": "fey-wanderer-7-beguiling-twist",
                "name": "Beguiling Twist",
                "description": "The magic of the Feywild guards their mind. They have advantage on saving throws to avoid or end the Charmed or Frightened condition. In addition, whenever they or a creature they can see within 120 feet of them succeeds on a saving throw to avoid or end the Charmed or Frightened condition, they can take a Reaction to force a different creature they can see within 120 feet of themselves to make a Wisdom save against their spell save DC. On a failed save, the target is charmed or frightened (their choice) for 1…",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              }
            ],
            "11": [
              {
                "id": "fey-wanderer-11-fey-reinforcements",
                "name": "Fey Reinforcements",
                "description": "They can cast Summon Fey without a Material component. They can also cast it once without a spell slot, and they regain the ability to cast it in this way when they finish a Long Rest. Whenever they start casting the spell, they can modify it so that it doesn't require Concentration. If they do so, the spell's duration becomes 1 minute for the casting.",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              }
            ],
            "15": [
              {
                "id": "fey-wanderer-15-misty-wanderer",
                "name": "Misty Wanderer",
                "description": "They can cast Misty Step without expending a spell slot. They can do so a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest. In addition, whenever they cast Misty Step, they can bring along one willing creature they can see within 5 feet of themselves. That creature teleports to an unoccupied space of their choice within 5 feet of their destination space.",
                "source": "http://dnd2024.wikidot.com/ranger:fey-wanderer"
              }
            ]
          }
        },
        {
          "id": "ranger-gloom-stalker",
          "name": "Gloom Stalker",
          "description": "Gloom Stalkers are at home in the darkest places, wielding magic drawn from the Shadowfell to combat enemies that lurk in darkness.",
          "levelFeatures": {
            "3": [
              {
                "id": "gloom-stalker-3-dread-ambusher",
                "name": "Dread Ambusher",
                "description": "They have mastered the art of creating fearsome ambushes, granting they the following benefits. Ambusher's Leap. At the start of their first turn of each combat, their speed increases by 10 feet until the end of that turn.",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              },
              {
                "id": "gloom-stalker-3-gloom-stalker-spells",
                "name": "Gloom Stalker Spells",
                "description": "When they reach a Ranger level specified in the Gloom Stalker spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              },
              {
                "id": "gloom-stalker-3-umbral-sight",
                "name": "Umbral Sight",
                "description": "They gain Darkvision with a range of 60 feet. If they already have Darkvision when they gain this feature, its range increases by 60 feet. They are also adept at evading creatures that rely on Darkvision. While entirely in Darkness, they have the Invisible condition to any creature that relies on Darkvision to see they in that Darkness.",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              }
            ],
            "7": [
              {
                "id": "gloom-stalker-7-iron-mind",
                "name": "Iron Mind",
                "description": "They have honed their ability to resist mind-altering powers. They gain proficiency in Wisdom saving throws. If they already have this proficiency, they instead gain proficiency in Intelligence or Charisma saving throws (their choice).",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              }
            ],
            "11": [
              {
                "id": "gloom-stalker-11-stalker-s-flurry",
                "name": "Stalker's Flurry",
                "description": "The Psychic damage of their Dreadful Strike becomes 2d8. In addition, when they use the Dreadful Strike effect of their Dread Ambusher feature, they can use one of the following additional effects. Sudden Strike. They can make another attack with the same weapon against a different creature that is within 5 feet of the original target and that is within the weapon's range.",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              }
            ],
            "15": [
              {
                "id": "gloom-stalker-15-shadowy-dodge",
                "name": "Shadowy Dodge",
                "description": "When a creature makes an attack roll against them, they can take a Reaction to impose Disadvantage on that roll. Whether the attack hits or misses, they can teleport up to 30 feet to an unoccupied space that they can see.",
                "source": "http://dnd2024.wikidot.com/ranger:gloom-stalker"
              }
            ]
          }
        },
        {
          "id": "ranger-hollow-warden",
          "name": "Hollow Warden",
          "description": "Draw on the Might of Ancient Wild Terrors Legends tell that the most ancient and bloodthirsty terrors lurk deep within the old places of the earth. Hollow Wardens venerate and draw power from such beings, transforming themselves into merciless and monstrous guardians that stalk jagged coastlines, steep mountain crags, and other dark and wild places.",
          "levelFeatures": {
            "3": [
              {
                "id": "hollow-warden-3-hollow-warden-spells",
                "name": "Hollow Warden Spells",
                "description": "When they reach a Ranger level specified in the Hollow Warden Spells table, they thereafter always have the listed spell prepared.",
                "source": "http://dnd2024.wikidot.com/ranger:hollow-warden"
              },
              {
                "id": "hollow-warden-3-wrath-of-the-wild",
                "name": "Wrath of the Wild",
                "description": "They draw power from the strange and ancient horrors of the land, causing they to sprout unnatural growths, such as bloody antlers or putrid fangs, or causing their shadow to lengthen or twist around them. As a Bonus Action, they can expend a use of Favored Enemy to transform into a ghastly form, gaining the following benefits for 1 minute or until they have the Incapacitated condition, die, or end the transformation (no action required). Ancient Armor. They gain a +1 bonus to AC, as their body is wreathed in…",
                "source": "http://dnd2024.wikidot.com/ranger:hollow-warden"
              }
            ],
            "7": [
              {
                "id": "hollow-warden-7-hungering-might",
                "name": "Hungering Might",
                "description": "They gain a bonus to Constitution saving throws equal to their Wisdom modifier (minimum of +1). In addition, once per turn when they hit a creature with an attack roll while they are transformed using Wrath of the Wild, they regain a number of Hit Points equal to 1d10 plus their Wisdom modifier, provided they are Bloodied when they hit.",
                "source": "http://dnd2024.wikidot.com/ranger:hollow-warden"
              }
            ],
            "11": [
              {
                "id": "hollow-warden-11-rot-and-violence",
                "name": "Rot and Violence",
                "description": "Their dedication to wild eldritch beings alters they further. When transformed using Wrath of the Wild, they gain the following additional benefits. Menacing Aura.",
                "source": "http://dnd2024.wikidot.com/ranger:hollow-warden"
              }
            ],
            "15": [
              {
                "id": "hollow-warden-15-ancient-might",
                "name": "Ancient Might",
                "description": "They become wholly suffused with the wild’s ancient and terrible power, granting they the following benefits. Ominous Strikes. When they hit a creature that has the Frightened condition with an attack roll, that attack deals extra damage equal to their Wisdom modifier.",
                "source": "http://dnd2024.wikidot.com/ranger:hollow-warden"
              }
            ]
          }
        },
        {
          "id": "ranger-hunter",
          "name": "Hunter",
          "description": "Protect Nature and People from Destruction they stalk prey in the wilds and elsewhere, using their abilities as a Hunter to protect nature and people everywhere from forces that would destroy them.",
          "levelFeatures": {
            "3": [
              {
                "id": "hunter-3-hunter-s-lore",
                "name": "Hunter's Lore",
                "description": "They can call upon the forces of nature to reveal certain strengths and weaknesses of their prey. While a creature is marked by their Hunter's Mark, they know whether the creature has any Immunities, Resistances, or Vulnerabilities, and if the creature has any, they know what they are.",
                "source": "http://dnd2024.wikidot.com/ranger:hunter"
              },
              {
                "id": "hunter-3-hunter-s-prey",
                "name": "Hunter's Prey",
                "description": "They gain one of the following feature options of their choice. Whenever they finish a Short or Long Rest, they can replace the chosen option with the other one. Colossus Slayer. their tenacity can wear down even the most resilient foes.",
                "source": "http://dnd2024.wikidot.com/ranger:hunter"
              }
            ],
            "7": [
              {
                "id": "hunter-7-defensive-tactics",
                "name": "Defensive Tactics",
                "description": "They gain one of the following feature options of their choice. Whenever they finish a Short or Long Rest, they can replace the chosen option with the other one. Escape the Horde.",
                "source": "http://dnd2024.wikidot.com/ranger:hunter"
              }
            ],
            "11": [
              {
                "id": "hunter-11-superior-hunter-s-prey",
                "name": "Superior Hunter's Prey",
                "description": "Once per turn when they deal damage to a creature marked by their Hunter's Mark, they can also deal that spell's extra damage to a different creature that they can see within 30 feet of the first creature.",
                "source": "http://dnd2024.wikidot.com/ranger:hunter"
              }
            ],
            "15": [
              {
                "id": "hunter-15-superior-hunter-s-defense",
                "name": "Superior Hunter's Defense",
                "description": "When they take damage, they can take a Reaction to give themselves Resistance to that damage and any other damage of the same type until the end of the current turn.",
                "source": "http://dnd2024.wikidot.com/ranger:hunter"
              }
            ]
          }
        },
        {
          "id": "ranger-winter-walker",
          "name": "Winter Walker",
          "description": "Winter Walkers hone their craft in the bleak and frozen wilds of places like Icewind Dale. These ruthless, rimed Rangers hunt monsters that haunt arctic wastelands, eventually becoming frigid terrors themselves. Winter Walkers are well versed in the phenomena of Icewind Dale, including the latent magic of fallen Netherese cities, endemic monsters like yetis and crag cats, and the rising threat of Underdark invaders.",
          "levelFeatures": {
            "3": [
              {
                "id": "winter-walker-3-frigid-explorer",
                "name": "Frigid Explorer",
                "description": "Biting Cold. Damage from their weapon attacks, Ranger spells, and Ranger features ignores Resistance to Cold damage. Frost Resistance. They have Resistance to Cold damage.",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              },
              {
                "id": "winter-walker-3-hunter-s-rime",
                "name": "Hunter's Rime",
                "description": "Ice rimes they and their prey, protecting they and hindering them. When they cast Hunter’s Mark, they gain Temporary Hit Points equal to 1d10 plus their Ranger level. Additionally, while a creature is marked by their Hunter’s Mark, it can’t take the Disengage action.",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              },
              {
                "id": "winter-walker-3-winter-walker-spells",
                "name": "Winter Walker Spells",
                "description": "When they reach a Ranger level specified in the Winter Walker Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              }
            ],
            "7": [
              {
                "id": "winter-walker-7-fortifying-soul",
                "name": "Fortifying Soul",
                "description": "Their experience surviving harrowing environments allows they to bolster their allies in addition to themselves. As a Magic action, choose a number of creatures they can see equal to their Wisdom modifier (minimum of one). Each chosen creature regains Hit Points equal to 1d10 plus their Ranger level and has Advantage on saving throws to avoid or end the Frightened condition for 1 hour.",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              }
            ],
            "11": [
              {
                "id": "winter-walker-11-chilling-retribution",
                "name": "Chilling Retribution",
                "description": "When a creature hits they with an attack roll, they can take a Reaction to force the creature to make a Wisdom saving throw against their spell save DC. On a failed save, the target has the Stunned condition until the end of their next turn. While the target is Stunned, its Speed is reduced to 0 feet. They can use this feature a number of times equal to their Wisdom modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              }
            ],
            "15": [
              {
                "id": "winter-walker-15-frozen-haunt",
                "name": "Frozen Haunt",
                "description": "When they cast Hunter’s Mark, they can adopt a ghostly, snowy form. This form lasts until the spell ends, and while they are in this form, they gain the following benefits. Once they use this feature, they can’t use it again until they finish a Long Rest unless they expend a level 4+ spell slot (no action required).",
                "source": "http://dnd2024.wikidot.com/ranger:winter-walker"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "strength",
        "agility"
      ]
    },
    {
      "id": "rogue",
      "name": "Rogue",
      "hitDie": 8,
      "primaryAbility": "agility",
      "description": "Rogues rely on cunning, stealth, and their foes' vulnerabilities to get the upper hand in any situation. They have a knack for finding the solution to just about any problem. A few even learn magical tricks to supplement their other abilities.",
      "levelFeatures": {
        "1": [
          {
            "id": "rogue-1-expertise",
            "name": "Expertise",
            "description": "They gain Expertise in two of their skill proficiencies of their choice. Sleight of Hand and Stealth are recommended if they have proficiency in them. At Rogue Level 6, they gain Expertise in two more of their skill proficiencies of their Choice.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-1-sneak-attack",
            "name": "Sneak Attack",
            "description": "They know how to strike subtly and exploit a foe's distraction. Once per turn they can deal an extra 1d6 damage to one creature they hit with an attack roll if they have Advantage on the roll and the attack uses a Finesse or a Ranged weapon. The extra damage's type is the same as the weapon's type. They don't need Advantage on the attack roll if at least one of their allies is within 5 feet of the target, the ally doesn't have the Incapacitated condition and they don't have Disadvantage on the attack roll.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-1-thieves-cant",
            "name": "Thieves' Cant",
            "description": "They picked up various languages in the communities where they plied their roguish talents. They know Thieves' Cant and one other language of their choice, which they choose from the language tables in Chapter 2.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-1-weapon-mastery",
            "name": "Weapon Mastery",
            "description": "Their training with weapons allows they to use the mastery properties of two kinds of weapons of their choice with which they have proficiency, such as Daggers and Shortbows. Whenever they finish a Long Rest, they can change the kinds of weapons they chose. For example, they could switch to using the mastery properties of Scimitars and Shortswords.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "2": [
          {
            "id": "rogue-2-cunning-action",
            "name": "Cunning Action",
            "description": "Their quick thinking and agility allow they to move and act quickly. On their turn, they can take one of the following actions as a Bonus Action: Dash, Disengage, or Hide.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "3": [
          {
            "id": "rogue-3-rogue-subclass",
            "name": "Rogue Subclass",
            "description": "They gain a Rogue subclass of their choice. The Arcane Trickster, Assassin, Soulknife, and the Thief subclasses are detailed after this class's description. A Subclass is a specialization that grants they features at certain Rogue levels.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-3-steady-aim",
            "name": "Steady Aim",
            "description": "As a Bonus Action, they give themselves Advantage on their next attack roll on their current turn. They can use this feature only if they haven't moved during this turn, and after they use it, their Speed is 0 until the end of the current turn.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "4": [
          {
            "id": "rogue-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Rogue levels 8, 10, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "5": [
          {
            "id": "rogue-5-cunning-strike",
            "name": "Cunning Strike",
            "description": "They have developed cunning ways to use their Sneak Attack. When they deal Sneak Attack damage, they can add one of the following Cunning Strike effects. Each effect has a die cost, which is the number of Sneak Attack dice they must forgo to add the effect. They remove the die before rolling, and the effect occurs immediately after the attack's damage is dealt.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-5-uncanny-dodge",
            "name": "Uncanny Dodge",
            "description": "When an attacker that they can see hits they with an attack roll, they can take a Reaction to halve the attack's damage against them (round down).",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "7": [
          {
            "id": "rogue-7-evasion",
            "name": "Evasion",
            "description": "They can nimbly dodge out of the way of certain dangers. When they are subjected to an effect that allows they to make a Dexterity saving throw to take only half damage, they instead take no damage if they succeed on the saving throw and only half damage if they fail. They can't use this feature if they have the Incapacitated condition.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          },
          {
            "id": "rogue-7-reliable-talent",
            "name": "Reliable Talent",
            "description": "Whenever they make an ability check that uses one of their skill or tool proficiencies, they can treat a d20 roll of 9 or lower as a 10.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "11": [
          {
            "id": "rogue-11-improved-cunning-strike",
            "name": "Improved Cunning Strike",
            "description": "They can use up to two Cunning Strike effects when they deal Sneak Attack damage, paying the die cost for each effect.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "14": [
          {
            "id": "rogue-14-devious-strikes",
            "name": "Devious Strikes",
            "description": "They have practiced new ways to use their Sneak Attack deviously. The following effects are now among their Cunning Strike options. Daze (Cost: 2d6).",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "15": [
          {
            "id": "rogue-15-slippery-mind",
            "name": "Slippery Mind",
            "description": "Their mind is exceptionally difficult to control. They gain proficiency in Wisdom and Charisma saving throws.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "18": [
          {
            "id": "rogue-18-elusive",
            "name": "Elusive",
            "description": "They are so evasive that attackers rarely gain the upper hand against them. No attack roll can have advantage against them unless they have the Incapacitated condition.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "19": [
          {
            "id": "rogue-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of the Night Spirit is recommended.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ],
        "20": [
          {
            "id": "rogue-20-stroke-of-luck",
            "name": "Stroke of Luck",
            "description": "They have a marvelous knack for succeeding when they need to. If they fail a d20 Test, they can turn the roll into a 20. Once they use this feature, they can't use it again until they finish a Short or Long Rest.",
            "source": "http://dnd2024.wikidot.com/rogue:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "rogue-arcane-trickster",
          "name": "Arcane Trickster",
          "description": "Enhance Stealth with Arcane Spells Some Rogues enhance their fine-honed skills of stealth and agility with spells, learning magical tricks to aid them in their trade. Some Arcane Tricksters use their talents as pickpockets and burglars, while others are pranksters.",
          "levelFeatures": {
            "3": [
              {
                "id": "arcane-trickster-3-spellcasting",
                "name": "Spellcasting",
                "description": "They have learned to cast spells. See chapter 7 for the rules on spellcasting. The information below details how they use those rules as an Arcane Trickster.",
                "source": "http://dnd2024.wikidot.com/rogue:arcane-trickster"
              },
              {
                "id": "arcane-trickster-3-mage-hand-legerdemain",
                "name": "Mage Hand Legerdemain",
                "description": "When they cast Mage Hand, they can cast it as a Bonus Action, and they can make the spectral hand Invisible. They can control the hand as a Bonus Action, and through it, they can make Dexterity (Sleight of Hand) checks.",
                "source": "http://dnd2024.wikidot.com/rogue:arcane-trickster"
              }
            ],
            "9": [
              {
                "id": "arcane-trickster-9-magical-ambush",
                "name": "Magical Ambush",
                "description": "If they have the Invisible condition when they cast a spell on a creature, it has Disadvantage on any saving throw it makes against the spell on the same turn.",
                "source": "http://dnd2024.wikidot.com/rogue:arcane-trickster"
              }
            ],
            "13": [
              {
                "id": "arcane-trickster-13-versatile-trickster",
                "name": "Versatile Trickster",
                "description": "They gain the ability to distract targets with their Mage Hand. When they use the Trip option of their Cunning Strike on a creature, they can also use that option on another creature within 5 feet of the spectral hand.",
                "source": "http://dnd2024.wikidot.com/rogue:arcane-trickster"
              }
            ],
            "17": [
              {
                "id": "arcane-trickster-17-spell-thief",
                "name": "Spell Thief",
                "description": "They gain the ability to magically steal the knowledge of how to cast a spell from another spellcaster. Immediately after a creature casts a spell that targets they or includes they in its area of effect, they can take a Reaction to force the creature to make an Intelligence saving throw. The DC equals their spell save DC.",
                "source": "http://dnd2024.wikidot.com/rogue:arcane-trickster"
              }
            ]
          }
        },
        {
          "id": "rogue-assassin",
          "name": "Assassin",
          "description": "Practice the Grim Art of Death An Assassin's training focuses on using stealth, poison, and disguise to eliminate foes with deadly efficiency. While some Rogues who follow this path are hired killers, spies, or bounty hunters, the capabilities of this subclass are equally useful for adventurers facing a variety of monstrous enemies.",
          "levelFeatures": {
            "3": [
              {
                "id": "assassin-3-assassinate",
                "name": "Assassinate",
                "description": "They are adept at ambushing a target, granting they the following benefits. Initiative. They have Advantage on Initiative rolls. Surprising Strikes.",
                "source": "http://dnd2024.wikidot.com/rogue:assassin"
              },
              {
                "id": "assassin-3-assassin-s-tools",
                "name": "Assassin's Tools",
                "description": "They gain a Disguise Kit and a Poisoner's Kit, and they have proficiency with them.",
                "source": "http://dnd2024.wikidot.com/rogue:assassin"
              }
            ],
            "9": [
              {
                "id": "assassin-9-infiltration-expertise",
                "name": "Infiltration Expertise",
                "description": "They are an expert at the following techniques that aid their infiltrations. Masterful Mimicry. They can unerringly mimic another person's speech, handwriting or both if they have spent at least 1 hour studying them. Roving Aim. their speed isn't reduced to 0 by using Steady Aim.",
                "source": "http://dnd2024.wikidot.com/rogue:assassin"
              }
            ],
            "13": [
              {
                "id": "assassin-13-envenom-weapons",
                "name": "Envenom Weapons",
                "description": "When they use the Poison option of their Cunning Strike, the target also takes 2d6 Poison damage whenever it fails the saving throw. This damage ignores Resistance to Poison damage.",
                "source": "http://dnd2024.wikidot.com/rogue:assassin"
              }
            ],
            "17": [
              {
                "id": "assassin-17-death-strike",
                "name": "Death Strike",
                "description": "When they hit with their Sneak Attack on the first round of a combat, the target must succeed on a Constitution saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus), or the attack's damage is doubled against the target.",
                "source": "http://dnd2024.wikidot.com/rogue:assassin"
              }
            ]
          }
        },
        {
          "id": "rogue-phantom",
          "name": "Phantom",
          "description": "Embrace Death and Wield Ghostly Power Some Rogues traverse the veil between life and death, shepherding opponents to the grave and slipping through the world as undetectable as a spirit. In these pursuits, a Rogue might discover a mystical connection to death itself. Such an individual becomes immersed in negative energy, infusing their strikes with deathly energy and stealing knowledge from souls who have passed on.",
          "levelFeatures": {
            "3": [
              {
                "id": "phantom-3-wails-from-the-grave",
                "name": "Wails from the Grave",
                "description": "Immediately after they deal Sneak Attack damage to a creature on their turn, they can target a second creature that they can see within 30 feet of the first creature. Roll half the number of Sneak Attack damage dice for their level (round up), and the second creature takes Necrotic damage equal to the roll’s total as wails of the dead sound around it. They can use this feature a number of times equal to their Dexterity modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              },
              {
                "id": "phantom-3-whispers-of-the-dead",
                "name": "Whispers of the Dead",
                "description": "Whenever they finish a Short or Long Rest, they can choose one skill or tool proficiency that they lack and gain it, as a ghostly presence shares its knowledge with they. They lose this proficiency when they use this benefit again to choose a different proficiency.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              }
            ],
            "9": [
              {
                "id": "phantom-9-tokens-of-the-departed",
                "name": "Tokens of the Departed",
                "description": "The spirits of the dead are drawn to them, and echoes of their past lives magically manifest as strange curios with resonant power. They gain two soul trinkets. A soul trinket is a Tiny object (the DM determines the trinket’s form or has they roll on the Trinkets table in the Player’s Handbook to generate it). If they move more than 30 feet from a trinket, the trinket immediately teleports to them, appearing somewhere on their person.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              },
              {
                "id": "phantom-9-voice-of-death",
                "name": "Voice of Death",
                "description": "They can cast Speak with Dead once without a spell slot, requiring no spell components and using Dexterity as the spellcasting modifier. They regain the ability to cast it this way when they finish a Short or Long Rest. When they cast the spell, they can target one of their soul trinkets from Tokens of the Departed instead of a corpse, allowing the spirit of the creature associated with the trinket to answer.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              }
            ],
            "13": [
              {
                "id": "phantom-13-ghost-walk",
                "name": "Ghost Walk",
                "description": "As a Bonus Action, they assume a spectral form, gaining the benefits below for 10 minutes or until they end them (no action required). Once they use this feature, they can’t use it again until they finish a Long Rest unless they destroy one of their soul trinkets from Tokens of the Departed (no action required) to restore their use of it. Flight. They gain a Fly Speed of 10 feet and can hover.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              }
            ],
            "17": [
              {
                "id": "phantom-17-deaths-friend",
                "name": "Death’s Friend",
                "description": "Their association with death has become so close that they gain the following benefits. Death’s Lament. When they use Wails from the Grave, they can deal the feature’s Necrotic damage to both the first and the second creature.",
                "source": "http://dnd2024.wikidot.com/rogue:phantom"
              }
            ]
          }
        },
        {
          "id": "rogue-scion-of-the-three",
          "name": "Scion of the Three",
          "description": "A Scion of the Three draws power from a group of malevolent gods known in Baldur’s Gate as the Dead Three: Bane, a god of tyranny; Bhaal, a god of violence and murder; and Myrkul, a god of death. While some Rogues of this subclass pledge themselves ardently to those three macabre gods, others are thrust on this path by a curse. Either way, a scion’s power manifests as various occult gifts, as well as an uncanny talent for striking and terrifying foes.",
          "levelFeatures": {
            "3": [
              {
                "id": "scion-of-the-three-3-bloodthirst",
                "name": "Bloodthirst",
                "description": "When an enemy they can see within 30 feet of themselves takes damage and is Bloodied after taking that damage but not killed outright, they can take a Reaction and teleport to an unoccupied space they can see within 5 feet of that enemy. They can then make one melee attack. They can use this feature a number of times equal to their Intelligence modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/rogue:scion-of-the-three"
              },
              {
                "id": "scion-of-the-three-3-dread-allegiance",
                "name": "Dread Allegiance",
                "description": "Choose one of the Dead Three: Bane, Bhaal, or Myrkul. They gain Resistance to one type of damage and the ability to cast a cantrip, as detailed in the table below; Intelligence is their spellcasting ability for this cantrip. When they finish a Long Rest, they can change their choice. God Damage Resistance Cantrip Bane Psychic Minor Illusion Bhaal Poison Blade Ward Myrkul Necrotic Chill Touch",
                "source": "http://dnd2024.wikidot.com/rogue:scion-of-the-three"
              }
            ],
            "9": [
              {
                "id": "scion-of-the-three-9-strike-fear",
                "name": "Strike Fear",
                "description": "They gain the following Cunning Strike option. Terrify (Cost: 1d6). The target must succeed on a Wisdom saving throw, or it has the Frightened condition for 1 minute.",
                "source": "http://dnd2024.wikidot.com/rogue:scion-of-the-three"
              }
            ],
            "13": [
              {
                "id": "scion-of-the-three-13-aura-of-malevolence",
                "name": "Aura of Malevolence",
                "description": "They radiate malignant power associated with one of the Dead Three. When they use Bloodthirst and teleport, each creature of their choice within 10 feet of either the space they left or their destination space (their choice) takes damage equal to their Intelligence modifier; the damage type is the same as the damage Resistance granted by their choice in the Dread Allegiance feature. Damage dealt by this feature ignores Resistance.",
                "source": "http://dnd2024.wikidot.com/rogue:scion-of-the-three"
              }
            ],
            "17": [
              {
                "id": "scion-of-the-three-17-dread-incarnate",
                "name": "Dread Incarnate",
                "description": "Cutthroat. They regain one expended use of Bloodthirst when they finish a Short Rest. Murderous Intent. When they roll for their Sneak Attack damage, they can treat a roll of a 1 or 2 on the die as a 3.",
                "source": "http://dnd2024.wikidot.com/rogue:scion-of-the-three"
              }
            ]
          }
        },
        {
          "id": "rogue-soulknife",
          "name": "Soulknife",
          "description": "Strike Foes with Psionic Blades A Soulknife strikes with the mind, cutting through barriers both physical and psychic. These Rogues discover psionic power within themselves and channel it to do their roguish work. As a Soulknife their psionic abilities might have haunted they since childhood, revealing their full potential only as they experienced the stress of adventure.",
          "levelFeatures": {
            "3": [
              {
                "id": "soulknife-3-psionic-power",
                "name": "Psionic Power",
                "description": "They harbor a wellspring of psionic energy within themselves. It is represented by their Psionic Energy Dice, which fuel certain powers they have from this subclass. The Soulknife Energy Dice table shows the number of these dice they have when they reach certain Rogue levels, and the table shows the die size.",
                "source": "http://dnd2024.wikidot.com/rogue:soulknife"
              },
              {
                "id": "soulknife-3-psychic-blades",
                "name": "Psychic Blades",
                "description": "They can manifest shimmering blades of psychic energy. Whenever they take the Attack action or make an Opportunity Attack, they can manifest a Psychic Blade in their free hand and make the attack with that blade. The magic blade has the following traits: Weapon Category: Simple Melee Damage on a Hit: 1d6 Psychic plus the ability modifier used for the attack roll Properties: Finesse, Thrown (range 60/120 feet) Mastery: Vex (they can use this property, and it doesn't count against the number of properties they can…",
                "source": "http://dnd2024.wikidot.com/rogue:soulknife"
              }
            ],
            "9": [
              {
                "id": "soulknife-9-soul-blades",
                "name": "Soul Blades",
                "description": "They can now use the following powers with their Psychic Blades. Homing Strikes. If they make an attack roll with their Psychic Blade and miss the target, they can roll one Psionic Energy Die and add the number rolled to the attack roll.",
                "source": "http://dnd2024.wikidot.com/rogue:soulknife"
              }
            ],
            "13": [
              {
                "id": "soulknife-13-psychic-veil",
                "name": "Psychic Veil",
                "description": "They can weave a veil of psychic static to mask themselves. As a Magic action, they gain the Invisible condition for 1 hour or until they dismiss the effect (no action required). This invisibility ends early immediately after they deal damage to a creature or they force a creature to make a saving throw.",
                "source": "http://dnd2024.wikidot.com/rogue:soulknife"
              }
            ],
            "17": [
              {
                "id": "soulknife-17-rend-mind",
                "name": "Rend Mind",
                "description": "They can sweep their Psychic Blades through a creature's mind. When they use they Psychic Blades to deal Sneak Attack damage to a creature, they can force that target to make a Wisdom saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus). If the save fails, the target has the Stunned condition for 1 minute.",
                "source": "http://dnd2024.wikidot.com/rogue:soulknife"
              }
            ]
          }
        },
        {
          "id": "rogue-thief",
          "name": "Thief",
          "description": "Hunt for Treasure as a Classic Adventurer A mix of burglar, treasure hunter, and explorer, they are the epitome of an adventurer. In addition to improving their agility and stealth, they gain abilities useful for delving into ruins and getting maximum benefit from the magic items they find there.",
          "levelFeatures": {
            "3": [
              {
                "id": "thief-3-fast-hands",
                "name": "Fast Hands",
                "description": "As a Bonus Action, they can do one of the following. Sleight of Hand. Make a Dexterity (Sleight of Hand) check to pick a lock or disarm a trap with Thieves' Tools or to pick a pocket.",
                "source": "http://dnd2024.wikidot.com/rogue:thief"
              },
              {
                "id": "thief-3-second-story-work",
                "name": "Second Story Work",
                "description": "They have trained to get into especially hard-to-reach places, granting they these benefits. Climber. They gain a Climb Speed equal to their Speed. Jumper. They can determine their jump distance using their Dexterity rather than their Strength.",
                "source": "http://dnd2024.wikidot.com/rogue:thief"
              }
            ],
            "9": [
              {
                "id": "thief-9-supreme-sneak",
                "name": "Supreme Sneak",
                "description": "They gain the following Cunning Strike option. Stealth Attack (Cost: 1d6). If they have the Hide action's Invisible condition, this attack doesn't end that condition on they if they end the turn behind Three-Quarters Cover or Total Cover.",
                "source": "http://dnd2024.wikidot.com/rogue:thief"
              }
            ],
            "13": [
              {
                "id": "thief-13-use-magic-device",
                "name": "Use Magic Device",
                "description": "They have learned how to maximize use of magic items, granting they the following benefits. Attunement. They can attune to up to four magic items at once. Charges.",
                "source": "http://dnd2024.wikidot.com/rogue:thief"
              }
            ],
            "17": [
              {
                "id": "thief-17-thief-s-reflexes",
                "name": "Thief's Reflexes",
                "description": "They are adept at laying ambushes and quickly escaping danger. They can take two turns during the first round of any combat. They take their first turn at their normal Initiative and their second turn at their Initiative minus 10.",
                "source": "http://dnd2024.wikidot.com/rogue:thief"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "agility",
        "intellect"
      ]
    },
    {
      "id": "sorcerer",
      "name": "Sorcerer",
      "hitDie": 6,
      "primaryAbility": "charisma",
      "description": "Sorcerers wield innate magic that is stamped into their being. Some Sorcerers can’t name the origin of their power, while others trace it to strange events in their personal or family history. The blessing of a dragon or a dryad at a baby’s birth or the strike of lightning from a clear sky might spark a Sorcerer’s gift.",
      "levelFeatures": {
        "1": [
          {
            "id": "sorcerer-1-spellcasting",
            "name": "Spellcasting",
            "description": "Drawing from their innate magic, they can cast spells. See chapter 7 for the rules on spellcasting. The information below details how they use those rules with Sorcerer spells, which appear in the Sorcerer spell list later in the class’s description.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          },
          {
            "id": "sorcerer-1-innate-sorcery",
            "name": "Innate Sorcery",
            "description": "An event in their past left an indelible mark on they, infusing they with simmering magic. As a Bonus Action, they can unleash that magic for 1 minute, during which they gain the following benefits: The spell save DC of their Sorcerer spells increases by 1. They have Advantage on the attack rolls of Sorcerer spells they cast. They can use this feature twice, and they regain all expended uses of it when they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "2": [
          {
            "id": "sorcerer-2-font-of-magic",
            "name": "Font of Magic",
            "description": "They can tap into the wellspring of magic within themselves. This wellspring is represented by Sorcery Points, which allow they to create a variety of magical effects. They have 2 Sorcery Points, and they gain more as they reach higher levels, as shown in the Sorcery Points column of the Sorcerer Features table. They can’t have more Sorcery Points than the number shown in the table for their level. They regain all expended Sorcery Points when they finish a Long Rest. They can use their Sorcery Points to fuel the…",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          },
          {
            "id": "sorcerer-2-metamagic",
            "name": "Metamagic",
            "description": "Because their magic flows from within, they can alter their spells to suit their needs; they gain two Metamagic options of their choice from “Metamagic Options” later in this class’s description. They use the chosen options to temporarily modify spells they cast. To use an option, they must spend the number of Sorcery Points that it costs. They can use only one Metamagic option on a spell when they cast it unless otherwise noted in one of those options. Whenever they gain a Sorcerer level, they can replace one of…",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "3": [
          {
            "id": "sorcerer-3-sorcerer-subclass",
            "name": "Sorcerer Subclass",
            "description": "They gain a Sorcerer subclass of their choice. The Aberrant Sorcery, Clockwork Sorcery, Draconic Sorcery, and Wild Magic Sorcery subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Sorcerer levels.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "4": [
          {
            "id": "sorcerer-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Sorcerer levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "5": [
          {
            "id": "sorcerer-5-sorcerous-restoration",
            "name": "Sorcerous Restoration",
            "description": "When they finish a Short Rest, they can regain expended Sorcery Points, but no more than a number equal to half their Sorcerer level (round down). Once they use this feature, they can’t do so again until they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "6": [
          {
            "id": "sorcerer-6-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 6, Sorcerer characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "7": [
          {
            "id": "sorcerer-7-sorcery-incarnate",
            "name": "Sorcery Incarnate",
            "description": "If they have no uses of Innate Sorcery left, they can use it if they spend 2 Sorcery Points when they take the Bonus Action to activate it. In addition, while their Innate Sorcery feature is active, they can use up to two of their Metamagic options on each spell they cast.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "8": [
          {
            "id": "sorcerer-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Sorcerer characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "10": [
          {
            "id": "sorcerer-10-metamagic",
            "name": "Metamagic",
            "description": "At level 10, Sorcerer characters gain Metamagic.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "12": [
          {
            "id": "sorcerer-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Sorcerer characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "14": [
          {
            "id": "sorcerer-14-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 14, Sorcerer characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "16": [
          {
            "id": "sorcerer-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Sorcerer characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "17": [
          {
            "id": "sorcerer-17-metamagic",
            "name": "Metamagic",
            "description": "At level 17, Sorcerer characters gain Metamagic.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "18": [
          {
            "id": "sorcerer-18-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 18, Sorcerer characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "19": [
          {
            "id": "sorcerer-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Dimensional Travel is recommended.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ],
        "20": [
          {
            "id": "sorcerer-20-arcane-apotheosis",
            "name": "Arcane Apotheosis",
            "description": "While their Innate Sorcery feature is active, they can use one Metamagic option on each of their turns without spending Sorcery Points on it.",
            "source": "http://dnd2024.wikidot.com/sorcerer:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "sorcerer-aberrant-sorcery",
          "name": "Aberrant Sorcery",
          "description": "An alien influence has wrapped its tendrils around their mind, giving they psionic power. They can now touch other minds with that power and alter the world around them. Will this power shine from them as a hopeful beacon to others? Or will they be a terror to those who feel the stab of their mind?",
          "levelFeatures": {
            "3": [
              {
                "id": "aberrant-sorcery-3-psionic-spells",
                "name": "Psionic Spells",
                "description": "When they reach a Sorcerer level specified in the Psionic Spells table, they thereafter always have the listed spells prepared. Psionic Spells Sorcerer Level Spells 3 Arms of Hadar, Calm Emotions, Detect Thoughts, Dissonant Whispers, Mind Sliver 5 Hunger of Hadar, Sending 7 Evard's Black Tentacles, Summon Aberration 9 Rary's Telepathic Bond, Telekinesis",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              },
              {
                "id": "aberrant-sorcery-3-telepathic-speech",
                "name": "Telepathic Speech",
                "description": "They can form a telepathic connection between their mind and the mind of another. As a Bonus Action, choose one creature they can see within 30 feet of themselves. They and the chosen creature can communicate telepathically with each other while the two of them are within a number of miles of each other equal to their Charisma modifier (minimum of 1 mile). To understand each other, they each must mentally use a language the other knows.",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              }
            ],
            "6": [
              {
                "id": "aberrant-sorcery-6-psionic-sorcery",
                "name": "Psionic Sorcery",
                "description": "When they cast any level 1+ spell from their Psionic Spells feature, they can cast it by expending a spell slot as normal or by spending a number of Sorcery Points equal to the spell’s level. If they cast the spell using Sorcery Points, it requires no Verbal or Somatic components, and it requires no Material components unless they are consumed by the spell or have a cost specified in it.",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              },
              {
                "id": "aberrant-sorcery-6-psychic-defenses",
                "name": "Psychic Defenses",
                "description": "They have Resistance to Psychic damage, and they have Advantage on saving throws to avoid or end the Charmed or Frightened condition.",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              }
            ],
            "14": [
              {
                "id": "aberrant-sorcery-14-revelation-in-flesh",
                "name": "Revelation in Flesh",
                "description": "They can unleash the aberrant truth hidden within themselves. As a Bonus Action, they can spend 1 Sorcery Point or more to magically alter their body for 10 minutes. For each Sorcery Point they spend, they gain one of the following benefits of their choice, the effects of which last until the alteration ends.",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              }
            ],
            "18": [
              {
                "id": "aberrant-sorcery-18-warping-implosion",
                "name": "Warping Implosion",
                "description": "They can unleash a space-warping anomaly. As a Magic action, they teleport to an unoccupied space they can see within 120 feet of themselves. Immediately after they disappear, each creature within 30 feet of the space they left must make a Strength saving throw against their spell save DC.",
                "source": "http://dnd2024.wikidot.com/sorcerer:aberrant-sorcery"
              }
            ]
          }
        },
        {
          "id": "sorcerer-clockwork-sorcery",
          "name": "Clockwork Sorcery",
          "description": "The cosmic force of order has suffused they with magic. That power arises from Mechanus or a realm like it—a plane of existence shaped entirely by clockwork efficiency. They or someone from their lineage might have become entangled in the machinations of modrons, the orderly beings who inhabit Mechanus. Perhaps their ancestor even took part in the Great Modron March.",
          "levelFeatures": {
            "3": [
              {
                "id": "clockwork-sorcery-3-clockwork-spells",
                "name": "Clockwork Spells",
                "description": "When they reach a Sorcerer level specified in the Clockwork Spells table, they thereafter always have the listed spells prepared. Clockwork Spells Sorcerer Level Spells 3 Aid, Alarm, Lesser Restoration, Protection from Evil and Good 5 Dispel Magic, Protection from Energy 7 Freedom of Movement, Summon Construct 9 Greater Restoration, Wall of Force In addition, consult the Manifestations of Order table and choose or randomly determine a way their connection to order manifests while they are casting any of their…",
                "source": "http://dnd2024.wikidot.com/sorcerer:clockwork-sorcery"
              },
              {
                "id": "clockwork-sorcery-3-restore-balance",
                "name": "Restore Balance",
                "description": "Their connection to the plane of absolute order allows they to equalize chaotic moments. When a creature they can see within 60 feet of themselves is about to roll a d20 with Advantage or Disadvantage, they can take a Reaction to prevent the roll from being affected by Advantage and Disadvantage. They can use this feature a number of times equal to their Charisma modifier (minimum of once), and they regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/sorcerer:clockwork-sorcery"
              }
            ],
            "6": [
              {
                "id": "clockwork-sorcery-6-bastion-of-law",
                "name": "Bastion of Law",
                "description": "They can tap into the grand equation of existence to imbue a creature with a shimmering shield of order. As a Magic action, they can expend 1 to 5 Sorcery Points to create a magical ward around themselves or another creature they can see within 30 feet of themselves. The ward is represented by a number of d8s equal to the number of Sorcery Points spent to create it.",
                "source": "http://dnd2024.wikidot.com/sorcerer:clockwork-sorcery"
              }
            ],
            "14": [
              {
                "id": "clockwork-sorcery-14-trance-of-order",
                "name": "Trance of Order",
                "description": "They gain the ability to align their consciousness with the endless calculations of Mechanus. As a Bonus Action, they can enter this state for 1 minute. For the duration, attack rolls against them can’t benefit from Advantage, and whenever they make a D20 Test, they can treat a roll of 9 or lower on the d20 as a 10.",
                "source": "http://dnd2024.wikidot.com/sorcerer:clockwork-sorcery"
              }
            ],
            "18": [
              {
                "id": "clockwork-sorcery-18-clockwork-cavalcade",
                "name": "Clockwork Cavalcade",
                "description": "They momentarily summon spirits of order to expunge disorder around them. As a Magic action, they summon the spirits in a 30-foot Cube originating from them. The spirits look like modrons or other Constructs of their choice.",
                "source": "http://dnd2024.wikidot.com/sorcerer:clockwork-sorcery"
              }
            ]
          }
        },
        {
          "id": "sorcerer-draconic-sorcery",
          "name": "Draconic Sorcery",
          "description": "Their innate magic comes from the gift of a dragon. Perhaps an ancient dragon facing death bequeathed some of its magical power to them or their ancestor. They might have absorbed magic from a site infused with dragons’ power. Or perhaps they handled a treasure taken from a dragon’s hoard that was steeped in draconic power.",
          "levelFeatures": {
            "3": [
              {
                "id": "draconic-sorcery-3-draconic-resilience",
                "name": "Draconic Resilience",
                "description": "The magic in their body manifests physical traits of their draconic gift. their Hit Point maximum increases by 3, and it increases by 1 whenever they gain another Sorcerer level. Parts of them are also covered by dragon-like scales. While they aren’t wearing armor, their base Armor Class equals 10 plus their Dexterity and Charisma modifiers.",
                "source": "http://dnd2024.wikidot.com/sorcerer:draconic-sorcery"
              },
              {
                "id": "draconic-sorcery-3-draconic-spells",
                "name": "Draconic Spells",
                "description": "When they reach a Sorcerer level specified in the Draconic Spells table, they thereafter always have the listed spells prepared. Draconic Spells Sorcerer Level Spells 3 Alter Self, Chromatic Orb, Command, Dragon's Breath 5 Fear, Fly 7 Arcane Eye, Charm Monster 9 Legend Lore, Summon Dragon",
                "source": "http://dnd2024.wikidot.com/sorcerer:draconic-sorcery"
              }
            ],
            "6": [
              {
                "id": "draconic-sorcery-6-elemental-affinity",
                "name": "Elemental Affinity",
                "description": "Their draconic magic has an affinity with a damage type associated with dragons. Choose one of those types: Acid, Cold, Fire, Lightning, or Poison. They have Resistance to that damage type, and when they cast a spell that deals damage of that type, they can add their Charisma modifier to one damage roll of that spell.",
                "source": "http://dnd2024.wikidot.com/sorcerer:draconic-sorcery"
              }
            ],
            "14": [
              {
                "id": "draconic-sorcery-14-dragon-wings",
                "name": "Dragon Wings",
                "description": "As a Bonus Action, they can cause draconic wings to appear on their back. The wings last for 1 hour or until they dismiss them (no action required). For the duration, they have a Fly Speed of 60 feet.",
                "source": "http://dnd2024.wikidot.com/sorcerer:draconic-sorcery"
              }
            ],
            "18": [
              {
                "id": "draconic-sorcery-18-dragon-companion",
                "name": "Dragon Companion",
                "description": "They can cast Summon Dragon without a Material component. They can also cast it once without a spell slot, and they regain the ability to cast it in this way when they finish a Long Rest. Whenever they start casting the spell, they can modify it so that it doesn’t require Concentration. If they do so, the spell’s duration becomes 1 minute for that casting.",
                "source": "http://dnd2024.wikidot.com/sorcerer:draconic-sorcery"
              }
            ]
          }
        },
        {
          "id": "sorcerer-metamagic-options",
          "name": "Metamagic Options",
          "description": "The following options are available to their Metamagic feature. The options are presented in alphabetical order.",
          "levelFeatures": {
            "3": [
              {
                "id": "sorcerer-metamagic-options-features",
                "name": "Metamagic Options Features",
                "description": "The defining feature progression for the Metamagic Options subclass.",
                "source": "http://dnd2024.wikidot.com/sorcerer:metamagic"
              }
            ]
          }
        },
        {
          "id": "sorcerer-shadow-sorcery",
          "name": "Shadow Sorcery",
          "description": "Their innate magic comes from the most nebulous and inscrutable forces of the Shadowfell or from other regions of supernatural darkness. They might trace their lineage to an entity from such a place, or perhaps they were exposed to the sinister energy of a shadow dragon and were transformed by it. their shadowy magic allows they to command darkness, undeath, and woe.",
          "levelFeatures": {
            "3": [
              {
                "id": "shadow-sorcery-3-shadow-spells",
                "name": "Shadow Spells",
                "description": "When they reach a Sorcerer level specified in the Shadow Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/sorcerer:shadow-sorcery"
              },
              {
                "id": "shadow-sorcery-3-power-of-shadow",
                "name": "Power of Shadow",
                "description": "Eyes of the Dark. They have Darkvision with a range of 120 feet and Blindsight with a range of 10 feet. In addition, if a spell they cast creates an area of Darkness, they can see normally through that spell’s Darkness. Strength of the Grave.",
                "source": "http://dnd2024.wikidot.com/sorcerer:shadow-sorcery"
              }
            ],
            "6": [
              {
                "id": "shadow-sorcery-6-beasts-of-ill-omen",
                "name": "Beasts of Ill Omen",
                "description": "They can call forth a howling creature of shadow to hound their foes. They can spend 3 Sorcery Points to cast Summon Beast as a Bonus Action without expending a spell slot, without preparing the spell, and without Material components. The summoned creature appears as a beast made of shadow, and enemies within 5 feet of the summoned creature have Disadvantage on saving throws against spells they cast. Whenever they cast the spell, they can modify it so that it doesn’t require Concentration.",
                "source": "http://dnd2024.wikidot.com/sorcerer:shadow-sorcery"
              }
            ],
            "14": [
              {
                "id": "shadow-sorcery-14-shadow-walk",
                "name": "Shadow Walk",
                "description": "While they are in Dim Light or Darkness, they can take a Bonus Action to teleport up to 120 feet to an unoccupied space they can see that is also in Dim Light or Darkness.",
                "source": "http://dnd2024.wikidot.com/sorcerer:shadow-sorcery"
              }
            ],
            "18": [
              {
                "id": "shadow-sorcery-18-umbral-form",
                "name": "Umbral Form",
                "description": "When they use Innate Sorcery, they can adopt a shadowy form, gaining the benefits below while their Innate Sorcery is active or until they end the form (no action required). Once they use this feature, they can’t use it again until they finish a Long Rest unless they spend 6 Sorcery Points (no action required) to restore their use of it. Incorporeal Movement. They can move through creatures and objects as if they were Difficult Terrain, but they take 1d10 Force damage if they end their turn inside a creature or…",
                "source": "http://dnd2024.wikidot.com/sorcerer:shadow-sorcery"
              }
            ]
          }
        },
        {
          "id": "sorcerer-spellfire-sorcery",
          "name": "Spellfire Sorcery",
          "description": "Their innate power stems from the source of magic itself: the Weave. This connection manifests as a rare ability known as spellfire, and they surge with radiant bursts of this raw magic. their talent with spellfire allows they to heal allies, sear enemies, and absorb powerful spells.",
          "levelFeatures": {
            "3": [
              {
                "id": "spellfire-sorcery-3-spellfire-burst",
                "name": "Spellfire Burst",
                "description": "When they spend at least 1 Sorcery Point as part of a Magic action or a Bonus Action on their turn, they can unleash one of the following magical effects of their choice. They can do so only once per turn. Bolstering Flames. They or one creature they can see within 30 feet of themselves gains Temporary Hit Points equal to 1d4 plus their Charisma modifier. Radiant Fire.",
                "source": "http://dnd2024.wikidot.com/sorcerer:spellfire-sorcery"
              },
              {
                "id": "spellfire-sorcery-3-spellfire-spells",
                "name": "Spellfire Spells",
                "description": "When they reach a Sorcerer level specified in the Spellfire Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/sorcerer:spellfire-sorcery"
              }
            ],
            "6": [
              {
                "id": "spellfire-sorcery-6-absorb-spells",
                "name": "Absorb Spells",
                "description": "They always have Counterspell prepared. Additionally, whenever a target fails the saving throw against a Counterspell they cast, they regain 1d4 Sorcery Points.",
                "source": "http://dnd2024.wikidot.com/sorcerer:spellfire-sorcery"
              }
            ],
            "14": [
              {
                "id": "spellfire-sorcery-14-honed-spellfire",
                "name": "Honed Spellfire",
                "description": "Their Spellfire Burst improves. They add their Sorcerer level to the Temporary Hit Points gained from Bolstering Flames, and the damage of their Radiant Fire increases to 1d8.",
                "source": "http://dnd2024.wikidot.com/sorcerer:spellfire-sorcery"
              }
            ],
            "18": [
              {
                "id": "spellfire-sorcery-18-crown-of-spellfire",
                "name": "Crown of Spellfire",
                "description": "When they use Innate Sorcery, they can alter it and infuse themselves with the essence of spellfire, gaining the following benefits while this use of Innate Sorcery is active. Once they use this feature to alter Innate Sorcery, they can’t use it again until they finish a Long Rest unless they spend 5 Sorcery Points (no action required) to restore their use of it. Burning Life Force.",
                "source": "http://dnd2024.wikidot.com/sorcerer:spellfire-sorcery"
              }
            ]
          }
        },
        {
          "id": "sorcerer-wild-magic-sorcery",
          "name": "Wild Magic Sorcery",
          "description": "Their innate magic stems from the forces of chaos that underlie the order of creation. They or an ancestor might have endured exposure to raw magic, perhaps through a planar portal leading to Limbo or the Elemental Planes. Perhaps they were blessed by a fey being or marked by a demon. Or their magic could be a fluke with no apparent cause.",
          "levelFeatures": {
            "3": [
              {
                "id": "wild-magic-sorcery-3-wild-magic-surge",
                "name": "Wild Magic Surge",
                "description": "Their spellcasting can unleash surges of untamed magic. Once per turn, they can roll 1d20 immediately after they cast a Sorcerer spell with a spell slot. If they roll a 20, roll on the Wild Magic Surge table to create a magical effect.",
                "source": "http://dnd2024.wikidot.com/sorcerer:wild-magic-sorcery"
              },
              {
                "id": "wild-magic-sorcery-3-tides-of-chaos",
                "name": "Tides of Chaos",
                "description": "They can manipulate chaos itself to give themselves Advantage on one D20 Test before they roll the d20. Once they do so, they must cast a Sorcerer spell with a spell slot or finish a Long Rest before they can use this feature again. If they do cast a Sorcerer spell with a spell slot before they finish a Long Rest, they automatically roll on the Wild Magic Surge table.",
                "source": "http://dnd2024.wikidot.com/sorcerer:wild-magic-sorcery"
              }
            ],
            "6": [
              {
                "id": "wild-magic-sorcery-6-bend-luck",
                "name": "Bend Luck",
                "description": "They have the ability to twist fate using their wild magic. Immediately after another creature they can see rolls the d20 for a D20 Test, they can take a Reaction and spend 1 Sorcery Point to roll 1d4 and apply the number rolled as a bonus or penalty (their choice) to the d20 roll.",
                "source": "http://dnd2024.wikidot.com/sorcerer:wild-magic-sorcery"
              }
            ],
            "14": [
              {
                "id": "wild-magic-sorcery-14-controlled-chaos",
                "name": "Controlled Chaos",
                "description": "They gain a modicum of control over the surges of their wild magic. Whenever they roll on the Wild Magic Surge table, they can roll twice and use either number.",
                "source": "http://dnd2024.wikidot.com/sorcerer:wild-magic-sorcery"
              }
            ],
            "18": [
              {
                "id": "wild-magic-sorcery-18-tamed-surge",
                "name": "Tamed Surge",
                "description": "Immediately after they cast a Sorcerer spell with a spell slot, they can create an effect of their choice from the Wild Magic Surge table instead of rolling on that table. They can choose any effect in the table except for the final row, and if the chosen effect involves a roll, they must make it. Once they use this feature, they can’t do so again until they finish a Long Rest. Wild Magic Surge 1d100 Effect 01-04 Roll on this table at the start of each of their turns for the next minute, ignoring this result on…",
                "source": "http://dnd2024.wikidot.com/sorcerer:wild-magic-sorcery"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "stamina",
        "charisma"
      ]
    },
    {
      "id": "warlock",
      "name": "Warlock",
      "hitDie": 8,
      "primaryAbility": "charisma",
      "description": "Warlocks quest for knowledge that lies hidden in the fabric of the multiverse. They often begin their search for magical power by delving into tomes of forbidden lore, dabbling in invocations meant to attract the power of extraplanar beings, or seeking places of power where the influence of these beings can be felt. In no time, each Warlock is drawn into a binding pact with a powerful patron.",
      "levelFeatures": {
        "1": [
          {
            "id": "warlock-1-eldritch-invocations",
            "name": "Eldritch Invocations",
            "description": "They have unearthed Eldritch Invocations, pieces of forbidden knowledge that imbue they with an abiding magical ability or other lessons. They gain one invocation of their choice, such as Pact of the Tome. Invocations are described in the “Eldritch Invocation Options” section later in this class’s description. Prerequisites.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          },
          {
            "id": "warlock-1-pact-magic",
            "name": "Pact Magic",
            "description": "Through occult ceremony, they have formed a pact with a mysterious entity to gain magical powers. The entity is a voice in the shadows—its identity unclear—but its boon to them is concrete: the ability to cast spells. See chapter 7 for the rules on spellcasting.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "2": [
          {
            "id": "warlock-2-magical-cunning",
            "name": "Magical Cunning",
            "description": "They can perform an esoteric rite for 1 minute. At the end of it, they regain expended Pact Magic spell slots but no more than a number equal to half their maximum (round up). Once they use this feature, they can’t do so again until they finish a Long Rest.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "3": [
          {
            "id": "warlock-3-warlock-subclass",
            "name": "Warlock Subclass",
            "description": "They gain a Warlock subclass of their choice. The Archfey Patron, Celestial Patron, Fiend Patron, and Great Old One Patron subclasses are detailed after this class’s description. A subclass is a specialization that grants they features at certain Warlock levels.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "4": [
          {
            "id": "warlock-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Warlock levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "9": [
          {
            "id": "warlock-9-contact-patron",
            "name": "Contact Patron",
            "description": "In the past, they usually contacted their patron through intermediaries. Now they can communicate directly; they always have the Contact Other Plane spell prepared. With this feature, they can cast the spell without expending a spell slot to contact their patron, and they automatically succeed on the spell’s saving throw.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "11": [
          {
            "id": "warlock-11-mystic-arcanum",
            "name": "Mystic Arcanum",
            "description": "Their patron grants they a magical secret called an arcanum. Choose one level 6 Warlock spell as this arcanum. They can cast their arcanum spell once without expending a spell slot, and they must finish a Long Rest before they can cast it in this way again. As shown in the Warlock Features table, they gain another Warlock spell of their choice that can be cast in this way when they reach Warlock levels 13 (level 7 spell), 15 (level 8 spell), and 17 (level 9 spell). They regain all uses of their Mystic Arcanum…",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "19": [
          {
            "id": "warlock-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Fate is recommended.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ],
        "20": [
          {
            "id": "warlock-20-eldritch-master",
            "name": "Eldritch Master",
            "description": "When they use their Magical Cunning feature, they regain all their expended Pact Magic spell slots.",
            "source": "http://dnd2024.wikidot.com/warlock:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "warlock-archfey-patron",
          "name": "Archfey Patron",
          "description": "Their pact draws on the power of the Feywild. When they choose this subclass, they might make a deal with an archfey, such as the Prince of Frost; the Queen of Air and Darkness, ruler of the Gloaming Court; Titania of the Summer Court; or an ancient hag. Or they might call on a spectrum of Fey, weaving a web of favors and debts.",
          "levelFeatures": {
            "3": [
              {
                "id": "archfey-patron-3-archfey-spells",
                "name": "Archfey Spells",
                "description": "The magic of their patron ensures they always have certain spells ready; when they reach a Warlock level specified in the Archfey Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/warlock:archfey-patron"
              },
              {
                "id": "archfey-patron-3-steps-of-the-fey",
                "name": "Steps of the Fey",
                "description": "Their patron grants they the ability to move between the boundaries of the planes. They can cast Misty Step without expending a spell slot a number of times equal to their Charisma modifier (minimum of once), and they regain all expended uses when they finish a Long Rest. In addition, whenever they cast that spell, they can choose one of the following additional effects. Refreshing Step.",
                "source": "http://dnd2024.wikidot.com/warlock:archfey-patron"
              }
            ],
            "6": [
              {
                "id": "archfey-patron-6-misty-escape",
                "name": "Misty Escape",
                "description": "They can cast Misty Step as a Reaction in response to taking damage. In addition, the following effects are now among their Steps of the Fey options. Disappearing Step. They have the Invisible condition until the start of their next turn or until immediately after they make an attack roll, deal damage, or cast a spell.",
                "source": "http://dnd2024.wikidot.com/warlock:archfey-patron"
              }
            ],
            "10": [
              {
                "id": "archfey-patron-10-beguiling-defenses",
                "name": "Beguiling Defenses",
                "description": "Their patron teaches they how to guard their mind and body. They are immune to the Charmed condition. In addition, immediately after a creature they can see hits they with an attack roll, they can take a Reaction to reduce the damage they take by half (round down), and they can force the attacker to make a Wisdom saving throw against their spell save DC. On a failed save, the attacker takes Psychic damage equal to the damage they take.",
                "source": "http://dnd2024.wikidot.com/warlock:archfey-patron"
              }
            ],
            "14": [
              {
                "id": "archfey-patron-14-bewitching-magic",
                "name": "Bewitching Magic",
                "description": "Their patron grants they the ability to weave their magic with teleportation. Immediately after they cast an Enchantment or Illusion spell using an action and a spell slot, they can cast Misty Step as part of the same action and without expending a spell slot.",
                "source": "http://dnd2024.wikidot.com/warlock:archfey-patron"
              }
            ]
          }
        },
        {
          "id": "warlock-celestial-patron",
          "name": "Celestial Patron",
          "description": "Their pact draws on the Upper Planes, the realms of everlasting bliss. They might enter an agreement with an empyrean, a couatl, a sphinx, a unicorn, or another heavenly entity. Or they might call on numerous such beings as they pursue goals aligned with theirs. their pact allows they to experience a hint of the holy light that illuminates the multiverse.",
          "levelFeatures": {
            "3": [
              {
                "id": "celestial-patron-3-celestial-spells",
                "name": "Celestial Spells",
                "description": "The magic of their patron ensures they always have certain spells ready; when they reach a Warlock level specified in the Celestial Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/warlock:celestial-patron"
              },
              {
                "id": "celestial-patron-3-healing-light",
                "name": "Healing Light",
                "description": "They gain the ability to channel celestial energy to heal wounds. They have a pool of d6s to fuel this healing. The number of dice in the pool equals 1 plus their Warlock level. As a Bonus Action, they can heal themselves or one creature they can see within 60 feet of themselves, expending dice from the pool.",
                "source": "http://dnd2024.wikidot.com/warlock:celestial-patron"
              }
            ],
            "6": [
              {
                "id": "celestial-patron-6-radiant-soul",
                "name": "Radiant Soul",
                "description": "Their link to their patron allows they to serve as a conduit for radiant energy. They have Resistance to Radiant damage. Once per turn, when a spell they cast deals Radiant or Fire damage, they can add their Charisma modifier to that spell’s damage against one of the spell’s targets.",
                "source": "http://dnd2024.wikidot.com/warlock:celestial-patron"
              }
            ],
            "10": [
              {
                "id": "celestial-patron-10-celestial-resilience",
                "name": "Celestial Resilience",
                "description": "They gain Temporary Hit Points whenever they use their Magical Cunning feature or finish a Short or Long Rest. These Temporary Hit Points equal their Warlock level plus their Charisma modifier. Additionally, choose up to five creatures they can see when they gain the points.",
                "source": "http://dnd2024.wikidot.com/warlock:celestial-patron"
              }
            ],
            "14": [
              {
                "id": "celestial-patron-14-searing-vengeance",
                "name": "Searing Vengeance",
                "description": "When they or an ally within 60 feet of them is about to make a Death Saving Throw, they can unleash radiant energy to save the creature. The creature regains Hit Points equal to half its Hit Point maximum and can end the Prone condition on itself. Each creature of their choice that is within 30 feet of the creature takes Radiant damage equal to 2d8 plus their Charisma modifier, and each has the Blinded condition until the end of the current turn.",
                "source": "http://dnd2024.wikidot.com/warlock:celestial-patron"
              }
            ]
          }
        },
        {
          "id": "warlock-eldritch-invocation-options",
          "name": "Eldritch Invocation Options",
          "description": "Choose one of their known Warlock cantrips that deals damage. They can add their Charisma modifier to that spell’s damage rolls.",
          "levelFeatures": {
            "3": [
              {
                "id": "warlock-eldritch-invocation-options-features",
                "name": "Eldritch Invocation Options Features",
                "description": "The defining feature progression for the Eldritch Invocation Options subclass.",
                "source": "http://dnd2024.wikidot.com/warlock:eldritch-invocation"
              }
            ]
          }
        },
        {
          "id": "warlock-fiend-patron",
          "name": "Fiend Patron",
          "description": "Their pact draws on the Lower Planes, the realms of perdition. They might forge a bargain with a demon lord such as Demogorgon or Orcus; an archdevil such as Asmodeus; or a pit fiend, balor, yugoloth, or night hag that is especially mighty. That patron’s aims are evil—the corruption or destruction of all things, ultimately including they—and their path is defined by the extent to which they strive against those aims.",
          "levelFeatures": {
            "3": [
              {
                "id": "fiend-patron-3-dark-ones-blessing",
                "name": "Dark One’s Blessing",
                "description": "When they reduce an enemy to 0 Hit Points, they gain Temporary Hit Points equal to their Charisma modifier plus their Warlock level (minimum of 1 Temporary Hit Point). They also gain this benefit if someone else reduces an enemy within 10 feet of them to 0 Hit Points.",
                "source": "http://dnd2024.wikidot.com/warlock:fiend-patron"
              },
              {
                "id": "fiend-patron-3-fiend-spells",
                "name": "Fiend Spells",
                "description": "The magic of their patron ensures they always have certain spells ready; when they reach a Warlock level specified in the Fiend Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/warlock:fiend-patron"
              }
            ],
            "6": [
              {
                "id": "fiend-patron-6-dark-ones-own-luck",
                "name": "Dark One’s Own Luck",
                "description": "They can call on their fiendish patron to alter fate in their favor. When they make an ability check or a saving throw, they can use this feature to add 1d10 to their roll. They can do so after seeing the roll but before any of the roll’s effects occur. They can use this feature a number of times equal to their Charisma modifier (minimum of once), but they can use it no more than once per roll. They regain all expended uses when they finish a Long Rest.",
                "source": "http://dnd2024.wikidot.com/warlock:fiend-patron"
              }
            ],
            "10": [
              {
                "id": "fiend-patron-10-fiendish-resilience",
                "name": "Fiendish Resilience",
                "description": "Choose one damage type, other than Force, whenever they finish a Short or Long Rest. They have Resistance to that damage type until they choose a different one with this feature.",
                "source": "http://dnd2024.wikidot.com/warlock:fiend-patron"
              }
            ],
            "14": [
              {
                "id": "fiend-patron-14-hurl-through-hell",
                "name": "Hurl Through Hell",
                "description": "Once per turn when they hit a creature with an attack roll, they can try to instantly transport the target through the Lower Planes. The target must succeed on a Charisma saving throw against their spell save DC, or the target disappears and hurtles through a nightmare landscape. The target takes 8d10 Psychic damage if it isn’t a Fiend, and it has the Incapacitated condition until the end of their next turn, when it returns to the space it previously occupied or the nearest unoccupied space.",
                "source": "http://dnd2024.wikidot.com/warlock:fiend-patron"
              }
            ]
          }
        },
        {
          "id": "warlock-great-old-one-patron",
          "name": "Great Old One Patron",
          "description": "When they choose this subclass, they might bind themselves to an unspeakable being from the Far Realm or an elder god—a being such as Tharizdun, the Chained God; Zargon, the Returner; Hadar, the Dark Hunger; or Great Cthulhu. Or they might invoke several entities without yoking themselves to one. The motives of these beings are incomprehensible, and the Great Old One might be indifferent to their existence.",
          "levelFeatures": {
            "3": [
              {
                "id": "great-old-one-patron-3-awakened-mind",
                "name": "Awakened Mind",
                "description": "They can form a telepathic connection between their mind and the mind of another. As a Bonus Action, choose one creature they can see within 30 feet of themselves. They and the chosen creature can communicate telepathically with each other while the two of them are within a number of miles of each other equal to their Charisma modifier (minimum of 1 mile). To understand each other, they each must mentally use a language the other knows.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              },
              {
                "id": "great-old-one-patron-3-great-old-one-spells",
                "name": "Great Old One Spells",
                "description": "The magic of their patron ensures they always have certain spells ready; when they reach a Warlock level specified in the Great Old One Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              },
              {
                "id": "great-old-one-patron-3-psychic-spells",
                "name": "Psychic Spells",
                "description": "When they cast a Warlock spell that deals damage, they can change its damage type to Psychic. In addition, when they cast a Warlock spell that is an Enchantment or Illusion, they can do so without Verbal or Somatic components.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              }
            ],
            "6": [
              {
                "id": "great-old-one-patron-6-clairvoyant-combatant",
                "name": "Clairvoyant Combatant",
                "description": "When they form a telepathic bond with a creature using their Awakened Mind, they can force that creature to make a Wisdom saving throw against their spell save DC. On a failed save, the creature has Disadvantage on attack rolls against them, and they have Advantage on attack rolls against that creature for the duration of the bond. Once they use this feature, they can’t use it again until they finish a Short or Long Rest unless they expend a Pact Magic spell slot (no action required) to restore their use of it.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              }
            ],
            "10": [
              {
                "id": "great-old-one-patron-10-eldritch-hex",
                "name": "Eldritch Hex",
                "description": "Their alien patron grants they a powerful curse. They always have the Hex spell prepared. When they cast Hex and choose an ability, the target also has Disadvantage on saving throws of the chosen ability for the duration of the spell.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              },
              {
                "id": "great-old-one-patron-10-thought-shield",
                "name": "Thought Shield",
                "description": "Their thoughts can’t be read by telepathy or other means unless they allow it. They also have Resistance to Psychic damage, and whenever a creature deals Psychic damage to them, that creature takes the same amount of damage that they take.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              }
            ],
            "14": [
              {
                "id": "great-old-one-patron-14-create-thrall",
                "name": "Create Thrall",
                "description": "When they cast Summon Aberration, they can modify it so that it doesn’t require Concentration. If they do so, the spell’s duration becomes 1 minute for that casting, and when summoned, the Aberration has a number of Temporary Hit Points equal to their Warlock level plus their Charisma modifier. In addition, the first time each turn the Aberration hits a creature under the effect of their Hex, the Aberration deals extra Psychic damage to the target equal to the bonus damage of that spell.",
                "source": "http://dnd2024.wikidot.com/warlock:great-old-one-patron"
              }
            ]
          }
        },
        {
          "id": "warlock-undead-patron",
          "name": "Undead Patron",
          "description": "Defy Death for Profane Power they have made a pact with a creature that defies the cycle of life and death: a powerful lich, a vampire, or another entity of undeath. Having once been mortal, these ancient patrons know firsthand the paths of ambition and the routes past the doors of death. They eagerly share this profane knowledge and other secrets with those who work their will among the living.",
          "levelFeatures": {
            "3": [
              {
                "id": "undead-patron-3-form-of-dread",
                "name": "Form of Dread",
                "description": "As a Bonus Action, they transform into an avatar of their patron’s dreadful power, gaining the benefits below for 1 minute, until they have the Incapacitated condition, or until they end the form (no action required). They can transform a number of times equal to their Charisma modifier (minimum of once), and they regain all expended uses when they finish a Long Rest. Facsimile of Life. They gain Temporary Hit Points equal to 1d10 plus their Warlock level. Fearless Form. They have Immunity to the Frightened…",
                "source": "http://dnd2024.wikidot.com/warlock:undead-patron"
              },
              {
                "id": "undead-patron-3-undead-spells",
                "name": "Undead Spells",
                "description": "The magic of their patron ensures they always have certain spells ready; when they reach a Warlock level specified in the Undead Spells table, they thereafter always have the listed spells prepared.",
                "source": "http://dnd2024.wikidot.com/warlock:undead-patron"
              }
            ],
            "6": [
              {
                "id": "undead-patron-6-grave-touched",
                "name": "Grave Touched",
                "description": "Their patron’s powers have a profound effect on their body and magic, granting they the following benefits. Arcane Necrosis. Necrotic damage from their attacks, Warlock spells, and Warlock features ignores Resistance to Necrotic damage.",
                "source": "http://dnd2024.wikidot.com/warlock:undead-patron"
              }
            ],
            "10": [
              {
                "id": "undead-patron-10-necrotic-husk",
                "name": "Necrotic Husk",
                "description": "Their connection to undeath saturates their body. They gain the following benefits. Necrotic Resilience. They have Resistance to Necrotic damage. While using their Form of Dread, they have Immunity to Necrotic damage.",
                "source": "http://dnd2024.wikidot.com/warlock:undead-patron"
              }
            ],
            "14": [
              {
                "id": "undead-patron-14-superior-dread",
                "name": "Superior Dread",
                "description": "Their Form of Dread improves, granting they the following benefits while they are using it. Dread Resistance. They have Resistance to Bludgeoning, Piercing, and Slashing damage. Ghostly Flight. They have a Fly Speed equal to their Speed and can hover. They can move through creatures and objects as if they were Difficult Terrain, but they take 1d10 Force damage if they end their turn inside a creature or an object.",
                "source": "http://dnd2024.wikidot.com/warlock:undead-patron"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "spirit",
        "charisma"
      ]
    },
    {
      "id": "wizard",
      "name": "Wizard",
      "hitDie": 6,
      "primaryAbility": "intellect",
      "description": "Wizards are defined by their exhaustive study of magic's inner workings. They cast spells of explosive fire, arcing lightning, subtle deception, and spectacular transformations. Their magic conjures monsters from other planes of existence, glimpses the future, or forms protective barriers.",
      "levelFeatures": {
        "1": [
          {
            "id": "wizard-1-spellcasting",
            "name": "Spellcasting",
            "description": "As a student of arcane magic, they have learned to cast spells. See chapter 7 for the rules on spellcasting. The information below details how they use those rules with Wizard spells, which appear in the Wizard spell list later in the class’s description.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          },
          {
            "id": "wizard-1-ritual-adept",
            "name": "Ritual Adept",
            "description": "They can cast any spell as a Ritual if that spell has the Ritual tag and the spell is in their spellbook. They needn’t have the spell prepared, but they must read from the book to cast a spell in this way.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          },
          {
            "id": "wizard-1-arcane-recovery",
            "name": "Arcane Recovery",
            "description": "They can regain some of their magical energy by studying their spellbook. When they finish a Short Rest, they can choose expended spell slots to recover. The spell slots can have a combined level equal to no more than half their Wizard level (round up), and none of the slots can be level 6 or higher.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "2": [
          {
            "id": "wizard-2-scholar",
            "name": "Scholar",
            "description": "While studying magic, they also specialized in another field of study. Choose one of the following skills in which they have proficiency: Arcana, History, Investigation, Medicine, Nature, or Religion. They have Expertise in the chosen skill.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "3": [
          {
            "id": "wizard-3-wizard-subclass",
            "name": "Wizard Subclass",
            "description": "They gain a Wizard subclass of their choice. The Abjurer, Diviner, Evoker, and Illusionist subclasses are detailed after thi s class's description. A subclass is a specialization that grants they features at certain Wizard l evels.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "4": [
          {
            "id": "wizard-4-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "They gain the Ability Score Improvement feat or another feat of their choice for which they qualify. They gain this feature again at Wizard levels 8, 12, and 16.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "5": [
          {
            "id": "wizard-5-memorize-spell",
            "name": "Memorize Spell",
            "description": "Whenever they finish a Short Rest, they can study their spellbook and replace one of the level 1+ Wizard spells they have prepared for their Spellcasting feature with another level 1+ spell from the book.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "6": [
          {
            "id": "wizard-6-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 6, Wizard characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "8": [
          {
            "id": "wizard-8-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 8, Wizard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "10": [
          {
            "id": "wizard-10-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 10, Wizard characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "12": [
          {
            "id": "wizard-12-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 12, Wizard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "14": [
          {
            "id": "wizard-14-subclass-feature",
            "name": "Subclass feature",
            "description": "At level 14, Wizard characters gain Subclass feature.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "16": [
          {
            "id": "wizard-16-ability-score-improvement",
            "name": "Ability Score Improvement",
            "description": "At level 16, Wizard characters gain Ability Score Improvement.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "18": [
          {
            "id": "wizard-18-spell-mastery",
            "name": "Spell Mastery",
            "description": "They have achieved such mastery over certain spells that they can cast them at will. Choose a level 1 and a level 2 spell in their spellbook that have a casting time of an action. They always have those spells prepared, and they can cast them at their lowest level without expending a spell slot. To cast either spell at a higher level, they must expend a spell slot.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "19": [
          {
            "id": "wizard-19-epic-boon",
            "name": "Epic Boon",
            "description": "They gain an Epic Boon feat or another feat of their choice for which they qualify. Boon of Spell Recall is recommended.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ],
        "20": [
          {
            "id": "wizard-20-signature-spells",
            "name": "Signature Spells",
            "description": "Choose two level 3 spells in their spellbook as their signature spells. They always have these spells prepared, and they can cast each of them once at level 3 without expending a spell slot. When they do so, they can't cast them in this way again until they finish a Short or Long Rest. To cast either spell at a higher level, they must expend a spell slot.",
            "source": "http://dnd2024.wikidot.com/wizard:main"
          }
        ]
      },
      "subclasses": [
        {
          "id": "wizard-abjurer",
          "name": "Abjurer",
          "description": "Shield Companions and Banish Foes their study of magic is focused on spells that block, banish, or protect—ending harmful effects, banishing evil influences, and protecting the weak. Abjurers are sought when baleful spirits require exorcism, when locations must be guarded against magical spying, and when portals to other planes of existence must be closed. Adventuring parties value Abjurers for the protection they provide against a variety of hostile magic and other attacks.",
          "levelFeatures": {
            "3": [
              {
                "id": "abjurer-3-abjuration-savant",
                "name": "Abjuration Savant",
                "description": "Choose two Wizard spells from the Abjuration school, each of which must be no higher than level 2, and add them to their spellbook for free. In addition, whenever they gain access to a new level of spell slots in this class, they can add one Wizard spell from the Abjuration school to their spellbook for free. The chosen spell must be of a level for which they have spell slots.",
                "source": "http://dnd2024.wikidot.com/wizard:abjurer"
              },
              {
                "id": "abjurer-3-arcane-ward",
                "name": "Arcane ward",
                "description": "They can weave magic around themselves for protection. When they cast an Abjuration spell with a spell slot, they can simultaneously use a strand of the spell's magic to create a magical ward on themselves that lasts until they finish a Long Rest. The ward has a Hit Point maximum equal to twice their Wizard level plus their Intelligence modifier.",
                "source": "http://dnd2024.wikidot.com/wizard:abjurer"
              }
            ],
            "6": [
              {
                "id": "abjurer-6-projected-ward",
                "name": "Projected Ward",
                "description": "When a creature that they can see within 30 feet of themselves takes damage, they can take a Reaction to cause their Arcane Ward to absorb that damage. If this damage reduces the ward to 0 Hit Points, the warded creature takes any remaining damage. If that creature has any Resistances or Vulnerabilities, apply them before reducing the ward's Hit Points.",
                "source": "http://dnd2024.wikidot.com/wizard:abjurer"
              }
            ],
            "10": [
              {
                "id": "abjurer-10-spell-breaker",
                "name": "Spell Breaker",
                "description": "They always have the Counterspell and Dispel Magic spells prepared. In addition, they can cast Dispel Magic as a Bonus Action, and they can add their Proficiency Bonus to its ability check. When they cast either spell with a spell slot, that slot isn't expended if the spell fails to stop a spell.",
                "source": "http://dnd2024.wikidot.com/wizard:abjurer"
              }
            ],
            "14": [
              {
                "id": "abjurer-14-spell-resistance",
                "name": "Spell Resistance",
                "description": "They have Advantage on saving throws against spells, and they have Resistance to the damage of spells.",
                "source": "http://dnd2024.wikidot.com/wizard:abjurer"
              }
            ]
          }
        },
        {
          "id": "wizard-bladesinger",
          "name": "Bladesinger",
          "description": "Bladesingers master a tradition of wizardry that incorporates swordplay and dance. In combat, a Bladesinger uses intricate, elegant maneuvers that fend off harm and allow the Bladesinger to channel magic into devastating attacks and a cunning defense. Many who have observed a Bladesinger at work remember the display as one of the more beautiful experiences in their life—a glorious dance accompanied by a singing blade.",
          "levelFeatures": {
            "3": [
              {
                "id": "bladesinger-3-bladesong",
                "name": "Bladesong",
                "description": "As a Bonus Action, they invoke an elven magic called the Bladesong, provided they aren’t wearing armor or using a Shield. The Bladesong lasts for 1 minute and ends early if they have the Incapacitated condition, if they don armor or a Shield, or if they use two hands to make an attack with a weapon. They can dismiss the Bladesong at any time (no action required). While the Bladesong is active, they gain the following benefits. They can invoke the Bladesong a number of times equal to their Intelligence modifier…",
                "source": "http://dnd2024.wikidot.com/wizard:bladesinger"
              },
              {
                "id": "bladesinger-3-training-in-war-and-song",
                "name": "Training in War and Song",
                "description": "They gain proficiency with all Melee Martial weapons that don’t have the Two-Handed or Heavy property. They can use a Melee weapon with which they have proficiency as a Spellcasting Focus for their Wizard spells. They also gain proficiency in one of the following skills of their choice: Acrobatics, Athletics, Performance, or Persuasion.",
                "source": "http://dnd2024.wikidot.com/wizard:bladesinger"
              }
            ],
            "6": [
              {
                "id": "bladesinger-6-extra-attack",
                "name": "Extra Attack",
                "description": "They can attack twice, instead of once, whenever they take the Attack action on their turn. Moreover, they can cast one of their Wizard cantrips that has a casting time of an action in place of one of those attacks.",
                "source": "http://dnd2024.wikidot.com/wizard:bladesinger"
              }
            ],
            "10": [
              {
                "id": "bladesinger-10-song-of-defense",
                "name": "Song of Defense",
                "description": "When they take damage while their Bladesong is active, they can take a Reaction to expend one spell slot and reduce the damage taken by an amount equal to five times the spell slot’s level.",
                "source": "http://dnd2024.wikidot.com/wizard:bladesinger"
              }
            ],
            "14": [
              {
                "id": "bladesinger-14-song-of-victory",
                "name": "Song of Victory",
                "description": "After they cast a spell that has a casting time of an action, they can make one attack with a weapon as a Bonus Action.",
                "source": "http://dnd2024.wikidot.com/wizard:bladesinger"
              }
            ]
          }
        },
        {
          "id": "wizard-diviner",
          "name": "Diviner",
          "description": "Learn the Secrets of the Multiverse The counsel of a Diviner is sought by those who want a clearer understanding of the past, present, and future. As a Diviner, they strive to part the veils of space, time, and consciousness. They work to master spells of discernment, remote viewing, supernatural knowledge, and foresight.",
          "levelFeatures": {
            "3": [
              {
                "id": "diviner-3-divination-savant",
                "name": "Divination Savant",
                "description": "Choose two Wizard spells from the Divination school, each of which must be no higher than level 2, and add them to their spellbook for free. In addition, whenever they gain access to a new level of spell slots in this class, they can add one Wizard spell from the Divination school to their spellbook for free. The chosen spell must be of a level for which they have spell slots.",
                "source": "http://dnd2024.wikidot.com/wizard:diviner"
              },
              {
                "id": "diviner-3-portent",
                "name": "Portent",
                "description": "Glimpses of the future begin to press on their awareness. Whenever they finish a Long Rest, roll two d20s and record the numbers rolled. They can replace any D20 Test made by they or a creature that they can see with one of these foretelling rolls. They must choose to do so before the roll, and they can replace a roll in this way only once per turn. Each foretelling roll can be used only once.",
                "source": "http://dnd2024.wikidot.com/wizard:diviner"
              }
            ],
            "6": [
              {
                "id": "diviner-6-expert-divination",
                "name": "Expert Divination",
                "description": "Casting Divination spells comes so easily to them that it expends only a fraction of their spellcasting efforts. When they cast a Divination spell using a level 2+ spell slot, they regain one expended spell slot. The slot they regain must be of a level lower than the slot they expended and can't be higher than level 5.",
                "source": "http://dnd2024.wikidot.com/wizard:diviner"
              }
            ],
            "10": [
              {
                "id": "diviner-10-the-third-eye",
                "name": "The Third Eye",
                "description": "They can increase their powers of perception. As a Bonus Action, choose one of the following benefits, which lasts until they start a Short or Long Rest. They can't use this feature again until they finish a Short or Long Rest. Darkvision. They gain Darkvision with a range of 120 feet.",
                "source": "http://dnd2024.wikidot.com/wizard:diviner"
              }
            ],
            "14": [
              {
                "id": "diviner-14-greater-portent",
                "name": "Greater Portent",
                "description": "The visions in their dreams intensify and paint a more accurate picture in their mind of what is to come. Roll three d20s for their Portent feature rather than two.",
                "source": "http://dnd2024.wikidot.com/wizard:diviner"
              }
            ]
          }
        },
        {
          "id": "wizard-evoker",
          "name": "Evoker",
          "description": "Create Explosive Elemental Effects their studies focus on magic that creates powerful elemental effects such as bitter cold, searing flame, rolling thunder, crackling lightning, and burning acid. Some Evokers find employment in military forces, serving as artillery to blast armies from afar. Others use their power to protect others, while some seek their own gain.",
          "levelFeatures": {
            "3": [
              {
                "id": "evoker-3-evocation-savant",
                "name": "Evocation Savant",
                "description": "Choose two Wizard spells from the Evocation school, each of which must be no higher than level 2, and add them to their spellbook for free. In addition, whenever they gain access to a new level of spell slots in this class, they can add one Wizard spell from the Evocation school to their spellbook for free. The chosen spell must be of a level for which they have spell slots.",
                "source": "http://dnd2024.wikidot.com/wizard:evoker"
              },
              {
                "id": "evoker-3-potent-cantrip",
                "name": "Potent Cantrip",
                "description": "Their damaging cantrips affect even creatures that avoid the brunt of the effect. When they cast a cantrip at a creature and they miss with the attack roll or the target succeeds on a saving throw against the cantrip, the target takes half the cantrip’s damage (if any) but suffers no additional effect from the cantrip.",
                "source": "http://dnd2024.wikidot.com/wizard:evoker"
              }
            ],
            "6": [
              {
                "id": "evoker-6-sculpt-spells",
                "name": "Sculpt Spells",
                "description": "They can create pockets of relative safety within the effects of their evocations. When they cast an Evocation spell that affects other creatures that they can see, they can choose a number of them equal to 1 plus the spell's level. The chosen creatures automatically succeed on their saving throws against the spell, and they take no damage if they would normally take half damage on a successful save.",
                "source": "http://dnd2024.wikidot.com/wizard:evoker"
              }
            ],
            "10": [
              {
                "id": "evoker-10-empowered-evocation",
                "name": "Empowered Evocation",
                "description": "Whenever they cast a Wizard spell from the Evocation school, they can add their Intelligence modifier to one damage roll of that spell.",
                "source": "http://dnd2024.wikidot.com/wizard:evoker"
              }
            ],
            "14": [
              {
                "id": "evoker-14-overchannel",
                "name": "Overchannel",
                "description": "They can increase the power of their spells. When they cast a Wizard spell with a spell slot of levels 1-5 that deals damage, they can deal maximum damage with that spell on the turn they cast it. The first time they do so, they suffer no adverse effect.",
                "source": "http://dnd2024.wikidot.com/wizard:evoker"
              }
            ]
          }
        },
        {
          "id": "wizard-illusionist",
          "name": "Illusionist",
          "description": "Weave Subtle Spells of Deception they specialize in magic that dazzles the senses and tricks the mind, and the illusions they craft make the impossible seem real.",
          "levelFeatures": {
            "3": [
              {
                "id": "illusionist-3-illusion-savant",
                "name": "Illusion Savant",
                "description": "Choose two Wizard spells from the Illusion school, each of which must be no higher than level 2, and add them to their spellbook for free. In addition, whenever they gain access to a new level of spell slots in this class, they can add one Wizard spell from the Illusion school to their spellbook for free. The chosen spell must be of a level for which they have spell slots.",
                "source": "http://dnd2024.wikidot.com/wizard:illusionist"
              },
              {
                "id": "illusionist-3-improved-illusions",
                "name": "Improved Illusions",
                "description": "They can cast Illusion spells without providing Verbal components, and if an Illusion spell they cast has a range of 10+ feet, the range increases by 60 feet. They also know the Minor Illusion cantrip. If they already know it, they learn a different Wizard cantrip of their choice. The cantrip doesn’t count against their number of cantrips known. They can create both a sound and an image with a single casting of Minor Illusion, and they can cast it as a Bonus Action.",
                "source": "http://dnd2024.wikidot.com/wizard:illusionist"
              }
            ],
            "6": [
              {
                "id": "illusionist-6-phantasmal-creatures",
                "name": "Phantasmal Creatures",
                "description": "They always have the Summon Beast and Summon Fey spells prepared. Whenever they cast either spell, they can change its school to Illusion, which causes the summoned creature to appear spectral. They can cast the Illusion version of each spell without expending a spell slot, but casting it without a slot halves the creature’s Hit Points. Once they cast either spell without a spell slot, they must finish a Long Rest before they can cast the spell in that way again.",
                "source": "http://dnd2024.wikidot.com/wizard:illusionist"
              }
            ],
            "10": [
              {
                "id": "illusionist-10-illusory-self",
                "name": "Illusory Self",
                "description": "When a creature hits they with an attack roll, they can take a Reaction to interpose an illusory duplicate of themselves between the attacker and themselves. The attack automatically misses they, then the illusion dissipates. Once they use this feature, they can't use it again until they finish a Short or Long Rest. They can also restore their use of it by expending a level 2+ spell slot (no action required).",
                "source": "http://dnd2024.wikidot.com/wizard:illusionist"
              }
            ],
            "14": [
              {
                "id": "illusionist-14-illusory-reality",
                "name": "Illusory Reality",
                "description": "They have learned to weave shadow magic into their illusions to give them a semi-reality. When they cast an Illusion spell with a spell slot, they can choose one inanimate, nonmagical object that is part of the illusion and make that object real. They can do this on their turn as a Bonus Action while the spell is ongoing. The object remains real for 1 minute, during which it can't deal damage or give any conditions.",
                "source": "http://dnd2024.wikidot.com/wizard:illusionist"
              }
            ]
          }
        }
      ],
      "savingThrowProficiencies": [
        "intellect",
        "spirit"
      ]
    }
  ],
