    {
      "id": "dead-magic-dweller",
      "name": "Dead Magic Dweller",
      "skills": [
        "Medicine",
        "Survival"
      ],
      "abilityOptions": [
        "strength",
        "stamina",
        "spirit"
      ],
      "featId": "healer",
