  "ancestries": [
    {
      "id": "aasimar",
      "name": "Aasimar",
      "speed": 30,
      "traits": [
        {
          "id": "aasimar-celestial-resistance",
          "name": "Celestial Resistance",
          "description": "They have Resistance to Necrotic damage and Radiant damage.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-healing-hands",
          "name": "Healing Hands",
          "description": "As a Magic action, they touch a creature and roll a number of d4s equal to their Proficiency Bonus. The creature regains a number of Hit Points equal to the total rolled. Once they use this trait, they can't use it again until they finish a Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-light-bearer",
          "name": "Light Bearer",
          "description": "They know the Light cantrip. Charisma is their spellcasting ability for it.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-celestial-revelation",
          "name": "Celestial Revelation",
          "description": "When they reach character level 3, they can transform as a Bonus Action using one of the options below (choose the option each time they transform). The transformation lasts for 1 minute or until they end it (no action required). Once they transform, they can’t do so again until they finish a Long Rest.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-heavenly-wings",
          "name": "Heavenly Wings",
          "description": "Here are the transformation options: Heavenly Wings. Two spectral wings sprout from their back temporarily. Until the transformation ends, they have a Fly Speed equal to their Speed.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-inner-radiance",
          "name": "Inner Radiance",
          "description": "Searing light temporarily radiates from their eyes and mouth. For the duration, they shed Bright Light in a 10-foot radius and Dim Light for an additional 10 feet, and at the end of each of their turns, each creature within 10 feet of them takes Radiant damage equal to their Proficiency Bonus.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        },
        {
          "id": "aasimar-necrotic-shroud",
          "name": "Necrotic Shroud",
          "description": "Their eyes briefly become pools of darkness, and flightless wings sprout from their back temporarily. Creatures other than their allies within 10 feet of them must succeed on a Charisma saving throw (DC 8 plus their Charisma modifier and Proficiency Bonus) or have the Frightened condition until the end of their next turn.",
          "source": "http://dnd2024.wikidot.com/species:aasimar"
        }
      ]
    },
    {
      "id": "boggart",
      "name": "Boggart",
      "speed": 30,
      "traits": [
        {
          "id": "boggart-darkvision",
          "name": "Darkvision",
          "description": "They can see in dim light within 60 feet of them as if it were bright light and in darkness as if it were dim light. They discern colors in that darkness only as shades of gray.",
          "source": "http://dnd2024.wikidot.com/species:boggart"
        },
        {
          "id": "boggart-fey-ancestry",
          "name": "Fey Ancestry",
          "description": "They have advantage on saving throws they make to avoid or end the charmed condition on themselves.",
          "source": "http://dnd2024.wikidot.com/species:boggart"
        },
        {
          "id": "boggart-fury-of-the-small",
          "name": "Fury of the Small",
          "description": "When they damage a creature with an attack or a spell and the creature’s size is larger than theirs, they can cause the attack or spell to deal extra damage to the creature. The extra damage equals their proficiency bonus. They can use this trait a number of times equal to their proficiency bonus, regaining all expended uses when they finish a long rest, and they can use it no more than once per turn.",
          "source": "http://dnd2024.wikidot.com/species:boggart"
        },
        {
          "id": "boggart-nimble-escape",
          "name": "Nimble Escape",
          "description": "They can take the Disengage or Hide action as a bonus action on each of their turns.",
          "source": "http://dnd2024.wikidot.com/species:boggart"
        }
      ]
    },
    {
      "id": "changeling",
      "name": "Changeling",
      "speed": 30,
      "traits": [
        {
          "id": "changeling-changeling-instincts",
          "name": "Changeling Instincts",
          "description": "Thanks to their connection to the fey realm, they gain proficiency in two of the following skills of their choice: Deception, Insight, Intimidation, Performance, or Persuasion.",
          "source": "http://dnd2024.wikidot.com/species:changeling"
        },
        {
          "id": "changeling-shape-shifter",
          "name": "Shape-Shifter",
          "description": "As an action, they can shape-shift to change their appearance and their voice. They determine the specifics of the changes, including their coloration, hair length, and sex. They can also adjust their height and weight and can change their size between Medium and Small. They can make themselves appear as a member of another playable species, though none of their game statistics change. They can’t duplicate the appearance of an individual they have never seen, and they must adopt a form that has the same basic…",
          "source": "http://dnd2024.wikidot.com/species:changeling"
        }
      ]
    },
    {
      "id": "dhampir",
      "name": "Dhampir",
      "speed": 35,
      "traits": [
        {
          "id": "dhampir-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        },
        {
          "id": "dhampir-spider-climb",
          "name": "Spider Climb",
          "description": "They have a Climb Speed equal to their Speed. When they reach character level 3, they can move up, down, and across vertical surfaces and along ceilings while leaving their hands free.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        },
        {
          "id": "dhampir-trace-of-undeath",
          "name": "Trace of Undeath",
          "description": "They have Resistance to Necrotic damage.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        },
        {
          "id": "dhampir-vampiric-bite",
          "name": "Vampiric Bite",
          "description": "When they use their Unarmed Strike and deal damage, they can choose to bite with their fangs. They deal Piercing damage equal to 1d4 plus their Constitution modifier instead of the normal damage of an Unarmed Strike.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        },
        {
          "id": "dhampir-drain",
          "name": "Drain",
          "description": "They regain Hit Points equal to the Piercing damage dealt.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        },
        {
          "id": "dhampir-strengthen",
          "name": "Strengthen",
          "description": "They gain a bonus to the next ability check or attack roll they make within the next minute; the bonus is equal to the Piercing damage dealt.",
          "source": "http://dnd2024.wikidot.com/species:dhampir"
        }
      ]
    },
    {
      "id": "dragonborn",
      "name": "Dragonborn",
      "speed": 30,
      "traits": [
        {
          "id": "dragonborn-draconic-ancestry",
          "name": "Draconic Ancestry",
          "description": "Their lineage stems from a dragon progenitor. Choose the kind of dragon from the Draconic Ancestors table. their choice affects their Breath Weapon and Damage Resistance traits as well as their appearance.",
          "source": "http://dnd2024.wikidot.com/species:dragonborn"
        },
        {
          "id": "dragonborn-breath-weapon",
          "name": "Breath Weapon",
          "description": "When they take the Attack action on their turn, they can replace one of their attacks with an exhalation of magical energy in either a 15-foot Cone or a 30-foot Line that is 5 feet wide (choose the shape each time). Each creature in that area must make a Dexterity saving throw (DC 8 plus their Constitution modifier and Proficiency Bonus). On a failed save, a creature takes 1d10 damage of the type determined by their Draconic Ancestry trait.",
          "source": "http://dnd2024.wikidot.com/species:dragonborn"
        },
        {
          "id": "dragonborn-damage-resistance",
          "name": "Damage Resistance",
          "description": "They have Resistance to the damage type determined by their Draconic Ancestry trait.",
          "source": "http://dnd2024.wikidot.com/species:dragonborn"
        },
        {
          "id": "dragonborn-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:dragonborn"
        },
        {
          "id": "dragonborn-draconic-flight",
          "name": "Draconic Flight",
          "description": "When they reach character level 5, they can channel draconic magic to give themselves temporary flight. As a Bonus Action, they sprout spectral wings on their back that last for 10 minutes or until they retract the wings (no action required) or have the Incapacitated condition. During that time, they have a Fly Speed equal to their Speed. their wings appear to be made of the same energy as their Breath Weapon.",
          "source": "http://dnd2024.wikidot.com/species:dragonborn"
        }
      ]
    },
    {
      "id": "dwarf",
      "name": "Dwarf",
      "speed": 30,
      "traits": [
        {
          "id": "dwarf-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 120 feet.",
          "source": "http://dnd2024.wikidot.com/species:dwarf"
        },
        {
          "id": "dwarf-dwarven-resilience",
          "name": "Dwarven Resilience",
          "description": "They have Resistance to Poison damage. They also have Advantage on saving throws they make to avoid or end the Poisoned condition.",
          "source": "http://dnd2024.wikidot.com/species:dwarf"
        },
        {
          "id": "dwarf-dwarven-toughness",
          "name": "Dwarven Toughness",
          "description": "Their Hit Point maximum increases by 1, and it increases by 1 again whenever they gain a level.",
          "source": "http://dnd2024.wikidot.com/species:dwarf"
        },
        {
          "id": "dwarf-stonecunning",
          "name": "Stonecunning",
          "description": "As a Bonus Action, they gain Tremorsense with a range of 60 feet for 10 minutes. They must be on a stone surface or touching a stone surface to use this Tremorsense. The stone can be natural or worked.",
          "source": "http://dnd2024.wikidot.com/species:dwarf"
        }
      ]
    },
    {
      "id": "elf",
      "name": "Elf",
      "speed": 30,
      "traits": [
        {
          "id": "elf-darkvision",
          "name": "Darkvision",
          "description": "They have Darkvision with a range of 60 feet.",
          "source": "http://dnd2024.wikidot.com/species:elf"
        },
        {
          "id": "elf-elven-lineage",
          "name": "Elven Lineage",
          "description": "They are part of a lineage that grants they supernatural abilities. Choose a lineage from the Elven Lineages table. They gain the level 1 benefit of that lineage.",
          "source": "http://dnd2024.wikidot.com/species:elf"
        },
        {
          "id": "elf-fey-ancestry",
          "name": "Fey Ancestry",
          "description": "They have Advantage on saving throws they make to avoid or end the Charmed condition.",
          "source": "http://dnd2024.wikidot.com/species:elf"
        },
        {
          "id": "elf-keen-senses",
          "name": "Keen Senses",
          "description": "They have proficiency in the Insight, Perception, or Survival skill.",
          "source": "http://dnd2024.wikidot.com/species:elf"
        },
        {
          "id": "elf-trance",
          "name": "Trance",
          "description": "They don't need to sleep, and magic can't put them to sleep. They can finish a Long Rest in 4 hours if they spend those hours in a trancelike meditation, during which they retain consciousness.",
          "source": "http://dnd2024.wikidot.com/species:elf"
        }
      ]
    },
    {
      "id": "faerie",
      "name": "Faerie",
      "speed": 30,
      "traits": [
        {
          "id": "faerie-fairy-magic",
          "name": "Fairy Magic",
          "description": "They know the Druidcraft cantrip.",
          "source": "http://dnd2024.wikidot.com/species:faerie"
        },
        {
          "id": "faerie-flight",
          "name": "Flight",
          "description": "Because of their wings, they have a flying speed equal to their walking speed. They can’t use this flying speed if they are wearing medium or heavy armor.",
          "source": "http://dnd2024.wikidot.com/species:faerie"
        }
      ]
    },
    {
      "id": "flamekin",
      "name": "Flamekin",
      "speed": 30,
      "traits": [
        {
          "id": "flamekin-darkvision",
          "name": "Darkvision",
          "description": "They can see in dim light within 60 feet of them as if it were bright light and in darkness as if it were dim light. They discern colors in that darkness only as shades of gray.",
          "source": "http://dnd2024.wikidot.com/species:flamekin"
