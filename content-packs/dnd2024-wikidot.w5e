  "feats": [
    {
      "id": "aberrant-anatomy",
      "name": "Aberrant Anatomy",
      "category": "Dark Gift",
      "description": "Breathless: They can hold their breath for 1 hour. Extrasensory Perception: They have proficiency in the Perception skill, if they lack it. They also gain Expertise in that skill.",
      "source": "http://dnd2024.wikidot.com/feat:aberrant-anatomy"
    },
    {
      "id": "aberrant-dragonmark",
      "name": "Aberrant Dragonmark",
      "category": "Dragonmark",
      "description": "Aberrant Fortitude: When they fail a Constitution saving throw, they can take a Reaction to roll 1d4 and add the number rolled to the save, potentially turning the failure into a success. Once they have used this benefit, they can’t use it again until they finish a Long Rest. Aberrant Magic: They know one cantrip of their choice from the Sorcerer spell list.",
      "source": "http://dnd2024.wikidot.com/feat:aberrant-dragonmark"
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "category": "General",
      "description": "Repeatable: They can take this feat more than once.",
      "source": "http://dnd2024.wikidot.com/feat:ability-score-improvement"
    },
    {
      "id": "actor",
      "name": "Actor",
      "category": "General",
      "description": "Ability Score Increase: Increase their Charisma score by 1, to a maximum of 20. Impersonation: While they are disguised as a real or fictional person, they have Advantage on Charisma (Deception or Performance) checks to convince others that they are that person. Mimicry: They can mimic the sounds of other creatures, including speech.",
      "source": "http://dnd2024.wikidot.com/feat:actor"
    },
    {
      "id": "alert",
      "name": "Alert",
      "category": "Origin",
      "description": "Initiative Proficiency: When they roll Initiative, they can add their Proficiency Bonus to the roll. Initiative Swap: Immediately after they roll Initiative, they can swap their Initiative with the Initiative of one willing ally in the same combat. They can't make this swap if they or the ally has the Incapacitated condition.",
      "source": "http://dnd2024.wikidot.com/feat:alert"
    },
    {
      "id": "archery",
      "name": "Archery",
      "category": "Fighting Style",
      "description": "They gain a +2 bonus to attack rolls they make with Ranged weapons.",
      "source": "http://dnd2024.wikidot.com/feat:archery"
    },
    {
      "id": "athlete",
      "name": "Athlete",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Climb Speed: They gain a Climb Speed equal to their Speed. Hop Up: When they have the Prone condition, they can right themselves with only 5 feet of movement.",
      "source": "http://dnd2024.wikidot.com/feat:athlete"
    },
    {
      "id": "blind-fighting",
      "name": "Blind Fighting",
      "category": "Fighting Style",
      "description": "BLIND Fw:,·n N G Fighting Style Feat (Prerequisite: Fighting Style Feature) they hav e Blindsight with a range of 10 feet.",
      "source": "http://dnd2024.wikidot.com/feat:blind-fighting"
    },
    {
      "id": "bloodlust",
      "name": "Bloodlust",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength, Dexterity, or Constitution score by 1, to a maximum of 20. Powerful Recovery: When they roll a Hit Point Die to regain Hit Points, they can treat any roll of 1 or 2 as a 3. Sanguine Feast: Once per turn when they hit a Bloodied creature that isn’t a Construct or Undead with an attack roll, they can expend a Hit Point Die, roll it, and regain a number of Hit Points equal to the number rolled plus their Constitution modifier.",
      "source": "http://dnd2024.wikidot.com/feat:bloodlust"
    },
    {
      "id": "bomber",
      "name": "Bomber",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity score by 1, to a maximum of 20. Far Lobber: When they use the Attack action to throw a vial or flask, they can target an object or creature they can see within 40 feet of themselves. Long Shots: Attacking at long range doesn’t impose Disadvantage on their attack rolls with Thrown weapons.",
      "source": "http://dnd2024.wikidot.com/feat:bomber"
    },
    {
      "id": "boon-of-blazing-dawn",
      "name": "Boon of Blazing Dawn",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Beloved of the Sun: They have Immunity to Radiant damage. Blazing Strike: When they hit a creature with a weapon attack, the damage can be Radiant or the weapon’s normal damage type (their choice).",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-blazing-dawn"
    },
    {
      "id": "boon-of-bloodshed",
      "name": "Boon of Bloodshed",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Killer’s Fortune: When an enemy they can see is reduced to 0 Hit Points, they gain Advantage on the next attack roll they make before the end of their next turn. Power from Pain: Once per turn, when they make an attack roll while Bloodied, they can deal extra damage to the target equal to their Proficiency Bonus.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-bloodshed"
    },
    {
      "id": "boon-of-bountiful-health",
      "name": "Boon of Bountiful Health",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Augmented Health: When they gain Temporary Hit Points, increase the number of Temporary Hit Points they gain by 5. Superior Recuperation: When they spend one or more Hit Point Dice to regain Hit Points, they can instead use the highest number possible for each die.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-bountiful-health"
    },
    {
      "id": "boon-of-combat-prowess",
      "name": "Boon of Combat Prowess",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Peerless Aim: When they miss with an attack roll, they can hit instead. Once they use this benefit, they can't use it again until the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-combat-prowess"
    },
    {
      "id": "boon-of-communication",
      "name": "Boon of Communication",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Cunning Speaker: They don’t have Disadvantage on ability checks to influence Hostile creatures. Gifted Interpreter: They understand the literal meaning of any language they hear or see signed, and they can understand the literal meaning of any written language they see.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-communication"
    },
    {
      "id": "boon-of-desperate-resilience",
      "name": "Boon of Desperate Resilience",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Strength or Constitution score by 1, to a maximum of 30. Defense of Body and Mind: While they are Bloodied, they have Resistance to every damage type except Force.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-desperate-resilience"
    },
    {
      "id": "boon-of-dimensional-travel",
      "name": "Boon of Dimensional Travel",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Blink Steps: Immediately after they take the Attack action or the Magic action, they can teleport up to 30 feet to an unoccupied space they can see.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-dimensional-travel"
    },
    {
      "id": "boon-of-energy-resistance",
      "name": "Boon of Energy Resistance",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Energy Resistances: They gain Resistance to two of the following damage types of their choice: Acid, Cold, Fire, Lightning, Necrotic, Poison, Psychic, Radiant, or Thunder. Whenever they finish a Long Rest, they can change their choices.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-energy-resistance"
    },
    {
      "id": "boon-of-exquisite-radiance",
      "name": "Boon of Exquisite Radiance",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Eternal Rest: Creatures they reduce to 0 Hit Points can’t become Undead. Powerful Radiance: When they make a damage roll that deals Radiant damage, they can instead use the highest number possible for each damage die.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-exquisite-radiance"
    },
    {
      "id": "boon-of-fate",
      "name": "Boon of Fate",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Improve Fate: When they or another creature within 60 feet of them succeeds on or fails a D20 Test, they can roll 2d4 and apply the total rolled as a bonus or penalty to the d20 roll. Once they use this benefit, they can’t use it again until they roll Initiative or finish…",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-fate"
    },
    {
      "id": "boon-of-fluid-forms",
      "name": "Boon of Fluid Forms",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Shapechanger: They can take a Magic action to shape-shift into a Beast, Humanoid, or Monstrosity with a Challenge Rating no higher than 10. When they shape-shift, they gain a number of Temporary Hit Points equal to the Hit Points of the form.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-fluid-forms"
    },
    {
      "id": "boon-of-fortitude",
      "name": "Boon of Fortitude",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Fortified Health: Their Hit Point maximum increases by 40. In addition, whenever they regain Hit Points, they can regain additional Hit Points equal to their Constitution modifier.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-fortitude"
    },
    {
      "id": "boon-of-fortune-s-favor",
      "name": "Boon of Fortune's Favor",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Saving Throw Reroll: When they fail a saving throw, they can reroll it and must use the new roll. Once they use this benefit, they can’t do so again until the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-fortune-s-favor"
    },
    {
      "id": "boon-of-irresistible-offense",
      "name": "Boon of Irresistible Offense",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 30. Overcome Defenses: The Bludgeoning, Piercing, and Slashing damage they deal always ignores Resistance. Overwhelming Strike: When they roll a 20 on the d20 for an attack roll, they can deal extra damage to the target equal to the ability score increased by this feat.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-irresistible-offense"
    },
    {
      "id": "boon-of-looming-shadows",
      "name": "Boon of Looming Shadows",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Shadowy Stretch: When they take the Attack action, their reach for their Melee weapon attacks increases by 10 feet until the end of their turn. Dancing Silhouette: They can take the Dodge action as a Bonus Action.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-looming-shadows"
    },
    {
      "id": "boon-of-misty-escape",
      "name": "Boon of Misty Escape",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Gaseous Form: If they drop to 0 Hit Points but aren’t killed outright, they can instead drop to 1 Hit Point and cast Gaseous Form without expending a spell slot (no action required). When they cast this spell this way, they can target only themselves, their Fly Speed is…",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-misty-escape"
    },
    {
      "id": "boon-of-poison-mastery",
      "name": "Boon of Poison Mastery",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Antitoxic: They have Immunity to Poison damage and the Poisoned condition. Perfect Poisoner: Once per turn, when they roll dice to determine Poison damage a creature takes from their attack, spell, or feature, they can instead use the highest number possible for each die.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-poison-mastery"
    },
    {
      "id": "boon-of-recovery",
      "name": "Boon of Recovery",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Last Stand: When they would be reduced to 0 Hit Points, they can drop to 1 Hit Point instead and regain a number of Hit Points equal to half their Hit Point maximum. Once they use this benefit, they can't use it again until they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-recovery"
    },
    {
      "id": "boon-of-revelry",
      "name": "Boon of Revelry",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Inspire Dance: They always have the Otto’s Irresistible Dance spell prepared. They can cast it once without a spell slot, and they regain the ability to cast it that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-revelry"
    },
    {
      "id": "boon-of-siberys",
      "name": "Boon of Siberys",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Aberrant Magic: Choose a level 8 or lower spell from the Sorcerer spell list or a spell from the Siberys Dragonmark Spells table (the table includes dragonmark suggestions if they would like to associate a spell with one of the marks). They always have that spell prepared.… Siberys Dragonmark Spells: Spell Suggested Dragonmark Animal Shapes Handling Control Weather Storm Demiplane Making Heroes' Feast Hospitality Maze Warding Mind Blank Sentinel Plane Shift Passage Project Image Shadow Regenerate Healing Symbol Scribing Teleport Finding True Seeing…",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-siberys"
    },
    {
      "id": "boon-of-skill",
      "name": "Boon of Skill",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. All-Around Adept: They gain proficiency in all skills. Expertise: Choose one skill in which they lack Expertise.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-skill"
    },
    {
      "id": "boon-of-speed",
      "name": "Boon of Speed",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Escape Artist: As a Bonus Action, they can take the Disengage action, which also ends the Grappled condition on they. Quickness: Their Speed increases by 30 feet.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-speed"
    },
    {
      "id": "boon-of-spell-recall",
      "name": "Boon of Spell Recall",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Free Casting: Whenever they cast a spell with a level 1-4 spell slot, roll 1d4. If the number they roll is the same as the slot’s level, the slot isn’t expended.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-spell-recall"
    },
    {
      "id": "boon-of-terror",
      "name": "Boon of Terror",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Charisma score by 1, to a maximum of 30. Fearless: They have Immunity to the Frightened condition. Flee, Fools!: When a creature with the Frightened condition starts its turn within 60 feet of them, they can take a Reaction to stoke its terror, provided they can see the creature and it isn’t behind Total Cover.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-terror"
    },
    {
      "id": "boon-of-the-bright-sun",
      "name": "Boon of the Bright Sun",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Constitution, Wisdom, or Charisma score by 1, to a maximum of 30. Daylight Presence: As a Bonus Action, they radiate a 30-foot Emanation of Bright Light that is sunlight. If any of the Emanation’s area overlaps with an area of Darkness created by a spell, that spell is dispelled.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-the-bright-sun"
    },
    {
      "id": "boon-of-the-furious-storm",
      "name": "Boon of the Furious Storm",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 30. Eye of the Storm: They have Resistance to Lightning and Thunder damage. While they are Bloodied, they have Immunity to Lightning and Thunder damage.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-the-furious-storm"
    },
    {
      "id": "boon-of-the-night-spirit",
      "name": "Boon of the Night Spirit",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Merge with Shadows: While within Dim Light or Darkness, they can give themselves the Invisible condition as a Bonus Action. The condition ends on they immediately after they take an action, a Bonus Action, or a Reaction.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-the-night-spirit"
    },
    {
      "id": "boon-of-the-soul-drinker",
      "name": "Boon of the Soul Drinker",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Grave Resistance: They have Resistance to Cold damage and Necrotic damage. Siphon Life: When an enemy within 120 feet of them is reduced to 0 Hit Points, they can take a Reaction to regain 50 Hit Points.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-the-soul-drinker"
    },
    {
      "id": "boon-of-truesight",
      "name": "Boon of Truesight",
      "category": "Epic Boon",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 30. Truesight: They have Truesight with a range of 60 feet.",
      "source": "http://dnd2024.wikidot.com/feat:boon-of-truesight"
    },
    {
      "id": "charger",
      "name": "Charger",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Improved Dash: When they take the Dash action, their Speed increases by 10 feet for that action. Charge Attack: If they move at least 10 feet in a straight line toward a target immediately before hitting it with a melee attack roll as part of the Attack action, choose one of the following effects: gain a 1d8 bonus to the attack's damage roll, or push the target up to…",
      "source": "http://dnd2024.wikidot.com/feat:charger"
    },
    {
      "id": "chef",
      "name": "Chef",
      "category": "General",
      "description": "Ability Score Increase: Increase their Constitution or Wisdom score by 1, to a maximum of 20. Cook's Utensils: They gain proficiency with Cook's Utensils if they don't already have it. Replenishing Meal: As part of a Short Rest, they can cook special food if they have ingredients and Cook's Utensils on hand.",
      "source": "http://dnd2024.wikidot.com/feat:chef"
    },
    {
      "id": "child-of-the-sun",
      "name": "Child of the Sun",
      "category": "Origin",
      "description": "Eyes of Eirdu: They and allies within 10 feet of them have Advantage on saving throws made to avoid or end the Blinded condition. Faerie Fire: They learn the Faerie Fire spell. Intelligence, Wisdom, or Charisma is their spellcasting ability for this spell (choose when they select this feat).",
      "source": "http://dnd2024.wikidot.com/feat:child-of-the-sun"
    },
    {
      "id": "cloying-mists",
      "name": "Cloying Mists",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Arise, Fog: They always have the Fog Cloud spell prepared. They can cast it without a spell slot, and they must finish a Long Rest before they can cast it in this way again.",
      "source": "http://dnd2024.wikidot.com/feat:cloying-mists"
    },
    {
      "id": "cold-caster",
      "name": "Cold Caster",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Cantrip: They learn the Ray of Frost cantrip. If they already know it, they learn a different Wizard cantrip of their choice.",
      "source": "http://dnd2024.wikidot.com/feat:cold-caster"
    },
    {
      "id": "crafter",
      "name": "Crafter",
      "category": "Origin",
      "description": "Tool Proficiency: They gain proficiency with three different Artisan's Tools of their choice from the Fast Crafting table. Discount: Whenever they buy a nonmagical item, they receive a 20 percent discount on it. Fast Crafting: When they finish a Long Rest, they can craft one piece of gear from the Fast Crafting table, provided they have the Artisan's Tools associated with that item and have proficiency with those tools.",
      "source": "http://dnd2024.wikidot.com/feat:crafter"
    },
    {
      "id": "crossbow-expert",
      "name": "Crossbow Expert",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity score by 1, to a maximum of 20. Ignore Loading: They ignore the Loading property of the Hand Crossbow, Heavy Crossbow, and Light Crossbow (all called crossbows elsewhere in this feat). If they are holding one of them, they can load a piece of ammunition into it even if they lack a free hand.",
      "source": "http://dnd2024.wikidot.com/feat:crossbow-expert"
    },
    {
      "id": "crusher",
      "name": "Crusher",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Constitution score by 1, to a maximum of 20. Push: Once per turn, when they hit a creature with an attack that deals Bludgeoning damage, they can move it 5 feet to an unoccupied space if the target is no more than one size larger than they. Enhanced Critical: When they score a Critical Hit that deals Bludgeoning damage to a creature, attack rolls against that creature have Advantage until the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:crusher"
    },
    {
      "id": "cult-of-the-dragon-initiate",
      "name": "Cult of the Dragon Initiate",
      "category": "Origin",
      "description": "Dragon’s Tongue: They know Draconic. If they already know Draconic when they select this feat, they instead learn one language of their choice from the language tables in the Player’s Handbook or chapter 2 of this book. Dragon’s Terror: They can take a Magic action to instill terror in a creature they can see within 30 feet of themselves.",
      "source": "http://dnd2024.wikidot.com/feat:cult-of-the-dragon-initiate"
    },
    {
      "id": "defense",
      "name": "Defense",
      "category": "Fighting Style",
      "description": "While they are wearing Light, Medium, or Heavy armor, they gain a +1 bonus to Armor Class.",
      "source": "http://dnd2024.wikidot.com/feat:defense"
    },
    {
      "id": "defensive-duelist",
      "name": "Defensive Duelist",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity score by 1, to a maximum of 20. Parry: If they are holding a Finesse weapon and another creature hits they with a melee attack, they can take a Reaction to add their Proficiency Bonus to their Armor Class, potentially causing the attack to miss they. They gain this bonus to their AC against melee…",
      "source": "http://dnd2024.wikidot.com/feat:defensive-duelist"
    },
    {
      "id": "delicious-pain",
      "name": "Delicious Pain",
      "category": "General",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Toughened Flesh: Immediately after they take Bludgeoning, Piercing, or Slashing damage, they can take a Reaction to gain Resistance to Bludgeoning, Piercing, and Slashing damage until the start of their next turn. Once they use this benefit, they can’t use it again until…",
      "source": "http://dnd2024.wikidot.com/feat:delicious-pain"
    },
    {
      "id": "dragonscarred",
      "name": "Dragonscarred",
      "category": "General",
      "description": "Ability Score Increase: Increase their Constitution or Charisma score by 1, to a maximum of 20. Damage Resistance: When they gain this feat, choose Acid, Cold, Fire, Lightning, or Poison. They have Resistance to the chosen damage type.",
      "source": "http://dnd2024.wikidot.com/feat:dragonscarred"
    },
    {
      "id": "dual-wielder",
      "name": "Dual Wielder",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Enhanced Dual Wielding: When they take the Attack action on their turn and attack with a weapon that has the Light property, they can make one extra attack as a Bonus Action later on the same turn with a different weapon, which must be a Melee weapon that lacks the Two-Handed… Quick Draw: They can draw or stow two weapons that lack the Two-Handed property when they would normally be able to draw or stow only one.",
      "source": "http://dnd2024.wikidot.com/feat:dual-wielder"
    },
    {
      "id": "dueling",
      "name": "Dueling",
      "category": "Fighting Style",
      "description": "When they are holding a Melee weapon in one hand and no other weapons, they gain a +2 bonus to damage rolls with that weapon.",
      "source": "http://dnd2024.wikidot.com/feat:dueling"
    },
    {
      "id": "durable",
      "name": "Durable",
      "category": "General",
      "description": "Ability Score Increase: Increase their Constitution score by 1, to a maximum of 20. Defy Death: They have Advantage on Death Saving Throws. Speedy Recovery: As a Bonus Action, they can expend one of their Hit Point Dice, roll the die, and regain a number of Hit Points equal to the roll.",
      "source": "http://dnd2024.wikidot.com/feat:durable"
    },
    {
      "id": "echoing-soul",
      "name": "Echoing Soul",
      "category": "Dark Gift",
      "description": "Channelled Prowess: They have proficiency in two skills of their choice. In addition, choose one skill they have proficiency in. They gain Expertise in that skill.",
      "source": "http://dnd2024.wikidot.com/feat:echoing-soul"
    },
    {
      "id": "elemental-adept",
      "name": "Elemental Adept",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Energy Mastery: Choose one of the following damage types: Acid, Cold, Fire, Lightning, or Thunder. Spells they cast ignore Resistance to damage of the chosen type.",
      "source": "http://dnd2024.wikidot.com/feat:elemental-adept"
    },
    {
      "id": "emerald-enclave-fledgling",
      "name": "Emerald Enclave Fledgling",
      "category": "Origin",
      "description": "Speak with Animals: They always have the Speak with Animals spell prepared and can cast it with any spell slots they have. Intelligence, Wisdom, or Charisma is their spellcasting ability for this spell (choose when they select this feat). When they cast this spell as a Ritual… Tag Team: When they take the Help action, they can switch places with a willing ally within 5 feet of themselves as part of that same action.",
      "source": "http://dnd2024.wikidot.com/feat:emerald-enclave-fledgling"
    },
    {
      "id": "enclave-magic",
      "name": "Enclave Magic",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Friend to Animals: They have Advantage on ability checks when taking the Influence action with Beasts. Two Hearts, One Mind: They always have the Beast Sense spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:enclave-magic"
    },
    {
      "id": "fairy-trickster",
      "name": "Fairy Trickster",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Charisma ability score by 1, to a maximum of 20. Faerie Trod Trotter: When they take the Disengage action on their turn, Difficult Terrain doesn’t cost they extra movement for the rest of that turn. Flustering Strike: When they hit a creature with an attack roll, they can attempt to fluster the target.",
      "source": "http://dnd2024.wikidot.com/feat:fairy-trickster"
    },
    {
      "id": "fey-pact",
      "name": "Fey Pact",
      "category": "Planar Pact",
      "description": "Fey Bond: They know Sylvan. If they already know Sylvan when they select this feat, they instead learn one language of their choice from the language tables in the Player’s Handbook. They also gain Proficiency in the Nature skill.",
      "source": "http://dnd2024.wikidot.com/feat:fey-pact"
    },
    {
      "id": "fey-sentinel",
      "name": "Fey Sentinel",
      "category": "Planar Pact",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Fading Target: When an enemy misses they with an attack roll, they can take a Reaction to gain the Invisible condition until the start of their next turn or until immediately after they make an attack roll, deal damage, or cast a spell. Once they use this benefit, they… Fey Shift: When they take the Dash action, they can forgo the extra movement to teleport to an unoccupied space they can see within a distance equal to half their Speed instead.",
      "source": "http://dnd2024.wikidot.com/feat:fey-sentinel"
    },
    {
      "id": "fey-touched",
      "name": "Fey Touched",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Fey Magic: Choose one level 1 spell from the Divination or Enchantment school of magic. They always have that spell and the Misty Step spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:fey-touched"
    },
    {
      "id": "gathered-whispers",
      "name": "Gathered Whispers",
      "category": "Dark Gift",
      "description": "Spirit Whispers: They learn the Message spell and can cast it without Material components. Additionally, they always have the Augury spell prepared. They can cast it without a spell slot or spell components, and they must finish a Long Rest before they can cast it in this… Unearthly Scream: When they are hit by an attack roll, they can take a Reaction to channel their haunting spirits into a protective, otherworldly scream.",
      "source": "http://dnd2024.wikidot.com/feat:gathered-whispers"
    },
    {
      "id": "genie-magic",
      "name": "Genie Magic",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Wish Magic: As a Magic action, they can cast a level 1 spell of their choice from the Sorcerer spell list that has a casting time of an action. Once they use this benefit, they can’t do so again until they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:genie-magic"
    },
    {
      "id": "grappler",
      "name": "Grappler",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Punch and Grab: When they hit a creature with an Unarmed Strike as part of the Attack action on their turn, they can use both the Damage and the Grapple option. They can use this benefit only once per turn.",
      "source": "http://dnd2024.wikidot.com/feat:grappler"
    },
    {
      "id": "great-weapon-fighting",
      "name": "Great Weapon Fighting",
      "category": "Fighting Style",
      "description": "When they roll damage for an attack they make with a Melee weapon that they are holding with two hands, they can treat any 1 or 2 on a damage die as a 3. The weapon must have the Two-Handed or Versatile property to gain this benefit.",
      "source": "http://dnd2024.wikidot.com/feat:great-weapon-fighting"
    },
    {
      "id": "great-weapon-master",
      "name": "Great Weapon Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength score by 1, to a maximum of 20. Heavy Weapon Mastery: When they hit a creature with a weapon that has the Heavy property as part of the Attack action on their turn, they can cause the weapon to deal extra damage to the target. The extra damage equals their Proficiency Bonus.",
      "source": "http://dnd2024.wikidot.com/feat:great-weapon-master"
    },
    {
      "id": "greater-aberrant-mark",
      "name": "Greater Aberrant Mark",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase their Constitution score by 1, to a maximum of 20. Improved Fortitude: When they use the Aberrant Fortitude benefit of their Aberrant Dragonmark feat, they can roll 1d6 instead of 1d4. They also now regain their use of Aberrant Fortitude whenever they finish a Short or Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:greater-aberrant-mark"
    },
    {
      "id": "greater-mark-of-detection",
      "name": "Greater Mark of Detection",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Deductive Intuition benefit of their Mark of Detection feat, they can roll 1d6 instead of 1d4. Shared Detection: When they use the Magical Detection benefit of their Mark of Detection feat to cast See Invisibility without a spell slot, they can choose one creature they can see within 30 feet of themselves.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-detection"
    },
    {
      "id": "greater-mark-of-finding",
      "name": "Greater Mark of Finding",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Hunter’s Intuition benefit of their Mark of Finding feat, they can roll 1d6 instead of 1d4. Improved Finding: When they use the Finder’s Magic benefit of their Mark of Finding to cast Hunter’s Mark without a spell slot, the range of the spell is doubled, and they can modify the spell so that the target can’t benefit from the Invisible condition for the duration.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-finding"
    },
    {
      "id": "greater-mark-of-handling",
      "name": "Greater Mark of Handling",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Wild Intuition benefit of their Mark of Handling feat, they can roll 1d6 instead of 1d4. Improved Handling: While they are mounted, immediately after they hit a target within 5 feet of their mount with a melee attack roll, their mount can take a Reaction to move up to its Speed or take the Attack action to make one attack only (their choice).",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-handling"
    },
    {
      "id": "greater-mark-of-healing",
      "name": "Greater Mark of Healing",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Medical Intuition benefit of their Mark of Healing feat, they can roll 1d6 instead of 1d4. Improved Healing: They can now use the Healing Touch benefit of their Mark of Healing feat to cast Cure Wounds without using a spell slot a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-healing"
    },
    {
      "id": "greater-mark-of-hospitality",
      "name": "Greater Mark of Hospitality",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Ever Hospitable benefit of their Mark of Hospitality feat, they can roll 1d6 instead of 1d4. Inspired Hospitality: When they cast Purify Food and Drink, they can modify the spell so that instead of its normal effect, each creature of their choice within 30 feet of them is refreshed.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-hospitality"
    },
    {
      "id": "greater-mark-of-making",
      "name": "Greater Mark of Making",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Artisan’s Intuition benefit of their Mark of Making feat, they can roll 1d6 instead of 1d4. Improved Making: When they use the Spellsmith benefit of their Mark of Making feat to cast Magic Weapon without a spell slot, they cast the spell as its level 3 version.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-making"
    },
    {
      "id": "greater-mark-of-passage",
      "name": "Greater Mark of Passage",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Intuitive Motion benefit of their Mark of Passage feat, they can roll 1d6 instead of 1d4. Inspired Passage: When they use the Magical Passage benefit of their Mark of Passage feat to cast Misty Step without a spell slot, they can also choose up to two willing creatures they can see within 30 feet of themselves before they teleport.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-passage"
    },
    {
      "id": "greater-mark-of-scribing",
      "name": "Greater Mark of Scribing",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Gifted Scribe benefit of their Mark of Scribing feat, they can roll 1d6 instead of 1d4. Inspired Scribing: When they cast Comprehend Languages, they can modify the spell to encompass up to three willing creatures they can see within 30 feet of themselves.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-scribing"
    },
    {
      "id": "greater-mark-of-sentinel",
      "name": "Greater Mark of Sentinel",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Sentinel’s Intuition benefit of their Mark of Sentinel feat, they can roll 1d6 instead of 1d4. Improved Sentinel: When they use the Vigilant Guardian benefit of their Mark of Sentinel feat, they can also make one attack with a weapon or an Unarmed Strike as part of that same Reaction.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-sentinel"
    },
    {
      "id": "greater-mark-of-shadow",
      "name": "Greater Mark of Shadow",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Cunning Intuition benefit of their Mark of Shadow feat, they can roll 1d6 instead of 1d4. Improved Shadow: When they use the Shape Shadows benefit of their Mark of Shadow feat to cast Invisibility without a spell slot, they cast the spell as its level 3 version.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-shadow"
    },
    {
      "id": "greater-mark-of-storm",
      "name": "Greater Mark of Storm",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Windwright’s Intuition benefit of their Mark of Storm feat, they can roll 1d6 instead of 1d4. Improved Storm: When they use the Storm Magic benefit of their Mark of Storm feat to cast Gust of Wind without a spell slot, they also gain a Fly Speed of 60 feet for the duration of the spell.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-storm"
    },
    {
      "id": "greater-mark-of-warding",
      "name": "Greater Mark of Warding",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Improved Intuition: When they use the Warder’s Intuition benefit of their Mark of Warding feat, they can roll 1d6 instead of 1d4. Improved Warding: When a creature makes an attack roll against them or a creature they can see within 30 feet of themselves, they can take a Reaction to impose Disadvantage on that roll.",
      "source": "http://dnd2024.wikidot.com/feat:greater-mark-of-warding"
    },
    {
      "id": "harper-agent",
      "name": "Harper Agent",
      "category": "Origin",
      "description": "Thieves’ Cant: They know Thieves’ Cant. Instrument Training: They gain proficiency with a Musical Instrument of their choice. Distracting Melody: When they take the Help action to assist an ally’s attack roll, the enemy they are distracting can be within 30 feet of them, rather than within 5 feet of them, provided the enemy can see or hear they.",
      "source": "http://dnd2024.wikidot.com/feat:harper-agent"
    },
    {
      "id": "harper-teamwork",
      "name": "Harper Teamwork",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Charisma score by 1, to a maximum of 20. Withering Wordplay: When they take the Help action to assist an ally’s attack roll against an enemy, that enemy also has Disadvantage on the first saving throw it makes before the start of their next turn. Inspiring Willpower: If they succeed on a saving throw to end the Frightened or Paralyzed condition on themselves, they can choose one ally they can see within 30 feet of themselves that has the same condition.",
      "source": "http://dnd2024.wikidot.com/feat:harper-teamwork"
    },
    {
      "id": "healer",
      "name": "Healer",
      "category": "Origin",
      "description": "Battle Medic: If they have a Healer's Kit, they can expend one use of it and tend to a creature within 5 feet of themselves as a Utilize action. That creature can expend one of its Hit Point Dice, and they then roll that die. The creature regains a number of Hit Points… Healing Rerolls: Whenever they roll a die to determine the number of Hit Points they restore with a spell or with this feat's Battle Medic benefit, they can reroll the die if it rolls a 1, and they must use the new roll.",
      "source": "http://dnd2024.wikidot.com/feat:healer"
    },
    {
      "id": "heavily-armored",
      "name": "Heavily Armored",
      "category": "General",
      "description": "Ability Score Increase: Increase their Constitution or Strength score by 1, to a maximum of 20. Armor Training: They gain training with Heavy armor.",
      "source": "http://dnd2024.wikidot.com/feat:heavily-armored"
    },
    {
      "id": "heavy-armor-master",
      "name": "Heavy Armor Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Constitution or Strength score by 1, to a maximum of 20. Damage Reduction: When they are hit by an attack while they are wearing Heavy armor, any Bludgeoning, Piercing, and Slashing damage dealt to them by that attack is reduced by an amount equal to their Proficiency Bonus.",
      "source": "http://dnd2024.wikidot.com/feat:heavy-armor-master"
    },
    {
      "id": "infernal-bulwark",
      "name": "Infernal Bulwark",
      "category": "Planar Pact",
      "description": "Ability Score Increase: Increase their Constitution or Charisma score by 1, to a maximum of 20. Devil’s Flesh: Their skin thickens and assumes a scaled, leathery texture. While they aren’t wearing armor or wielding a Shield, their base Armor Class equals 10 plus their Dexterity modifier plus the modifier of the ability increased by this feat.",
      "source": "http://dnd2024.wikidot.com/feat:infernal-bulwark"
    },
    {
      "id": "infernal-dragoon",
      "name": "Infernal Dragoon",
      "category": "Planar Pact",
      "description": "Ability Score Increase: Increase their Constitution or Charisma score by 1, to a maximum of 20. Devilish Aura: Their close association with diabolic powers unsettles others. They can take a Magic action to manifest an aura of fear in a 30-foot Emanation originating from themselves.",
      "source": "http://dnd2024.wikidot.com/feat:infernal-dragoon"
    },
    {
      "id": "infernal-pact",
      "name": "Infernal Pact",
      "category": "Planar Pact",
      "description": "Infernal Resistance: They have Resistance to Fire damage and Poison damage. Infernal Sight: They can see normally in Dim Light and Darkness - both magical and nonmagical - within 60 feet of themselves. Silver-Tongued: They gain proficiency in the Deception skill.",
      "source": "http://dnd2024.wikidot.com/feat:infernal-pact"
    },
    {
      "id": "inspiring-leader",
      "name": "Inspiring Leader",
      "category": "General",
      "description": "Ability Score Increase: Increase their Wisdom or Charisma score by 1, to a maximum of 20. Bolstering Performance: When they finish a Short or Long Rest, they can give an inspiring performance: a speech, song, or dance. When they do so, choose up to six allies (which can include themselves) within 30 feet of themselves who witness the performance.",
      "source": "http://dnd2024.wikidot.com/feat:inspiring-leader"
    },
    {
      "id": "interception",
      "name": "Interception",
      "category": "Fighting Style",
      "description": "When a creature they can see hits another creature within 5 feet of them with an attack roll, they can take a Reaction to reduce the damage dealt to the target by 1d10 plus their Proficiency Bonus. They must be holding a Shield or a Simple or Martial weapon to use this Reaction.",
      "source": "http://dnd2024.wikidot.com/feat:interception"
    },
    {
      "id": "keen-mind",
      "name": "Keen Mind",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence score by 1, to a maximum of 20. Lore Knowledge: Choose one of the following skills: Arcana, History, Investigation, Nature, or Religion. If they lack proficiency in the chosen skill, they gain proficiency in it, and if they already have proficiency in it, they gain Expertise in it.",
      "source": "http://dnd2024.wikidot.com/feat:keen-mind"
    },
    {
      "id": "light-bringer",
      "name": "Light Bringer",
      "category": "General",
      "description": "The Light Bringer feat provides benefits associated with its General category.",
      "source": "http://dnd2024.wikidot.com/feat:light-bringer"
    },
    {
      "id": "lightly-armored",
      "name": "Lightly Armored",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Armor Training: They gain training with Light armor and Shields.",
      "source": "http://dnd2024.wikidot.com/feat:lightly-armored"
    },
    {
      "id": "living-shadow",
      "name": "Living Shadow",
      "category": "Dark Gift",
      "description": "Grasping Shadow: They learn the Mage Hand spell and can cast it without spell components. Intelligence, Wisdom or Charisma is their spellcasting ability for this spell (choose when they select this feat). Lengthened Strike: When they make a melee attack roll as part of the Attack or Magic action on their turn, they can increase their reach for that attack by 10 feet, as their shadow stretches to aid they.",
      "source": "http://dnd2024.wikidot.com/feat:living-shadow"
    },
    {
      "id": "lordly-resolve",
      "name": "Lordly Resolve",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Charisma score by 1, to a maximum of 20. Standard Bearer: As a Bonus Action, choose up to three creatures within 60 feet of themselves that can see they. Each target can immediately take a Reaction to right itself and end the Prone condition, provided its Speed isn’t 0.",
      "source": "http://dnd2024.wikidot.com/feat:lordly-resolve"
    },
    {
      "id": "lords-alliance-agent",
      "name": "Lords' Alliance Agent",
      "category": "Origin",
      "description": "Inspiring Strike: Once per turn when they score a Critical Hit against a creature, they can choose an ally within 30 feet of themselves who can see or hear they and who lacks Heroic Inspiration. That ally gains Heroic Inspiration. Reassert Honor: When an enemy they can see deals damage to an ally of theirs that is within 5 feet of them, they have Advantage on their next attack roll against that enemy before the end of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:lords-alliance-agent"
    },
    {
      "id": "love-bites",
      "name": "Love Bites",
      "category": "General",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Endearing Pain: Immediately after they damage a creature with a Melee weapon or an Unarmed Strike, they can take a Bonus Action to give the target the Charmed condition until the start of their next turn or until they or their allies damage it. Once they use this benefit…",
      "source": "http://dnd2024.wikidot.com/feat:love-bites"
    },
    {
      "id": "lucky",
      "name": "Lucky",
      "category": "Origin",
      "description": "Luck Points: They have a number of Luck Points equal to their Proficiency Bonus and can spend the points on the benefits below. They regain their expended Luck Points when they finish a Long Rest. Advantage: When they roll a d20 for a D20 Test, they can spend 1 Luck Point to give themselves Advantage on the roll.",
      "source": "http://dnd2024.wikidot.com/feat:lucky"
    },
    {
      "id": "mage-slayer",
      "name": "Mage Slayer",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Concentration Breaker: When they damage a creature that is concentrating, it has Disadvantage on the saving throw it makes to maintain Concentration. Guarded Mind: If they fail an Intelligence, a Wisdom, or a Charisma saving throw, they can cause themselves to succeed instead.",
      "source": "http://dnd2024.wikidot.com/feat:mage-slayer"
    },
    {
      "id": "magic-initiate",
      "name": "Magic Initiate",
      "category": "Origin",
      "description": "Two Cantrips: They learn two cantrips of their choice from the Cleric, Druid, or Wizard spell list. Intelligence, Wisdom, or Charisma is their spellcasting ability for this feat's spells (choose when they select this feat). Level 1 Spell: Choose a level 1 spell from the same list they selected for this feat's cantrips.",
      "source": "http://dnd2024.wikidot.com/feat:magic-initiate"
    },
    {
      "id": "mark-of-detection",
      "name": "Mark of Detection",
      "category": "Dragonmark",
      "description": "Deductive Intuition: When they make an Intelligence (Investigation) or Wisdom (Insight) check, they can roll 1d4 and add the number rolled to the ability check. Magical Detection: They always have the Detect Magic and Detect Poison and Disease spells prepared. They can cast each spell once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-detection"
    },
    {
      "id": "mark-of-finding",
      "name": "Mark of Finding",
      "category": "Dragonmark",
      "description": "Hunter’s Intuition: When they make a Wisdom (Perception or Survival) check, they can roll 1d4 and add the number rolled to the ability check. Finder’s Magic: They always have the Hunter’s Mark spell prepared. They can cast it once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-finding"
    },
    {
      "id": "mark-of-handling",
      "name": "Mark of Handling",
      "category": "Dragonmark",
      "description": "Wild Intuition: When they make an Intelligence (Nature) or Wisdom (Animal Handling) check, they can roll 1d4 and add the number rolled to the ability check. Primal Connection: They always have the Animal Friendship and Speak with Animals spells prepared. They can cast each spell once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-handling"
    },
    {
      "id": "mark-of-healing",
      "name": "Mark of Healing",
      "category": "Dragonmark",
      "description": "Medical Intuition: When they make a Wisdom (Medicine) check or an ability check using a Herbalism Kit, they can roll 1d4 and add the number rolled to the ability check. Healing Touch: They always have the Cure Wounds spell prepared. They can cast it once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-healing"
    },
    {
      "id": "mark-of-hospitality",
      "name": "Mark of Hospitality",
      "category": "Dragonmark",
      "description": "Ever Hospitable: When they make a Charisma (Persuasion) check or an ability check using Brewer’s Supplies or Cook’s Utensils, they can roll 1d4 and add the number rolled to the ability check. Innkeeper’s Magic: They always have the Purify Food and Drink and Unseen Servant spells prepared. They can cast each spell once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-hospitality"
    },
    {
      "id": "mark-of-making",
      "name": "Mark of Making",
      "category": "Dragonmark",
      "description": "Artisan’s Intuition: When they make an Intelligence (Arcana) check or an ability check using Artisan’s Tools, they can roll 1d4 and add the number rolled to the ability check. Spellsmith: They know the Mending cantrip. They also always have the Magic Weapon spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-making"
    },
    {
      "id": "mark-of-passage",
      "name": "Mark of Passage",
      "category": "Dragonmark",
      "description": "Courier’s Speed: Their Speed increases by 5 feet. Intuitive Motion: When they make a Strength (Athletics) or Dexterity (Acrobatics) check, they can roll 1d4 and add the number rolled to the ability check. Magical Passage: They always have the Misty Step spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-passage"
    },
    {
      "id": "mark-of-scribing",
      "name": "Mark of Scribing",
      "category": "Dragonmark",
      "description": "Gifted Scribe: When they make an Intelligence (History) check or an ability check using Calligrapher’s Supplies, they can roll 1d4 and add the number rolled to the ability check. Scribe’s Insight: They know the Message cantrip. They also always have the Comprehend Languages spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-scribing"
    },
    {
      "id": "mark-of-sentinel",
      "name": "Mark of Sentinel",
      "category": "Dragonmark",
      "description": "Sentinel’s Intuition: When they make a Wisdom (Insight or Perception) check, they can roll 1d4 and add the number rolled to the ability check. Guardian’s Shield: They always have the Shield spell prepared. They can cast it once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-sentinel"
    },
    {
      "id": "mark-of-shadow",
      "name": "Mark of Shadow",
      "category": "Dragonmark",
      "description": "Cunning Intuition: When they make a Dexterity (Stealth) or Charisma (Performance) check, they can roll 1d4 and add the number rolled to the ability check. Shape Shadows: They know the Minor Illusion cantrip. They also always have the Invisibility spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-shadow"
    },
    {
      "id": "mark-of-storm",
      "name": "Mark of Storm",
      "category": "Dragonmark",
      "description": "Windwright’s Intuition: When they make a Dexterity (Acrobatics) check or an ability check using Navigator’s Tools, they can roll 1d4 and add the number rolled to the ability check. Storm’s Boon: They have Resistance to Lightning damage. Storm Magic: They know the Thunderclap cantrip.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-storm"
    },
    {
      "id": "mark-of-warding",
      "name": "Mark of Warding",
      "category": "Dragonmark",
      "description": "Warder’s Intuition: When they make an Intelligence (Investigation) check or an ability check using Thieves’ Tools, they can roll 1d4 and add the number rolled to the ability check. Wards and Seals: They always have the Alarm and Mage Armor spells prepared. They can cast each spell once without a spell slot, and they regain the ability to cast it in that way when they finish a Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:mark-of-warding"
    },
    {
      "id": "martial-weapon-training",
      "name": "Martial Weapon Training",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Weapon Proficiency: They gain proficiency with Martial weapons.",
      "source": "http://dnd2024.wikidot.com/feat:martial-weapon-training"
    },
    {
      "id": "medium-armor-master",
      "name": "Medium Armor Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Dexterous Wearer: While they are wearing Medium armor, they can add 3, rather than 2, to their AC if they have a Dexterity score of 16 or higher.",
      "source": "http://dnd2024.wikidot.com/feat:medium-armor-master"
    },
    {
      "id": "mist-walker",
      "name": "Mist Walker",
      "category": "Dark Gift",
      "description": "Domain Traveler: When they enter the Mists intent on reaching a specific domain, they are treated as if they possess a Mist talisman keyed to that domain. To use this feature, they must know the name of the domain they have chosen as their destination, but they don’t need to… Mist Walk: When they take damage or fail a saving throw to avoid or end the Grappled or Restrained condition, they can take a Reaction and teleport up to 15 feet to an unoccupied space they can see. They can use this feature a number of times equal to their Proficiency… Poisoned Roots: When they finish a Long Rest, the world around them in a 10-mile radius becomes a siphon that leeches away at their vitality.",
      "source": "http://dnd2024.wikidot.com/feat:mist-walker"
    },
    {
      "id": "moderately-armored",
      "name": "Moderately Armored",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Armor Training: They gain training with Medium armor.",
      "source": "http://dnd2024.wikidot.com/feat:moderately-armored"
    },
    {
      "id": "mounted-combatant",
      "name": "Mounted Combatant",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength, Dexterity, or Wisdom score by 1, to a maximum of 20. Mounted Strike: While mounted, they have Advantage on attack rolls against any unmounted creature within 5 feet of their mount that is at least one size smaller than the mount. Leap Aside: If their mount is subjected to an effect that allows it to make a Dexterity saving throw to take only half damage, it instead takes no damage if it succeeds on the saving throw and only half damage if it fails.",
      "source": "http://dnd2024.wikidot.com/feat:mounted-combatant"
    },
    {
      "id": "musician",
      "name": "Musician",
      "category": "Origin",
      "description": "Instrument Training: They gain proficiency with three Musical Instruments of their choice. Encouraging Song: As they finish a Short or Long Rest, they can play a song on a Musical Instrument with which they have proficiency and give Heroic Inspiration to allies who hear the song. The number of allies they can affect in this way equals their Proficiency Bonus.",
      "source": "http://dnd2024.wikidot.com/feat:musician"
    },
    {
      "id": "mythal-touched",
      "name": "Mythal Touched",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Mythal Ward: If a spell attack hits they or they fail a saving throw against a spell, they can take a Reaction to roll on the Mythal-Touched Magic table to create a magical effect. If an effect requires a saving throw, the DC equals 8 plus the modifier of the ability… Mythal-Touched Magic: 1d20 Effect 1-2 they and each creature within 15 feet of them make a Dexterity saving throw, taking Force damage equal to 1d8 times the level of the triggering spell on a failed save or half as much damage on a successful one.",
      "source": "http://dnd2024.wikidot.com/feat:mythal-touched"
    },
    {
      "id": "observant",
      "name": "Observant",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence or Wisdom score by 1, to a maximum of 20. Keen Observer: Choose one of the following skills: Insight, Investigation, or Perception. If they lack proficiency with the chosen skill, they gain proficiency in it, and if they already have proficiency in it, they gain Expertise in it.",
      "source": "http://dnd2024.wikidot.com/feat:observant"
    },
    {
      "id": "order-s-resilience",
      "name": "Order's Resilience",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength, Wisdom, or Charisma score by 1, to a maximum of 20. Resurge: When they have the Prone condition, they can right themselves with only 5 feet of movement. Stronger Together: If they are within 5 feet of an ally that doesn’t have the Incapacitated condition, they and that ally have Advantage on Strength saving throws.",
      "source": "http://dnd2024.wikidot.com/feat:order-s-resilience"
    },
    {
      "id": "pack-fighting",
      "name": "Pack Fighting",
      "category": "Fighting Style",
      "description": "Fighting Style Feat (Prerequisite: Fighting Style Feature)",
      "source": "http://dnd2024.wikidot.com/feat:pack-fighting"
    },
    {
      "id": "piercer",
      "name": "Piercer",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity by 1, to a maximum of 20. Puncture: Once per turn, when they hit a creature with an attack that deals Piercing damage, they can reroll one of the attack’s damage dice, and they must use the new roll. Enhanced Critical: When they score a Critical Hit that deals Piercing damage to a creature, they can roll one additional damage die when determining the extra Piercing damage the target takes.",
      "source": "http://dnd2024.wikidot.com/feat:piercer"
    },
    {
      "id": "poisoner",
      "name": "Poisoner",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Intelligence score by 1, to a maximum of 20. Potent Poison: When they make a damage roll that deals Poison damage, it ignores Resistance to Poison damage. Brew Poison: They gain proficiency with the Poisoner’s Kit.",
      "source": "http://dnd2024.wikidot.com/feat:poisoner"
    },
    {
      "id": "polearm-master",
      "name": "Polearm Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Strength score by 1, to a maximum of 20. Pole Strike: Immediately after they take the Attack action and attack with a Quarterstaff, a Spear, or a weapon that has the Heavy and Reach properties, they can use a Bonus Action to make a melee attack with the opposite end of the weapon. The weapon deals Bludgeoning… Reactive Strike: While they are holding a Quarterstaff, a Spear, or a weapon that has the Heavy and Reach properties, they can take a Reaction to make one melee attack against a creature that enters the reach they have with that weapon.",
      "source": "http://dnd2024.wikidot.com/feat:polearm-master"
    },
    {
      "id": "potent-dragonmark",
      "name": "Potent Dragonmark",
      "category": "Dragonmark",
      "description": "Ability Score Increase: Increase the spellcasting ability score used by their Dragonmark feat by 1, to a maximum of 20. Dragonmark Preparation: They always have the spells on their Spells of the Mark list (if any) prepared. Dragonmark Spellcasting: They have one extra spell slot to cast the spells granted by their Dragonmark feat.",
      "source": "http://dnd2024.wikidot.com/feat:potent-dragonmark"
    },
    {
      "id": "prone-fighting",
      "name": "Prone Fighting",
      "category": "Fighting Style",
      "description": "Fighting Style Feat (Prerequisite: Fighting Style Feature)",
      "source": "http://dnd2024.wikidot.com/feat:prone-fighting"
    },
    {
      "id": "protection",
      "name": "Protection",
      "category": "Fighting Style",
      "description": "When a creature they can see attacks a target other than they that is within 5 feet of them, they can take a Reaction to interpose their Shield if they are holding one. They impose Disadvantage on the triggering attack roll and all other attack rolls against the target until the start of their next turn if they remain within 5 feet of the target.",
      "source": "http://dnd2024.wikidot.com/feat:protection"
    },
    {
      "id": "purple-dragon-commandant",
      "name": "Purple Dragon Commandant",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Encourage Ally: As a Bonus Action, they bolster one ally they can see within 30 feet. The ally gains Temporary Hit Points equal to 2d6 plus the modifier of the ability score increased by this feat.",
      "source": "http://dnd2024.wikidot.com/feat:purple-dragon-commandant"
    },
    {
      "id": "purple-dragon-rook",
      "name": "Purple Dragon Rook",
      "category": "Origin",
      "description": "Entreat: They gain proficiency in one of the following skills: Insight, Performance, or Persuasion. Rallying Cry: When they roll Initiative and don’t have the Incapacitated condition, they can choose a number of creatures equal to their Proficiency Bonus that they can see within 30 feet of themselves. Those creatures gain Heroic Inspiration.",
      "source": "http://dnd2024.wikidot.com/feat:purple-dragon-rook"
    },
    {
      "id": "putrefy",
      "name": "Putrefy",
      "category": "General",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Necrosis: When they make a damage roll that deals Necrotic damage, they can cause one creature taking that damage to have the Poisoned condition until the start of their next turn. Once they use this benefit, they can’t use it again until they finish a Short or Long…",
      "source": "http://dnd2024.wikidot.com/feat:putrefy"
    },
    {
      "id": "rebuke",
      "name": "Rebuke",
      "category": "General",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Radiant Strike: When they make a damage roll that deals Radiant damage, they can cause one Huge or smaller creature taking the damage to have the Prone condition. Once they use this benefit, they can’t use it again until they finish a Short or Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:rebuke"
    },
    {
      "id": "resilient",
      "name": "Resilient",
      "category": "General",
      "description": "RESILIENT General Feat (Prerequisite: Level 4+) they gain the following benefits. Ability Score Increase. Choose one ability in which they lack saving throw proficiency.",
      "source": "http://dnd2024.wikidot.com/feat:resilient"
    },
    {
      "id": "ritual-caster",
      "name": "Ritual Caster",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Ritual Spells: Choose a number of level 1 spells equal to their Proficiency Bonus that have the Ritual tag. They always have those spells prepared, and they can cast them with any spell slots they have.",
      "source": "http://dnd2024.wikidot.com/feat:ritual-caster"
    },
    {
      "id": "savage-attacker",
      "name": "Savage Attacker",
      "category": "Origin",
      "description": "They have trained to deal particularly damaging strikes. Once per turn when they hit a target with a weapon, they can roll the weapon's damage dice twice and use either roll against the target.",
      "source": "http://dnd2024.wikidot.com/feat:savage-attacker"
    },
    {
      "id": "second-skin",
      "name": "Second Skin",
      "category": "Dark Gift",
      "description": "Alternate Form: They always have the Alter Self spell prepared. They can cast it without a spell slot or spell components, and they must finish a Long Rest before they can cast it in this way again. They can also cast it using spell slots they have of the appropriate level.… Involuntary Change: Certain circumstances can involuntarily trigger their transformation.",
      "source": "http://dnd2024.wikidot.com/feat:second-skin"
    },
    {
      "id": "sentinel",
      "name": "Sentinel",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Guardian: Immediately after a creature within 5 feet of them takes the Disengage action or hits a target other than they with an attack, they can make an Opportunity Attack against that creature. Halt: When they hit a creature with an Opportunity Attack, the creature’s Speed becomes 0 for the rest of the current turn.",
      "source": "http://dnd2024.wikidot.com/feat:sentinel"
    },
    {
      "id": "shadow-touched",
      "name": "Shadow Touched",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Shadow Magic: Choose one level 1 spell from the Illusion or Necromancy school of magic. They always have that spell and the Invisibility spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:shadow-touched"
    },
    {
      "id": "shadowmoor-hexer",
      "name": "Shadowmoor Hexer",
      "category": "Origin",
      "description": "Hex: They always have the Hex spell prepared. Intelligence, Wisdom, or Charisma is their spellcasting ability for this spell (choose when they select this feat). They can cast it once without a spell slot, and they regain the ability to cast it in that way when… Curse Magic: When a creature that they have cursed with Hex hits they with an attack roll, the creature takes Psychic damage equal to their Proficiency Bonus.",
      "source": "http://dnd2024.wikidot.com/feat:shadowmoor-hexer"
    },
    {
      "id": "sharp-eye",
      "name": "Sharp Eye",
      "category": "Origin",
      "description": "When they take the Search or Study action, they can give themselves Advantage on any ability check made as part of that action. They can use this feature a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Long Rest. If the check fails, the use of this feature isn't expended.",
      "source": "http://dnd2024.wikidot.com/feat:sharp-eye"
    },
    {
      "id": "sharpshooter",
      "name": "Sharpshooter",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity score by 1, to a maximum of 20. Bypass Cover: Their ranged attacks with weapons ignore Half Cover and Three-Quarters Cover. Firing in Melee: Being within 5 feet of an enemy doesn’t impose Disadvantage on their attack rolls with Ranged weapons.",
      "source": "http://dnd2024.wikidot.com/feat:sharpshooter"
    },
    {
      "id": "shield-master",
      "name": "Shield Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength score by 1, to a maximum of 20. Shield Bash: If they attack a creature within 5 feet of them as part of the Attack action and hit with a Melee weapon, they can immediately bash the target with their Shield if it's equipped, forcing the target to make a Strength saving throw (DC 8 plus their Strength… Interpose Shield: If they are subjected to an effect that allows they to make a Dexterity saving throw to take only half damage, they can take a Reaction to take no damage if they succeed on the saving throw and are holding a Shield.",
      "source": "http://dnd2024.wikidot.com/feat:shield-master"
    },
    {
      "id": "shifting-combatant",
      "name": "Shifting Combatant",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Domino Strike: When they hit a creature with a weapon and activate the Push mastery property to push that creature into a space occupied by a Large or smaller creature, they can force the creatures to collide. Each creature must succeed on a Constitution saving throw (DC 8… Fearless Leap: When they make a Long Jump, moving at least 10 feet immediately before the jump, and land in a space within 5 feet of two or more enemies, attack rolls made against them have Disadvantage until the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:shifting-combatant"
    },
    {
      "id": "skill-expert",
      "name": "Skill Expert",
      "category": "General",
      "description": "Ability Score Increase: Increase one ability score of their choice by 1, to a maximum of 20. Skill Proficiency: They gain proficiency in one skill of their choice. Expertise: Choose one skill in which they have proficiency but lack Expertise.",
      "source": "http://dnd2024.wikidot.com/feat:skill-expert"
    },
    {
      "id": "skilled",
      "name": "Skilled",
      "category": "Origin",
      "description": "Repeatable: They can take this feat more than once.",
      "source": "http://dnd2024.wikidot.com/feat:skilled"
    },
    {
      "id": "skulker",
      "name": "Skulker",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity score by 1, to a maximum of 20. Blindsight: They have Blindsight with a range of 10 feet. Fog of War: They exploit the distractions of battle, gaining Advantage on any Dexterity (Stealth) check they make as part of the Hide action during combat.",
      "source": "http://dnd2024.wikidot.com/feat:skulker"
    },
    {
      "id": "slasher",
      "name": "Slasher",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Hamstring: Once per turn when they hit a creature with an attack that deals Slashing damage, they can reduce the Speed of that creature by 10 feet until the start of their next turn. Enhanced Critical: When they score a Critical Hit that deals Slashing damage to a creature, it has Disadvantage on attack rolls until the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:slasher"
    },
    {
      "id": "speedy",
      "name": "Speedy",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Constitution score by 1, to a maximum of 20. Speed Increase: Their Speed increases by 10 feet. Dash over Difficult Terrain: When they take the Dash action on their turn, Difficult Terrain doesn't cost they extra movement for the rest of that turn.",
      "source": "http://dnd2024.wikidot.com/feat:speedy"
    },
    {
      "id": "spell-sniper",
      "name": "Spell Sniper",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Bypass Cover: Their attack rolls for spells ignore Half Cover and Three-Quarters Cover. Casting in Melee: Being within 5 feet of an enemy doesn’t impose Disadvantage on their attack rolls with spells.",
      "source": "http://dnd2024.wikidot.com/feat:spell-sniper"
    },
    {
      "id": "spellfire-adept",
      "name": "Spellfire Adept",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Fueled Spellfire: Once per turn, when a spell they cast deals Radiant damage, they can expend up to two Hit Point Dice, roll them, and add the total rolled to one damage roll of the spell. Searing Spellfire: When they make a damage roll that deals Radiant damage, it ignores Resistance to Radiant damage.",
      "source": "http://dnd2024.wikidot.com/feat:spellfire-adept"
    },
    {
      "id": "spellfire-spark",
      "name": "Spellfire Spark",
      "category": "Origin",
      "description": "Magic Absorption: Once per turn, when they take damage from a spell or magical effect, they reduce the total damage taken by 1d4. They can’t use this benefit if they have the Incapacitated condition. Spellfire Flame: They learn the Sacred Flame cantrip.",
      "source": "http://dnd2024.wikidot.com/feat:spellfire-spark"
    },
    {
      "id": "street-justice",
      "name": "Street Justice",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Headlock: Their allies have Advantage on attack rolls against a creature Grappled by they. Sturdy Knot: When they use Chain, Manacles, or Rope to bind a creature, add their Proficiency Bonus to the DC to escape or burst the Chain, Manacles, or Rope.",
      "source": "http://dnd2024.wikidot.com/feat:street-justice"
    },
    {
      "id": "survivor",
      "name": "Survivor",
      "category": "Origin",
      "description": "Hypervigilance: Hypervigilance. Whenever they roll Initiative, they can reroll the d20 if the number rolled is 9 or lower. They must use the new roll.",
      "source": "http://dnd2024.wikidot.com/feat:survivor"
    },
    {
      "id": "symbiotic-being",
      "name": "Symbiotic Being",
      "category": "Dark Gift",
      "description": "Entwined Existence: The symbiote can’t be targeted. If they die, so does their symbiote. If they are returned to life, their symbiote also revives.",
      "source": "http://dnd2024.wikidot.com/feat:symbiotic-being"
    },
    {
      "id": "tactical-combatant",
      "name": "Tactical Combatant",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Buffering Strike: When they hit a creature with a weapon, they can gain Temporary Hit Points equal to the total number rolled on the weapon’s damage dice. Once they use this benefit, they can’t use it again until they roll Initiative or finish a Short or Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:tactical-combatant"
    },
    {
      "id": "tavern-brawler",
      "name": "Tavern Brawler",
      "category": "Origin",
      "description": "Enhanced Unarmed Strike: When they hit with their Unarmed Strike and deal damage, they can deal Bludgeoning damage equal to 1d4 plus their Strength modifier instead of the normal damage of an Unarmed Strike. Damage Rerolls: Whenever they roll a damage die for their Unarmed Strike, they can reroll the die if it rolls a 1, and they must use the new roll. Improvised Weaponry: They have proficiency with improvised weapons.",
      "source": "http://dnd2024.wikidot.com/feat:tavern-brawler"
    },
    {
      "id": "telekinetic",
      "name": "Telekinetic",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Minor Telekinesis: They learn the Mage Hand spell. They can cast it without Verbal or Somatic components, they can make the spectral hand Invisible, and its range and the distance it can be away from them both increase by 30 feet when they cast it.",
      "source": "http://dnd2024.wikidot.com/feat:telekinetic"
    },
    {
      "id": "telepathic",
      "name": "Telepathic",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Telepathic Utterance: They can speak telepathically to any creature they can see within 60 feet of themselves. their telepathic utterances are in a language they know, and the creature understands they only if it knows that language. their communication doesn't give the creature… Detect Thoughts: They always have the Detect Thoughts spell prepared. They can cast it without a spell slot or spell components, and they must finish a Long Rest before they can cast it in this way again.",
      "source": "http://dnd2024.wikidot.com/feat:telepathic"
    },
    {
      "id": "thrown-weapon-fighting",
      "name": "Thrown Weapon Fighting",
      "category": "Fighting Style",
      "description": "When they hit with a ranged attack roll using a weapon that has the Thrown property, they gain a +2 bonus to the damage roll.",
      "source": "http://dnd2024.wikidot.com/feat:thrown-weapon-fighting"
    },
    {
      "id": "tireless-reveler",
      "name": "Tireless Reveler",
      "category": "Origin",
      "description": "When an ally they can see within 60 feet of themselves expends Heroic Inspiration, they can gain Heroic Inspiration if they lack it. They can use this benefit a number of times equal to their Proficiency Bonus, and they regain all expended uses when they finish a Short or Long Rest.",
      "source": "http://dnd2024.wikidot.com/feat:tireless-reveler"
    },
    {
      "id": "touch-of-death",
      "name": "Touch of Death",
      "category": "Dark Gift",
      "description": "Death Touch: They learn the Chill Touch spell and can cast it without spell components. Necrotic damage they deal with this spell ignores Resistance. Intelligence, Wisdom, or Charisma is their spellcasting ability for this spell (choose when they select this feat).",
      "source": "http://dnd2024.wikidot.com/feat:touch-of-death"
    },
    {
      "id": "tough",
      "name": "Tough",
      "category": "Origin",
      "description": "Their Hit Point maximum increases by an amount equal to twice their character level when they gain this feat. Whenever they gain a character level thereafter, their Hit Point maximum increases by an additional 2 Hit Points.",
      "source": "http://dnd2024.wikidot.com/feat:tough"
    },
    {
      "id": "treacherous-allure",
      "name": "Treacherous Allure",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Enchanting Presence: They always have the Charm Person spell prepared. They can cast it without a spell slot, and they must finish a Long Rest before they can cast it in this way again.",
      "source": "http://dnd2024.wikidot.com/feat:treacherous-allure"
    },
    {
      "id": "two-weapon-fighting",
      "name": "Two Weapon Fighting",
      "category": "Fighting Style",
      "description": "When they make an extra attack as a result of using a weapon that has the Light property, they can add their ability modifier to the damage of that attack if they aren't already adding it to the damage.",
      "source": "http://dnd2024.wikidot.com/feat:two-weapon-fighting"
    },
    {
      "id": "tyro-of-the-gauntlet",
      "name": "Tyro of the Gauntlet",
      "category": "Origin",
      "description": "Stand as One: When an ally within 5 feet of them is subjected to an effect that would push or pull it, they can take a Reaction to prevent that ally from being pushed or pulled. To receive this benefit, the ally can’t have the Incapacitated condition. Vigilant: When they take the Ready action, the next attack roll made against them has Disadvantage before the start of their next turn.",
      "source": "http://dnd2024.wikidot.com/feat:tyro-of-the-gauntlet"
    },
    {
      "id": "unarmed-fighting",
      "name": "Unarmed Fighting",
      "category": "Fighting Style",
      "description": "When they hit with their Unarmed Strike and deal damage, they can deal Bludgeoning damage equal to 1d6 plus their Strength modifier instead of the normal damage of an Unarmed Strike. If they aren't holding any weapons or a Shield when they make the attack roll, the d6 becomes a d8.",
      "source": "http://dnd2024.wikidot.com/feat:unarmed-fighting"
    },
    {
      "id": "vampire-hunter",
      "name": "Vampire Hunter",
      "category": "Origin",
      "description": "Adroit Escape: They have Advantage on checks to escape from nonmagical restraints or the Grappled condition. Vitality Ward: When they take Necrotic damage, they can take a Reaction to mitigate the damage. Roll a number of d6s equal to their Proficiency Bonus, and add them together.",
      "source": "http://dnd2024.wikidot.com/feat:vampire-hunter"
    },
    {
      "id": "vampire-touched",
      "name": "Vampire Touched",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Vampire Magic: Choose one level 1 spell from the Enchantment or Illusion school of magic. They always have that spell and the Spider Climb spell prepared.",
      "source": "http://dnd2024.wikidot.com/feat:vampire-touched"
    },
    {
      "id": "vampire-s-plaything",
      "name": "Vampire's Plaything",
      "category": "Origin",
      "description": "Decanting: When they finish a Long Rest, they can create one Potion of Healing or an Antitoxin, as long as they have an empty vial or flask. These liquids evaporate when they finish another Long Rest. Timely Retreat: They can take a Bonus Action to take the Dash action or the Disengage action.",
      "source": "http://dnd2024.wikidot.com/feat:vampire-s-plaything"
    },
    {
      "id": "war-caster",
      "name": "War Caster",
      "category": "General",
      "description": "Ability Score Increase: Increase their Intelligence, Wisdom, or Charisma score by 1, to a maximum of 20. Concentration: They have Advantage on Constitution saving throws that they make to maintain Concentration. Reactive Spell: When a creature provokes an Opportunity Attack from them by leaving their reach, they can take a Reaction to cast a spell at the creature rather than making an Opportunity Attack.",
      "source": "http://dnd2024.wikidot.com/feat:war-caster"
    },
    {
      "id": "watchers",
      "name": "Watchers",
      "category": "Dark Gift",
      "description": "Borrowed Eyes: They always have the Beast Sense and Speak with Animals spells prepared. They can cast each spell without a spell slot, and they must finish a Long Rest before they can cast it in this way again. They can also cast these spells using spell slots they have of… Heightened Suspicion: Whenever they take the Search action, they can roll 1d4 and add the number rolled to any ability check made as part of that action.",
      "source": "http://dnd2024.wikidot.com/feat:watchers"
    },
    {
      "id": "weapon-master",
      "name": "Weapon Master",
      "category": "General",
      "description": "Ability Score Increase: Increase their Strength or Dexterity score by 1, to a maximum of 20. Mastery Property: Their training with weapons allows they to use the mastery property of one kind of Simple or Martial weapon of their choice, provided they have proficiency with it. Whenever they finish a Long Rest, they can change the kind of weapon to another eligible kind.",
      "source": "http://dnd2024.wikidot.com/feat:weapon-master"
    },
    {
      "id": "zhentarim-ruffian",
      "name": "Zhentarim Ruffian",
      "category": "Origin",
      "description": "Exploit Opening: When they roll damage for an Opportunity Attack, they can roll the damage dice twice and use either roll against the target. Family First: If they have Heroic Inspiration when they roll Initiative, they can expend it to give themselves and their allies Advantage on that Initiative roll.",
      "source": "http://dnd2024.wikidot.com/feat:zhentarim-ruffian"
    },
    {
      "id": "zhentarim-tactics",
      "name": "Zhentarim Tactics",
      "category": "General",
      "description": "Ability Score Increase: Increase their Dexterity or Charisma score by 1, to a maximum of 20. Retaliate: Immediately after a creature within 5 feet of them hits they with a melee attack, they can make an Opportunity Attack against that creature. Versatile Merc: When they finish a Long Rest, choose a skill in which they have proficiency.",
      "source": "http://dnd2024.wikidot.com/feat:zhentarim-tactics"
    }
  ],
  "equipment": [
    {
      "id": "acid",
      "name": "Acid",
      "category": "Adventuring Gear",
      "description": "When they take the Attack action, they can replace one of their attacks with throwing a vial of Acid. Target one creature or object they can see within 20 feet of themselves. The target must succeed on a Dexterity saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus) or take 2d6 Acid damage.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "1 lb."
    },
    {
      "id": "alchemist-s-fire",
      "name": "Alchemist's Fire",
      "category": "Adventuring Gear",
      "description": "When they take the Attack action, they can replace one of their attacks with throwing a flask of Alchemist’s Fire. Target one creature or object they can see within 20 feet of themselves. The target must succeed on a Dexterity saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus) or take 1d4 Fire damage and start burning (see the rules glossary).",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP",
      "weight": "1 lb."
    },
    {
      "id": "ammunition",
      "name": "Ammunition",
      "category": "Adventuring Gear",
      "description": "Ammunition is required by a weapon that has the Ammunition property. A weapon’s description specifies the type of ammunition used by the weapon. The Ammunition table lists the different types and the amount they get when they buy them.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "Varies",
      "weight": "Varies"
    },
    {
      "id": "antitoxin",
      "name": "Antitoxin",
      "category": "Adventuring Gear",
      "description": "As a Bonus Action, they can drink a vial of Antitoxin to gain Advantage on saving throws to avoid or end the Poisoned condition for 1 hour.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP"
    },
    {
      "id": "arcane-focus",
      "name": "Arcane Focus",
      "category": "Adventuring Gear",
      "description": "An Arcane Focus takes one of the forms in the Arcane Focuses table and is bejeweled or carved to channel arcane magic. A Sorcerer, Warlock, or Wizard can use such an item as a Spellcasting Focus.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "Varies",
      "weight": "Varies"
    },
    {
      "id": "backpack",
      "name": "Backpack",
      "category": "Adventuring Gear",
      "description": "A Backpack holds up to 30 pounds within 1 cubic foot. It can also serve as a saddlebag.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "5 lb."
    },
    {
      "id": "ball-bearings",
      "name": "Ball Bearings",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can spill Ball Bearings from their pouch. They spread to cover a level, 10-foot-square area within 10 feet of themselves. A creature that enters this area for the first time on a turn must succeed on a DC 10 Dexterity saving throw or have the Prone condition.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "2 lb."
    },
    {
      "id": "barrel",
      "name": "Barrel",
      "category": "Adventuring Gear",
      "description": "A Barrel holds up to 40 gallons of liquid or up to 4 cubic feet of dry goods.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "70 lb."
    },
    {
      "id": "basket",
      "name": "Basket",
      "category": "Adventuring Gear",
      "description": "A Basket holds up to 40 pounds within 2 cubic feet.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "4 SP",
      "weight": "2 lb."
    },
    {
      "id": "bedroll",
      "name": "Bedroll",
      "category": "Adventuring Gear",
      "description": "A Bedroll sleeps one Small or Medium creature. While in a Bedroll, they automatically succeed on saving throws against extreme cold (see the Dungeon Master’s Guide).",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "7 lb."
    },
    {
      "id": "bell",
      "name": "Bell",
      "category": "Adventuring Gear",
      "description": "When rung as a Utilize action, a Bell produces a sound that can be heard up to 60 feet away.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP"
    },
    {
      "id": "blanket",
      "name": "Blanket",
      "category": "Adventuring Gear",
      "description": "While wrapped in a blanket, they have Advantage on saving throws against extreme cold (see the Dungeon Master’s Guide).",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "3 lb."
    },
    {
      "id": "block-and-tackle",
      "name": "Block and Tackle",
      "category": "Adventuring Gear",
      "description": "A Block and Tackle allows they to hoist up to four times the weight they can normally lift.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "5 lb."
    },
    {
      "id": "book",
      "name": "Book",
      "category": "Adventuring Gear",
      "description": "A Book contains fiction or nonfiction. If they consult an accurate nonfiction Book about its topic, they gain a +5 bonus to Intelligence (Arcana, History, Nature, or Religion) checks they make about that topic.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "5 lb."
    },
    {
      "id": "bottle-glass",
      "name": "Bottle, Glass",
      "category": "Adventuring Gear",
      "description": "A Glass Bottle holds up to 1½ pints.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "2 lb."
    },
    {
      "id": "bright-fungal-cloak",
      "name": "Bright Fungal Cloak",
      "category": "Adventuring Gear",
      "description": "While wearing a Bright Fungal Cloak, they can take a Bonus Action to furl or unfurl it. When the cloak is unfurled, it sheds Bright Light in a 5-foot radius and Dim Light for an additional 5 feet. One pound of fungus is sewn into a Bright Fungal Cloak.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP"
    },
    {
      "id": "bucket",
      "name": "Bucket",
      "category": "Adventuring Gear",
      "description": "A Bucket holds up to half a cubic foot of contents.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 CP",
      "weight": "2 lb."
    },
    {
      "id": "burglar-s-pack",
      "name": "Burglar's Pack",
      "category": "Adventuring Gear",
      "description": "A Burglar’s Pack contains the following items: Backpack, Ball Bearings, Bell, 10 Candles, Crowbar, Hooded Lantern, 7 flasks of Oil, 5 days of Rations, Rope, Tinderbox, and Waterskin.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "16 GP",
      "weight": "42 lb."
    },
    {
      "id": "caltrops",
      "name": "Caltrops",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can spread Caltrops from their bag to cover a 5-foot-square area within 5 feet of themselves. A creature that enters this area for the first time on a turn must succeed on a DC 15 Dexterity saving throw or take 1 Piercing damage and have its Speed reduced to 0 until the start of its next turn. It takes 10 minutes to recover the Caltrops.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "2 lb."
    },
    {
      "id": "candle",
      "name": "Candle",
      "category": "Adventuring Gear",
      "description": "For 1 hour, a lit Candle sheds Bright Light in a 5-foot radius and Dim Light for an additional 5 feet.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 CP"
    },
    {
      "id": "case-crossbow-bolt",
      "name": "Case, Crossbow Bolt",
      "category": "Adventuring Gear",
      "description": "A Crossbow Bolt Case holds up to 20 Bolts.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "1 lb."
    },
    {
      "id": "case-map-or-scroll",
      "name": "Case, Map or Scroll",
      "category": "Adventuring Gear",
      "description": "A Map or Scroll Case holds up to 10 sheets of paper or 5 sheets of parchment.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "1 lb."
    },
    {
      "id": "chain",
      "name": "Chain",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can wrap a Chain around an unwilling creature within 5 feet of themselves that has the Grappled, Incapacitated, or Restrained condition if they succeed on a DC 13 Strength (Athletics) check. If the creature’s legs are bound, the creature has the Restrained condition until it escapes. Escaping the Chain requires the creature to make a successful DC 18 Dexterity (Acrobatics) check as an action.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "10 lb."
    },
    {
      "id": "chest",
      "name": "Chest",
      "category": "Adventuring Gear",
      "description": "A Chest holds up to 12 cubic feet of contents.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "25 lb."
    },
    {
      "id": "climber-s-kit",
      "name": "Climber's Kit",
      "category": "Adventuring Gear",
      "description": "A Climber’s Kit includes boot tips, gloves, pitons, and a harness. As a Utilize action, they can use the Climber’s Kit to anchor themselves; when they do, they can’t fall more than 25 feet from the anchor point, and they can’t move more than 25 feet from there without undoing the anchor as a Bonus Action.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "12 lb."
    },
    {
      "id": "clothes-fine",
      "name": "Clothes, Fine",
      "category": "Adventuring Gear",
      "description": "Fine Clothes are made of expensive fabrics and adorned with expertly crafted details. Some events and locations admit only people wearing these clothes.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "15 GP",
      "weight": "6 lb."
    },
    {
      "id": "clothes-traveler-s",
      "name": "Clothes, Traveler's",
      "category": "Adventuring Gear",
      "description": "Traveler’s Clothes are resilient garments designed for travel in various environments.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "4 lb."
    },
    {
      "id": "component-pouch",
      "name": "Component Pouch",
      "category": "Adventuring Gear",
      "description": "A Component Pouch is watertight and filled with compartments that hold all the free Material components of their spells.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "2 lb."
    },
    {
      "id": "costume",
      "name": "Costume",
      "category": "Adventuring Gear",
      "description": "While wearing a Costume, they have Advantage on any ability check they make to impersonate the person or type of person it represents.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "4 lb."
    },
    {
      "id": "crowbar",
      "name": "Crowbar",
      "category": "Adventuring Gear",
      "description": "Using a Crowbar gives they Advantage on Strength checks where the Crowbar’s leverage can be applied.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "5 lb."
    },
    {
      "id": "desert-clothing",
      "name": "Desert Clothing",
      "category": "Adventuring Gear",
      "description": "When they are wearing Desert Clothing and not wearing Medium or Heavy armor, they automatically succeed on saving throws against the effects of extreme heat. See chapter 3 of the Dungeon Master’s Guide for rules on extreme heat.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP"
    },
    {
      "id": "devil-mask",
      "name": "Devil Mask",
      "category": "Adventuring Gear",
      "description": "While they are wearing a Devil Mask, other creatures have Disadvantage on Intelligence (Investigation) and Wisdom (Insight) checks made to discern their true identity or intentions.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP"
    },
    {
      "id": "diplomat-s-pack",
      "name": "Diplomat's Pack",
      "category": "Adventuring Gear",
      "description": "A Diplomat’s Pack contains the following items: Chest, Fine Clothes, Ink, 5 Ink Pens, Lamp, 2 Map or Scroll Cases, 4 flasks of Oil, 5 sheets of Paper, 5 sheets of Parchment, Perfume, and Tinderbox.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "39 GP",
      "weight": "39 lb."
    },
    {
      "id": "druidic-focus",
      "name": "Druidic Focus",
      "category": "Adventuring Gear",
      "description": "A Druidic Focus takes one of the forms in the Druidic Focuses table and is carved, tied with ribbon, or painted to channel primal magic. A Druid or Ranger can use such an object as a Spellcasting Focus.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "Varies",
      "weight": "Varies"
    },
    {
      "id": "dungeoneer-s-pack",
      "name": "Dungeoneer's Pack",
      "category": "Adventuring Gear",
      "description": "A Dungeoneer’s Pack contains the following items: Backpack, Caltrops, Crowbar, 2 flasks of Oil, 10 days of Rations, Rope, Tinderbox, 10 Torches, and Waterskin.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "12 GP",
      "weight": "55 lb."
    },
    {
      "id": "entertainer-s-pack",
      "name": "Entertainer's Pack",
      "category": "Adventuring Gear",
      "description": "An Entertainer’s Pack contains the following items: Backpack, Bedroll, Bell, Bullseye Lantern, 3 Costumes, Mirror, 8 flasks of Oil, 9 days of Rations, Tinderbox, and Waterskin.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "40 GP",
      "weight": "58½ lb."
    },
    {
      "id": "explorer-s-pack",
      "name": "Explorer's Pack",
      "category": "Adventuring Gear",
      "description": "An Explorer’s Pack contains the following items: Backpack, Bedroll, 2 flasks of Oil, 10 days of Rations, Rope, Tinderbox, 10 Torches, and Waterskin.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "10 GP",
      "weight": "55 lb."
    },
    {
      "id": "flask",
      "name": "Flask",
      "category": "Adventuring Gear",
      "description": "A Flask holds up to 1 pint.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 CP",
      "weight": "1 lb."
    },
    {
      "id": "garb-of-light-and-shadow",
      "name": "Garb of Light and Shadow",
      "category": "Adventuring Gear",
      "description": "This garb appeals to Fey from one Domain of Delight, such as the Gloaming Court or the Summer Court. While wearing the garb, they have Advantage on ability checks to influence Fey associated with that Domain of Delight.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP"
    },
    {
      "id": "genie-robe",
      "name": "Genie Robe",
      "category": "Adventuring Gear",
      "description": "This robe appeals to Elementals associated with a particular Elemental Plane (Air, Earth, Fire, Water). While wearing a Genie Robe, they have Advantage on ability checks made to influence Elementals associated with that plane.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP"
    },
    {
      "id": "grappling-hook",
      "name": "Grappling Hook",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can throw the Grappling Hook at a railing, a ledge, or another catch within 50 feet of themselves, and the hook catches on if they succeed on a DC 13 Dexterity (Acrobatics) check. If they tied a Rope to the hook, they can then climb it.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "4 lb."
    },
    {
      "id": "healer-s-kit",
      "name": "Healer's Kit",
      "category": "Adventuring Gear",
      "description": "A Healer’s Kit has ten uses. As a Utilize action, they can expend one of its uses to stabilize an Unconscious creature that has 0 Hit Points without needing to make a Wisdom (Medicine) check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "3 lb."
    },
    {
      "id": "holy-symbol",
      "name": "Holy Symbol",
      "category": "Adventuring Gear",
      "description": "A Holy Symbol takes one of the forms in the Holy Symbol table and is bejeweled or painted to channel divine magic. A Cleric or Paladin can use a Holy Symbol as a Spellcasting Focus.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "Varies",
      "weight": "Varies"
    },
    {
      "id": "holy-water",
      "name": "Holy Water",
      "category": "Adventuring Gear",
      "description": "When they take the Attack action, they can replace one of their attacks with throwing a flask of Holy Water. Target one creature they can see within 20 feet of themselves. The target must succeed on a Dexterity saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus) or take 2d8 Radiant damage if it is a Fiend or an Undead.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "1 lb."
    },
    {
      "id": "hunting-trap",
      "name": "Hunting Trap",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can set a Hunting Trap, which is a sawtooth steel ring that snaps shut when a creature steps on a pressure plate in the center. The trap is affixed by a heavy chain to an immobile object, such as a tree or a spike driven into the ground. A creature that steps on the plate must succeed on a DC 13 Dexterity saving throw or take 1d4 Piercing damage and have its Speed reduced to 0 until the start of its next turn.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "25 lb."
    },
    {
      "id": "ink",
      "name": "Ink",
      "category": "Adventuring Gear",
      "description": "Ink comes in a 1-ounce bottle, which provides enough ink to write about 500 pages.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "10 GP"
    },
    {
      "id": "ink-pen",
      "name": "Ink Pen",
      "category": "Adventuring Gear",
      "description": "Using Ink, an Ink Pen is used to write or draw.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 CP"
    },
    {
      "id": "jug",
      "name": "Jug",
      "category": "Adventuring Gear",
      "description": "A Jug holds up to 1 gallon.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 CP",
      "weight": "4 lb."
    },
    {
      "id": "ladder",
      "name": "Ladder",
      "category": "Adventuring Gear",
      "description": "A Ladder is 10 feet tall. They must climb to move up or down it.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP",
      "weight": "25 lb."
    },
    {
      "id": "lamp",
      "name": "Lamp",
      "category": "Adventuring Gear",
      "description": "A Lamp burns Oil as fuel to cast Bright Light in a 15-foot radius and Dim Light for an additional 30 feet.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "1 lb."
    },
    {
      "id": "lantern-bullseye",
      "name": "Lantern, Bullseye",
      "category": "Adventuring Gear",
      "description": "A Bullseye Lantern burns Oil as fuel to cast Bright Light in a 60-foot Cone and Dim Light for an additional 60 feet.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "10 GP",
      "weight": "2 lb."
    },
    {
      "id": "lantern-hooded",
      "name": "Lantern, Hooded",
      "category": "Adventuring Gear",
      "description": "A Hooded Lantern burns Oil as fuel to cast Bright Light in a 30-foot radius and Dim Light for an additional 30 feet. As a Bonus Action, they can lower the hood, reducing the light to Dim Light in a 5-foot radius, or raise it again.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "2 lb."
    },
    {
      "id": "lock",
      "name": "Lock",
      "category": "Adventuring Gear",
      "description": "A Lock comes with a key. Without the key, a creature can use Thieves’ Tools to pick this Lock with a successful DC 15 Dexterity (Sleight of Hand) check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "10 GP",
      "weight": "1 lb."
    },
    {
      "id": "locking-spellbook",
      "name": "Locking Spellbook",
      "category": "Adventuring Gear",
      "description": "This 100-page leather-bound tome can be used as a Spellbook. It is closed with a lock that comes with a key. As a Utilize action, a creature can try to pick the lock using Thieves’ Tools, doing so with a successful DC 15 Dexterity (Sleight of Hand) check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "35 GP"
    },
    {
      "id": "magnifying-glass",
      "name": "Magnifying Glass",
      "category": "Adventuring Gear",
      "description": "A Magnifying Glass grants Advantage on any ability check made to appraise or inspect a highly detailed item. Lighting a fire with a Magnifying Glass requires light as bright as sunlight to focus, tinder to ignite, and about 5 minutes for the fire to ignite.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "100 GP"
    },
    {
      "id": "manacles",
      "name": "Manacles",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can use Manacles to bind an unwilling Small or Medium creature within 5 feet of themselves that has the Grappled, Incapacitated, or Restrained condition if they succeed on a DC 13 Dexterity (Sleight of Hand) check. While bound, a creature has Disadvantage on attack rolls, and the creature is Restrained if the Manacles are attached to a chain or hook that is fixed in place. Escaping the Manacles requires a successful DC 20 Dexterity (Sleight of Hand) check as an action.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "6 lb."
    },
    {
      "id": "map",
      "name": "Map",
      "category": "Adventuring Gear",
      "description": "If they consult an accurate Map, they gain a +5 bonus to Wisdom (Survival) checks they make to find their way in the place represented on it.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP"
    },
    {
      "id": "mirror",
      "name": "Mirror",
      "category": "Adventuring Gear",
      "description": "A handheld steel Mirror is useful for personal cosmetics but also for peeking around corners and reflecting light as a signal.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "1/2 lb."
    },
    {
      "id": "monster-camouflage",
      "name": "Monster Camouflage",
      "category": "Adventuring Gear",
      "description": "A suit of Monster Camouflage looks like a Beast or Monstrosity, such as an owlbear. To discern that they are disguised, a creature must take the Study action to inspect their appearance and succeed on a DC 10 Intelligence (Investigation or Nature) check. The creature has Advantage on this check if it is within 30 feet of them and automatically succeeds on this check if they do anything the monster they are disguised as couldn’t do.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP"
    },
    {
      "id": "net",
      "name": "Net",
      "category": "Adventuring Gear",
      "description": "When they take the Attack action, they can replace one of their attacks with throwing a Net. Target a creature they can see within 15 feet of themselves. The target must succeed on a Dexterity saving throw (DC 8 plus their Dexterity modifier and Proficiency Bonus) or have the Restrained condition until it escapes.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "3 lb."
    },
    {
      "id": "oil",
      "name": "Oil",
      "category": "Adventuring Gear",
      "description": "They can douse a creature, object, or space with Oil or use it as fuel, as detailed below. Dousing a Creature or an Object. When they take the Attack action, they can replace one of their attacks with throwing an Oil flask.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP",
      "weight": "1 lb."
    },
    {
      "id": "paper",
      "name": "Paper",
      "category": "Adventuring Gear",
      "description": "One sheet of Paper can hold about 250 handwritten words.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 SP"
    },
    {
      "id": "parchment",
      "name": "Parchment",
      "category": "Adventuring Gear",
      "description": "One sheet of Parchment can hold about 250 handwritten words.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP"
    },
    {
      "id": "perfume",
      "name": "Perfume",
      "category": "Adventuring Gear",
      "description": "Perfume comes in a 4-ounce vial. For 1 hour after applying Perfume to themselves, they have Advantage on Charisma (Persuasion) checks made to influence an Indifferent Humanoid within 5 feet of themselves.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP"
    },
    {
      "id": "poison-basic",
      "name": "Poison, Basic",
      "category": "Adventuring Gear",
      "description": "As a Bonus Action, they can use a vial of Basic Poison to coat one weapon or up to three pieces of ammunition. A creature that takes Piercing or Slashing damage from the poisoned weapon or ammunition takes an extra 1d4 Poison damage. Once applied, the poison retains potency for 1 minute or until its damage is dealt, whichever comes first.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "100 GP"
    },
    {
      "id": "pole",
      "name": "Pole",
      "category": "Adventuring Gear",
      "description": "A Pole is 10 feet long. They can use it to touch something up to 10 feet away. If they must make a Strength (Athletics) check as part of a High or Long Jump, they can use the Pole to vault, giving themselves Advantage on the check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 CP",
      "weight": "7 lb."
    },
    {
      "id": "pot-iron",
      "name": "Pot, Iron",
      "category": "Adventuring Gear",
      "description": "An Iron Pot holds up to 1 gallon.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "10 lb."
    },
    {
      "id": "potion-of-healing",
      "name": "Potion of Healing",
      "category": "Adventuring Gear",
      "description": "This potion is a magic item. As a Bonus Action, they can drink it or administer it to another creature within 5 feet of themselves. The creature that drinks the magical red fluid in this vial regains 2d4 + 2 Hit Points.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP",
      "weight": "1/2 lb."
    },
    {
      "id": "pouch",
      "name": "Pouch",
      "category": "Adventuring Gear",
      "description": "A Pouch holds up to 6 pounds within one-fifth of a cubic foot.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "1 lb."
    },
    {
      "id": "priest-s-pack",
      "name": "Priest's Pack",
      "category": "Adventuring Gear",
      "description": "A Priest’s Pack contains the following items: Backpack, Blanket, Holy Water, Lamp, 7 days of Rations, Robe, and Tinderbox.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "33 GP",
      "weight": "29 lb."
    },
    {
      "id": "quiver",
      "name": "Quiver",
      "category": "Adventuring Gear",
      "description": "A Quiver holds up to 20 Arrows.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "1 lb."
    },
    {
      "id": "ram-portable",
      "name": "Ram, Portable",
      "category": "Adventuring Gear",
      "description": "They can use a Portable Ram to break down doors. When doing so, they gain a +4 bonus to the Strength check. One other character can help they use the ram, giving they Advantage on this check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "4 GP",
      "weight": "35 lb."
    },
    {
      "id": "rations",
      "name": "Rations",
      "category": "Adventuring Gear",
      "description": "Rations consist of travel-ready food, including jerky, dried fruit, hardtack, and nuts. See “Malnutrition” in the rules glossary for the risks of not eating.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "2 lb."
    },
    {
      "id": "robe",
      "name": "Robe",
      "category": "Adventuring Gear",
      "description": "A Robe has vocational or ceremonial significance. Some events and locations admit only people wearing a Robe bearing certain colors or symbols.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "4 lb."
    },
    {
      "id": "rope",
      "name": "Rope",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, they can tie a knot with Rope if they succeed on a DC 10 Dexterity (Sleight of Hand) check. The Rope can be burst with a successful DC 20 Strength (Athletics) check. They can bind an unwilling creature with the Rope only if the creature has the Grappled, Incapacitated, or Restrained condition. If the creature’s legs are bound, the creature has the Restrained condition until it escapes.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "5 lb."
    },
    {
      "id": "sack",
      "name": "Sack",
      "category": "Adventuring Gear",
      "description": "A Sack holds up to 30 pounds within 1 cubic foot.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 CP",
      "weight": "1/2 lb."
    },
    {
      "id": "scholar-s-pack",
      "name": "Scholar's Pack",
      "category": "Adventuring Gear",
      "description": "A Scholar’s Pack contains the following items: Backpack, Book, Ink, Ink Pen, Lamp, 10 flasks of Oil, 10 sheets of Parchment, and Tinderbox.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "40 GP",
      "weight": "22 lb."
    },
    {
      "id": "shovel",
      "name": "Shovel",
      "category": "Adventuring Gear",
      "description": "Working for 1 hour, they can use a Shovel to dig a hole that is 5 feet on each side in soil or similar material.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "5 lb."
    },
    {
      "id": "signal-whistle",
      "name": "Signal Whistle",
      "category": "Adventuring Gear",
      "description": "When blown as a Utilize action, a Signal Whistle produces a sound that can be heard up to 600 feet away.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 CP"
    },
    {
      "id": "spell-scroll-cantrip",
      "name": "Spell Scroll (Cantrip)",
      "category": "Adventuring Gear",
      "description": "A Spell Scroll (Cantrip) is a magic item that bears the words of a cantrip determined by the scroll’s creator. If the spell is on their class’s spell list, they can read the scroll and cast the spell using its normal casting time and without providing any Material components. If the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "30 GP"
    },
    {
      "id": "spell-scroll-level-1",
      "name": "Spell Scroll (Level 1)",
      "category": "Adventuring Gear",
      "description": "A Spell Scroll (Level 1) is a magic item that bears the words of a level 1 spell, respectively, determined by the scroll’s creator. If the spell is on their class’s spell list, they can read the scroll and cast the spell using its normal casting time and without providing any Material components. If the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP"
    },
    {
      "id": "spikes-iron",
      "name": "Spikes, Iron",
      "category": "Adventuring Gear",
      "description": "Iron Spikes come in bundles of ten. As a Utilize action, they can use a blunt object, such as a Light Hammer, to hammer a spike into wood, earth, or a similar material. They can do so to jam a door shut or to then tie a Rope or Chain to the Spike.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "5 lb."
    },
    {
      "id": "spyglass",
      "name": "Spyglass",
      "category": "Adventuring Gear",
      "description": "Objects viewed through a Spyglass are magnified to twice their size.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1,000 GP",
      "weight": "1 lb."
    },
    {
      "id": "string",
      "name": "String",
      "category": "Adventuring Gear",
      "description": "String is 10 feet long. They can tie a knot in it as a Utilize action.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP"
    },
    {
      "id": "tent",
      "name": "Tent",
      "category": "Adventuring Gear",
      "description": "A Tent sleeps up to two Small or Medium creatures.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "20 lb."
    },
    {
      "id": "tinderbox",
      "name": "Tinderbox",
      "category": "Adventuring Gear",
      "description": "A Tinderbox is a small container holding flint, fire steel, and tinder (usually dry cloth soaked in light oil) used to kindle a fire. Using it to light a Candle, Lamp, Lantern, or Torch—or anything else with exposed fuel—takes a Bonus Action. Lighting any other fire takes 1 minute.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "1 lb."
    },
    {
      "id": "torch",
      "name": "Torch",
      "category": "Adventuring Gear",
      "description": "A Torch burns for 1 hour, casting Bright Light in a 20-foot radius and Dim Light for an additional 20 feet. When they take the Attack action, they can attack with the Torch, using it as a Simple Melee weapon. On a hit, the target takes 1 Fire damage.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 CP",
      "weight": "1 lb."
    },
    {
      "id": "vial",
      "name": "Vial",
      "category": "Adventuring Gear",
      "description": "A Vial holds up to 4 ounces.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP"
    },
    {
      "id": "warm-fungal-clothing",
      "name": "Warm Fungal Clothing",
      "category": "Adventuring Gear",
      "description": "When they are wearing Warm Fungal Clothing, they automatically succeed on saving throws against the effects of extreme cold. See chapter 3 of the Dungeon Master’s Guide for rules on extreme cold. One pound of fungus is sewn into Fungal Clothing.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "15 GP"
    },
    {
      "id": "waterskin",
      "name": "Waterskin",
