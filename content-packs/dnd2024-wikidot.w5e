      "range": "60 feet",
      "components": "S, M",
      "duration": "Instantaneous",
      "description": "A ranged spell attack deals 3d4 Radiant damage on a hit, then flashes whether it hits or misses. The target and nearby creatures make Constitution saves or become Blinded until the end of their next turns; higher slots add 1d4 damage per level.",
      "source": "http://dnd2024.wikidot.com/spell:searing-orb"
    },
    {
      "id": "see-invisibility",
      "name": "See Invisibility",
      "level": 2,
