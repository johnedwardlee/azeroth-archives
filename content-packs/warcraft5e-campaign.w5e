    },
    {
      "id": "holy-symbol",
      "name": "Holy Symbol",
      "category": "Adventuring Gear",
      "description": "A Holy Symbol is bejeweled or painted to channel sacred magic. Priests and Paladins can use one as a Spellcasting Focus.",
