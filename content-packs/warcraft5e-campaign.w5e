      "weight": "5 lb.",
      "properties": []
    },
    {
      "id": "ball-bearings",
      "name": "Ball Bearings",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, you can spill Ball Bearings from your pouch. You spread to cover a level, 10-foot-square area within 10 feet of yourself. A creature that enters this area for the first time on a turn must succeed on a DC 10 Agility saving throw or have the Prone condition.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "2 lb.",
      "properties": []
    },
    {
      "id": "barrel",
