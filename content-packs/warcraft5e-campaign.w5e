    {
      "id": "assassins-blood",
      "name": "Assassin’s Blood",
      "category": "Sample Poisons",
      "description": "A creature subjected to Assassin's Blood makes a DC 10 Stamina saving throw. On a failed save, the creature takes 6 (1d12) Poison damage and has the Poisoned condition for 24 hours. On a successful save, the creature takes half as much damage only. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "150 GP",
      "properties": []
    },
    {
      "id": "burnt-othur-fumes",
      "name": "Burnt Othur Fumes",
      "category": "Sample Poisons",
      "description": "A creature subjected to Burnt Othur Fumes must succeed on a DC 13 Stamina saving throw or take 10 (3d6) Poison damage, and it must repeat the save at the start of each of its turns. On each successive failed save, the creature takes 3 (1d6) Poison damage. After three successful saves, the poison ends. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "500 GP",
      "properties": []
    },
    {
      "id": "carrion-crawler-mucus",
      "name": "Carrion Crawler Mucus",
      "category": "Sample Poisons",
      "description": "A creature subjected to Carrion Crawler Mucus must succeed on a DC 13 Stamina saving throw or have the Poisoned condition for 1 minute. The creature also has the Paralyzed condition while Poisoned in this way. The creature repeats the save at the end of each of its turns, ending the effect on itself on a success. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "200 GP",
      "properties": []
    },
    {
      "id": "essence-of-ether",
      "name": "Essence of Ether",
      "category": "Sample Poisons",
      "description": "A creature subjected to Essence of Ether must succeed on a DC 15 Stamina saving throw or have the Poisoned condition for 8 hours. The creature also has the Unconscious condition while Poisoned in this way. The creature wakes up if it takes damage or if another creature takes an action to shake it awake. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "300 GP",
      "properties": []
    },
    {
      "id": "lolths-sting",
      "name": "Shadra's Sting",
      "category": "Sample Poisons",
      "description": "A creature subjected to Shadra's Sting must succeed on a DC 13 Stamina saving throw or have the Poisoned condition for 1 hour. If the creature fails the save by 5 or more, the creature also has the Unconscious condition while Poisoned in this way. The creature wakes up if it takes damage or if another creature takes an action to shake it awake. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "200 GP",
      "aliases": [
        "Lolth’s Sting"
      ],
      "properties": []
    },
    {
      "id": "malice",
      "name": "Malice",
      "category": "Sample Poisons",
      "description": "A creature subjected to Malice must succeed on a DC 15 Stamina saving throw or have the Poisoned condition for 1 hour. The creature also has the Blinded condition while Poisoned in this way. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "250 GP",
      "properties": []
    },
    {
      "id": "midnight-tears",
      "name": "Midnight Tears",
      "category": "Sample Poisons",
      "description": "A creature that ingests Midnight Tears suffers no effect until the stroke of midnight. Any effect that ends the Poisoned condition neutralizes this poison. If the poison hasn't been neutralized before midnight, the creature makes a DC 17 Stamina saving throw, taking 31 (9d6) Poison damage on a failed save or half as much damage on a successful one. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "1,500 GP",
      "properties": []
    },
    {
      "id": "oil-of-taggit",
      "name": "Oil of Taggit",
      "category": "Sample Poisons",
      "description": "A creature subjected to Oil of Taggit must succeed on a DC 13 Stamina saving throw or have the Poisoned condition for 24 hours. The creature also has the Unconscious condition while Poisoned in this way. It wakes up if it takes damage. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "400 GP",
      "properties": []
    },
    {
      "id": "pale-tincture",
      "name": "Pale Tincture",
      "category": "Sample Poisons",
      "description": "A creature subjected to Pale Tincture must succeed on a DC 16 Stamina saving throw or take 3 (1d6) Poison damage and have the Poisoned condition. The Poisoned creature repeats the save every 24 hours, taking 3 (1d6) Poison damage on a failed save. The damage the poison deals can't be healed by any means while the creature remains Poisoned. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "250 GP",
      "properties": []
    },
    {
      "id": "purple-worm-poison",
      "name": "Deep-Worm Poison",
      "category": "Sample Poisons",
      "description": "A creature subjected to Deep-Worm Poison makes a DC 21 Stamina saving throw, taking 35 (10d6) Poison damage on a failed save or half as much damage on a successful one. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "2,000 GP",
      "aliases": [
        "Purple Worm Poison"
      ],
      "properties": []
    },
    {
      "id": "serpent-venom",
      "name": "Serpent Venom",
      "category": "Sample Poisons",
      "description": "A creature subjected to Serpent Venom must succeed on a DC 11 Stamina saving throw, taking 10 (3d6) Poison damage on a failed save or half as much damage on a successful one. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "200 GP",
      "properties": []
    },
    {
      "id": "torpor",
      "name": "Torpor",
      "category": "Sample Poisons",
      "description": "A creature subjected to Torpor poison must succeed on a DC 15 Stamina saving throw or have the Poisoned condition for 4d6 hours. The creature's Speed is halved while the creature is Poisoned in this way. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "600 GP",
      "properties": []
    },
    {
      "id": "truth-serum",
      "name": "Truth Serum",
      "category": "Sample Poisons",
      "description": "A creature subjected to Truth Serum must succeed on a DC 11 Stamina saving throw or have the Poisoned condition for 1 hour. The Poisoned creature can't knowingly communicate a lie. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:poison",
      "cost": "150 GP",
      "properties": []
    },
