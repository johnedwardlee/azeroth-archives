      "cost": "Varies",
      "weight": "Varies",
      "properties": []
    },
    {
      "id": "holy-water",
      "name": "Holy Water",
      "category": "Adventuring Gear",
      "description": "When you take the Attack action, you can replace one of your attacks with throwing a flask of Holy Water. Target one creature you can see within 20 feet of yourself. The target must succeed on an Agility saving throw (DC 8 plus your Agility modifier and Proficiency Bonus) or take 2d8 Radiant damage if it is a Fiend or an Undead.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "25 GP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "hunting-trap",
      "name": "Hunting Trap",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, you can set a Hunting Trap, which is a sawtooth steel ring that snaps shut when a creature steps on a pressure plate in the center. The trap is affixed by a heavy chain to an immobile object, such as a tree or a spike driven into the ground. A creature that steps on the plate must succeed on a DC 13 Agility saving throw or take 1d4 Piercing damage and have its Speed reduced to 0 until the start of its next turn.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "25 lb.",
      "properties": []
    },
    {
