      "properties": []
    },
    {
      "id": "lock",
      "name": "Lock",
      "category": "Adventuring Gear",
      "description": "A Lock comes with a key. Without the key, a creature can use Thieves' Tools to pick this Lock with a successful DC 15 Agility (Sleight of Hand) check.",
