    },
    {
      "id": "mirror",
      "name": "Mirror",
      "category": "Adventuring Gear",
      "description": "A handheld steel Mirror is useful for personal cosmetics but also for peeking around corners and reflecting light as a signal.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "weight": "1/2 lb.",
      "properties": []
    },
    {
      "id": "net",
      "name": "Net",
      "category": "Adventuring Gear",
      "description": "When you take the Attack action, you can replace one of your attacks with throwing a Net. Target a creature you can see within 15 feet of yourself. The target must succeed on an Agility saving throw (DC 8 plus your Agility modifier and Proficiency Bonus) or have the Restrained condition until it escapes.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "3 lb.",
      "properties": []
    },
    {
      "id": "oil",
      "name": "Oil",
      "category": "Adventuring Gear",
      "description": "You can douse a creature, object, or space with Oil or use it as fuel, as detailed below. Dousing a Creature or an Object. When you take the Attack action, you can replace one of your attacks with throwing an Oil flask.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "paper",
      "name": "Paper",
      "category": "Adventuring Gear",
      "description": "One sheet of Paper can hold about 250 handwritten words.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 SP",
      "properties": []
    },
    {
      "id": "parchment",
      "name": "Parchment",
      "category": "Adventuring Gear",
      "description": "One sheet of Parchment can hold about 250 handwritten words.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP",
      "properties": []
    },
    {
      "id": "perfume",
      "name": "Perfume",
      "category": "Adventuring Gear",
      "description": "Perfume comes in a 4-ounce vial. For 1 hour after applying Perfume to yourself, you have Advantage on Charisma (Persuasion) checks made to influence an Indifferent Humanoid within 5 feet of yourself.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 GP",
      "properties": []
    },
    {
      "id": "poison-basic",
      "name": "Poison, Basic",
      "category": "Adventuring Gear",
      "description": "As a Bonus Action, you can use a vial of Basic Poison to coat one weapon or up to three pieces of ammunition. A creature that takes Piercing or Slashing damage from the poisoned weapon or ammunition takes an extra 1d4 Poison damage. Once applied, the poison retains potency for 1 minute or until its damage is dealt, whichever comes first.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "100 GP",
      "properties": []
    },
    {
      "id": "pole",
      "name": "Pole",
      "category": "Adventuring Gear",
      "description": "A Pole is 10 feet long. You can use it to touch something up to 10 feet away. If you must make a Strength (Athletics) check as part of a High or Long Jump, you can use the Pole to vault, giving yourself Advantage on the check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 CP",
      "weight": "7 lb.",
      "properties": []
    },
    {
      "id": "pot-iron",
      "name": "Pot, Iron",
      "category": "Adventuring Gear",
      "description": "An Iron Pot holds up to 1 gallon.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "10 lb.",
      "properties": []
    },
    {
      "id": "potion-of-healing",
      "name": "Potion of Healing",
      "category": "Adventuring Gear",
      "description": "This potion is a magic item. As a Bonus Action, you can drink it or administer it to another creature within 5 feet of yourself. The creature that drinks the magical red fluid in this vial regains 2d4 + 2 Hit Points. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP",
      "weight": "1/2 lb.",
      "properties": []
    },
    {
      "id": "pouch",
      "name": "Pouch",
      "category": "Adventuring Gear",
      "description": "A Pouch holds up to 6 pounds within one-fifth of a cubic foot.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "priest-s-pack",
      "name": "Priest's Pack",
      "category": "Adventuring Gear",
      "description": "A Priest's Pack contains the following items: Backpack, Blanket, Holy Water, Lamp, 7 days of Rations, Robe, and Tinderbox.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "33 GP",
      "weight": "29 lb.",
      "properties": []
    },
    {
      "id": "quiver",
      "name": "Quiver",
      "category": "Adventuring Gear",
      "description": "A Quiver holds up to 20 Arrows.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "ram-portable",
      "name": "Ram, Portable",
      "category": "Adventuring Gear",
      "description": "You can use a Portable Ram to break down doors. When doing so, you gain a +4 bonus to the Strength check. One other character can help you use the ram, giving you Advantage on this check.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "4 GP",
      "weight": "35 lb.",
      "properties": []
    },
    {
      "id": "rations",
      "name": "Rations",
      "category": "Adventuring Gear",
      "description": "Rations consist of travel-ready food, including jerky, dried fruit, hardtack, and nuts. See \"Malnutrition\" in the rules glossary for the risks of not eating.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "2 lb.",
      "properties": []
    },
    {
      "id": "robe",
      "name": "Robe",
      "category": "Adventuring Gear",
      "description": "A Robe has vocational or ceremonial significance. Some events and locations admit only people wearing a Robe bearing certain colors or symbols.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "4 lb.",
      "properties": []
    },
    {
      "id": "rope",
      "name": "Rope",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, you can tie a knot with Rope if you succeed on a DC 10 Agility (Sleight of Hand) check. The Rope can be burst with a successful DC 20 Strength (Athletics) check. You can bind an unwilling creature with the Rope only if the creature has the Grappled, Incapacitated, or Restrained condition. If the creature's legs are bound, the creature has the Restrained condition until it escapes.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "5 lb.",
      "properties": []
    },
    {
      "id": "sack",
      "name": "Sack",
      "category": "Adventuring Gear",
      "description": "A Sack holds up to 30 pounds within 1 cubic foot.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 CP",
      "weight": "1/2 lb.",
      "properties": []
    },
    {
      "id": "scholar-s-pack",
      "name": "Scholar's Pack",
      "category": "Adventuring Gear",
      "description": "A Scholar's Pack contains the following items: Backpack, Book, Ink, Ink Pen, Lamp, 10 flasks of Oil, 10 sheets of Parchment, and Tinderbox.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "40 GP",
      "weight": "22 lb.",
      "properties": []
    },
    {
      "id": "shovel",
      "name": "Shovel",
      "category": "Adventuring Gear",
      "description": "Working for 1 hour, you can use a Shovel to dig a hole that is 5 feet on each side in soil or similar material.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "5 lb.",
      "properties": []
    },
    {
      "id": "signal-whistle",
      "name": "Signal Whistle",
      "category": "Adventuring Gear",
      "description": "When blown as a Utilize action, a Signal Whistle produces a sound that can be heard up to 600 feet away.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 CP",
      "properties": []
    },
    {
      "id": "spell-scroll-cantrip",
      "name": "Spell Scroll (Cantrip)",
      "category": "Adventuring Gear",
      "description": "A Spell Scroll (Cantrip) is a magic item that bears the words of a cantrip determined by the scroll's creator. If the spell is on your class's spell list, you can read the scroll and cast the spell using its normal casting time and without providing any Material components. If the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "30 GP",
      "properties": []
    },
    {
      "id": "spell-scroll-level-1",
      "name": "Spell Scroll (Level 1)",
      "category": "Adventuring Gear",
      "description": "A Spell Scroll (Level 1) is a magic item that bears the words of a level 1 spell, respectively, determined by the scroll's creator. If the spell is on your class's spell list, you can read the scroll and cast the spell using its normal casting time and without providing any Material components. If the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5. GM approval is required at character creation.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "50 GP",
      "properties": []
    },
    {
      "id": "spikes-iron",
      "name": "Spikes, Iron",
      "category": "Adventuring Gear",
      "description": "Iron Spikes come in bundles of ten. As a Utilize action, you can use a blunt object, such as a Light Hammer, to hammer a spike into wood, earth, or a similar material. You can do so to jam a door shut or to then tie a Rope or Chain to the Spike.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "5 lb.",
      "properties": []
    },
    {
      "id": "spyglass",
      "name": "Spyglass",
      "category": "Adventuring Gear",
      "description": "Objects viewed through a Spyglass are magnified to twice your size.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1,000 GP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "string",
      "name": "String",
      "category": "Adventuring Gear",
      "description": "String is 10 feet long. You can tie a knot in it as a Utilize action.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 SP",
      "properties": []
    },
    {
      "id": "tent",
      "name": "Tent",
      "category": "Adventuring Gear",
      "description": "A Tent sleeps up to two Small or Medium creatures.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 GP",
      "weight": "20 lb.",
      "properties": []
    },
    {
      "id": "tinderbox",
      "name": "Tinderbox",
      "category": "Adventuring Gear",
      "description": "A Tinderbox is a small container holding flint, fire steel, and tinder (usually dry cloth soaked in light oil) used to kindle a fire. Using it to light a Candle, Lamp, Lantern, or Torch—or anything else with exposed fuel—takes a Bonus Action. Lighting any other fire takes 1 minute.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "5 SP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "torch",
      "name": "Torch",
      "category": "Adventuring Gear",
      "description": "A Torch burns for 1 hour, casting Bright Light in a 20-foot radius and Dim Light for an additional 20 feet. When you take the Attack action, you can attack with the Torch, using it as a Simple Melee weapon. On a hit, the target takes 1 Fire damage.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 CP",
      "weight": "1 lb.",
      "properties": []
    },
    {
      "id": "vial",
      "name": "Vial",
      "category": "Adventuring Gear",
      "description": "A Vial holds up to 4 ounces.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "properties": []
    },
    {
      "id": "waterskin",
      "name": "Waterskin",
      "category": "Adventuring Gear",
      "description": "A Waterskin holds up to 4 pints. If you don't drink sufficient water, you risk dehydration (see the rules glossary).",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "2 SP",
      "weight": "5 lb. (full)",
      "properties": []
    },
