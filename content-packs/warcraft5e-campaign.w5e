    },
    {
      "id": "caltrops",
      "name": "Caltrops",
      "category": "Adventuring Gear",
      "description": "As a Utilize action, you can spread Caltrops from your bag to cover a 5-foot-square area within 5 feet of yourself. A creature that enters this area for the first time on a turn must succeed on a DC 15 Agility saving throw or take 1 Piercing damage and have its Speed reduced to 0 until the start of its next turn. It takes 10 minutes to recover the Caltrops.",
      "source": "http://dnd2024.wikidot.com/equipment:adventuring-gear",
      "cost": "1 GP",
      "weight": "2 lb.",
      "properties": []
    },
    {
