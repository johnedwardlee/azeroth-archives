{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azeroth-archives.local/schemas/warcraft5e-content.schema.json",
  "title": "Warcraft 5E Content Pack",
  "description": "Schema 2.0 adds subclasses, feats, equipment, spells, creatures, and rules while remaining compatible with schema 1.0 packs.",
  "type": "object",
  "required": ["schemaVersion", "pack"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "enum": ["1.0", "2.0"] },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "ancestries": {
      "type": "array",
      "items": { "$ref": "#/$defs/ancestry" }
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/class" }
    },
    "backgrounds": {
      "type": "array",
      "items": { "$ref": "#/$defs/background" }
    },
    "feats": {
      "type": "array",
      "items": { "$ref": "#/$defs/feat" }
    },
    "equipment": {
      "type": "array",
      "items": { "$ref": "#/$defs/equipment" }
    },
    "spells": {
      "type": "array",
      "items": { "$ref": "#/$defs/spell" }
    },
    "creatures": {
      "type": "array",
      "items": { "$ref": "#/$defs/creature" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "ability": { "enum": ["strength", "agility", "stamina", "intellect", "spirit", "charisma"] },
    "feature": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "ancestry": {
      "type": "object",
      "required": ["id", "name", "speed", "traits"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "speed": { "type": "integer", "minimum": 0 },
        "abilityBonuses": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ability" },
          "additionalProperties": { "type": "integer", "minimum": -5, "maximum": 5 }
        },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "class": {
      "type": "object",
      "required": ["id", "name", "hitDie", "primaryAbility", "levelFeatures"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "hitDie": { "enum": [4, 6, 8, 10, 12] },
        "primaryAbility": { "$ref": "#/$defs/ability" },
        "description": { "type": "string" },
        "savingThrowProficiencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/ability" },
          "uniqueItems": true
        },
        "levelFeatures": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:[1-9]|1[0-9]|20)$" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
        },
        "subclasses": { "type": "array", "items": { "$ref": "#/$defs/subclass" } }
      }
    },
    "subclass": {
      "type": "object",
      "required": ["id", "name", "levelFeatures"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "description": { "type": "string" },
        "levelFeatures": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:[1-9]|1[0-9]|20)$" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
        }
      }
    },
    "background": {
      "type": "object",
      "required": ["id", "name", "skills"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "feature": { "$ref": "#/$defs/feature" },
        "abilityOptions": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
        "featId": { "$ref": "#/$defs/id" },
        "toolProficiencies": { "type": "array", "items": { "type": "string" } },
        "equipment": { "type": "string" }
      }
    },
    "feat": {
      "type": "object",
      "required": ["id", "name", "category", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "category": { "type": "string", "minLength": 1 },
        "prerequisite": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "equipment": {
      "type": "object",
      "required": ["id", "name", "category"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "cost": { "type": "string" },
        "weight": { "type": "string" },
        "damage": { "type": "string" },
        "damageType": { "type": "string" },
        "properties": { "type": "array", "items": { "type": "string" } },
        "mastery": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "spell": {
      "type": "object",
      "required": ["id", "name", "level", "school", "classes", "castingTime", "range", "components", "duration", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "school": { "type": "string", "minLength": 1 },
        "classes": { "type": "array", "items": { "type": "string" } },
        "ritual": { "type": "boolean" },
        "castingTime": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "components": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "creature": {
      "type": "object",
      "required": ["id", "name", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "challengeRating": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "category", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    }
  }
}
