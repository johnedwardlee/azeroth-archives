{
  "name": "azeroth-archives-desktop",
  "version": "2.0.0-beta.7",
  "private": true,
  "description": "Offline Warcraft 5E character manager",
  "author": "Warcraft 5E Table",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:ui\" \"pnpm dev:desktop\"",
    "dev:ui": "vite",
    "dev:desktop": "cross-env AZEROTH_DEV_URL=http://localhost:5173 wait-on http://localhost:5173 && electron .",
    "build": "node scripts/generate-sync-config.cjs && tsc --noEmit && vite build",
    "dist": "pnpm run build && electron-builder --win nsis",
    "release:win": "pnpm run build && electron-builder --win nsis --publish never",
    "test": "vitest run && tsc --noEmit && vite build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.azerotharchives.charactermanager",
    "productName": "Azeroth Archives",
    "asar": true,
    "artifactName": "Azeroth-Archives-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "content-format/warcraft5e-content.schema.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Azeroth Archives"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "johnedwardlee",
        "repo": "azeroth-archives",
        "releaseType": "release"
      }
    ]
  }
}
